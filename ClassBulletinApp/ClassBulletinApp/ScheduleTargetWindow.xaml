<Window x:Class="ClassBulletinApp.ScheduleTargetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择悬浮课表显示的内容" Height="560" Width="470"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="选择悬浮课表要显示的内容" FontSize="18" FontWeight="Bold" Foreground="#1F2A37"/>
        <TextBlock Grid.Row="0" Text="双击列表项或点确定切换" FontSize="12" Foreground="#9CA3AF"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,10">
            <RadioButton x:Name="RbTeacher" Content="教师个人课表" GroupName="TargetKind" FontSize="15" Margin="0,0,22,0" Checked="Kind_Checked"/>
            <RadioButton x:Name="RbClass" Content="班级课表" GroupName="TargetKind" FontSize="15" Checked="Kind_Checked"/>
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="查询" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="TxtSearch" FontSize="14" Padding="8" Background="White" BorderBrush="#D1D5DB"
                     TextChanged="TxtSearch_TextChanged" KeyDown="TxtSearch_KeyDown"
                     ToolTip="输入姓名或班级关键字自动筛选"/>
        </DockPanel>

        <ListBox x:Name="ListTarget" Grid.Row="3" FontSize="15" MouseDoubleClick="ListTarget_MouseDoubleClick"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="取消" Padding="18,8" FontSize="14" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button Content="确定" Padding="18,8" FontSize="14" Background="{DynamicResource PrimaryBrush}" Foreground="White"
                    BorderBrush="{DynamicResource PrimaryBrush}" Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>
