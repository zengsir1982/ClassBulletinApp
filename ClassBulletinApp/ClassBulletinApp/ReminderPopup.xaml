<Window x:Class="ClassBulletinApp.ReminderPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="提醒" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" IsHitTestVisible="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Border x:Name="Card" Background="{DynamicResource PrimaryBrush}" CornerRadius="16" Padding="20,14" Margin="10"
                BorderBrush="#8FB4EE" BorderThickness="1" MouseLeftButtonDown="Card_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock x:Name="TxtTitle" FontSize="24" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtDetail" FontSize="15" Foreground="#DCE8FB" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- 仅「调整位置与大小」时出现：提示 + 保存 / 取消 -->
                <Border x:Name="EditBar" Grid.Row="1" Visibility="Collapsed" Margin="0,12,0,0"
                        Background="#22FFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="9" Padding="10,7">
                    <DockPanel LastChildFill="True">
                        <Button x:Name="BtnSaveLayout" DockPanel.Dock="Right" Content="✔ 保存" Click="BtnSaveLayout_Click"
                                Padding="12,4" FontSize="13" Background="White" BorderBrush="White" Foreground="#1F4C9C"
                                ToolTip="按当前位置与大小保存（回车也可以）"/>
                        <Button x:Name="BtnCancelLayout" DockPanel.Dock="Right" Content="取消" Click="BtnCancelLayout_Click"
                                Padding="12,4" FontSize="13" Margin="8,0,0,0"
                                Background="#33FFFFFF" BorderBrush="#66FFFFFF" Foreground="White"
                                ToolTip="不保存，保持原来的位置与大小（Esc 也可以）"/>
                        <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#F2F7FF"
                                   Text="拖动窗口移动 · 拖右边框改大小"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 右边缘抓手：只在调整模式下出现，鼠标显示左右箭头 -->
        <Border x:Name="GripRight" Width="12" HorizontalAlignment="Right" Background="Transparent"
                Cursor="SizeWE" Visibility="Collapsed"
                MouseLeftButtonDown="Grip_MouseLeftButtonDown"
                MouseMove="Grip_MouseMove"
                MouseLeftButtonUp="Grip_MouseLeftButtonUp"/>
    </Grid>
</Window>
