<Window x:Class="ClassBulletinApp.CustomNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义便签" WindowStyle="None" ResizeMode="CanResize"
        ShowInTaskbar="False" AllowsTransparency="True" Background="Transparent"
        Width="360" Height="420" MinWidth="220" MinHeight="180"
        Loaded="Window_Loaded" SourceInitialized="Window_SourceInitialized"
        LocationChanged="Window_LocationChanged" SizeChanged="Window_SizeChanged">
    <Border x:Name="NoteBorder" CornerRadius="12" BorderThickness="1"
            Background="#FFFFFF" BorderBrush="#D8DEE9">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" Opacity="0.35" ShadowDepth="4" Direction="300"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部条：标题 + 隐藏 -->
            <Border x:Name="Header" Grid.Row="0" CornerRadius="11,11,0,0" Padding="12,8" Background="#EAF1FD">
                <DockPanel LastChildFill="True">
                    <Button x:Name="BtnHide" DockPanel.Dock="Right" Content="✕" Click="BtnHide_Click"
                            Padding="6,2" FontSize="12" Margin="8,0,0,0"
                            Background="#33FFFFFF" Foreground="#1F2A37" BorderBrush="#55FFFFFF"
                            ToolTip="隐藏便签（可在控制面板或托盘重新打开）"/>
                    <TextBlock x:Name="TxtTitle" Text="自定义便签" FontSize="17" FontWeight="Bold"
                               Foreground="#1F2A37" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <!-- 内容：只读展示（双击任意处弹出编辑对话框） -->
            <ScrollViewer Grid.Row="1" Margin="12,10" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ContentPanel"/>
            </ScrollViewer>

            <!-- 底部：编辑 + 置顶 + 锁定 -->
            <Border Grid.Row="2" Padding="10,6" BorderThickness="0,1,0,0"
                    BorderBrush="#22000000" Background="#12000000">
                <DockPanel LastChildFill="True">
                    <Button x:Name="BtnEdit" DockPanel.Dock="Left" Content="编辑" Click="BtnEdit_Click"
                            Padding="8,3" FontSize="11"
                            ToolTip="编辑便签内容 / 主题"/>
                    <Button x:Name="BtnTop" DockPanel.Dock="Left" Content="置顶" Click="BtnTop_Click"
                            Padding="8,3" FontSize="11" Margin="6,0,0,0"
                            ToolTip="切换置顶显示（置于所有窗口之上 / 普通层级）"/>
                    <Button x:Name="BtnLock" DockPanel.Dock="Left" Content="🔓" Click="BtnLock_Click"
                            Padding="8,3" FontSize="11" Margin="6,0,0,0"
                            ToolTip="锁定后不能移动 / 缩放 / 编辑，防止误操作"/>
                    <TextBlock x:Name="TxtHint" Text="拖动摆放 · 拉边沿改大小 · 双击编辑" FontSize="11"
                               Foreground="#5B6472" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
