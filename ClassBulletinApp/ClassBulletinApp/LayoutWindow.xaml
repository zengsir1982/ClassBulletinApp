<Window x:Class="ClassBulletinApp.LayoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="布局与显示设置" Height="720" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <!-- 便签主题下拉项：色块 + 名称 -->
        <DataTemplate x:Key="ThemeItemTemplate">
            <StackPanel Orientation="Horizontal" Margin="2">
                <Rectangle Width="18" Height="18" RadiusX="4" RadiusY="4"
                           Fill="{Binding Background}" Stroke="#9AA3AF" StrokeThickness="1" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" x:Name="MainTabs">
            <!-- 课表悬浮窗 -->
            <TabItem Header="课表悬浮窗">
                <ScrollViewer Margin="10">
                    <StackPanel>
                        <Border Background="#EEF3FF" BorderBrush="#C9D6EC" BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="位置 / 大小：直接在屏幕上拖" FontSize="15" FontWeight="Bold" Foreground="#1F2A37"/>
                                <TextBlock Text="按住悬浮课表的标题区（班级 / 日期那一块）拖动即可移动位置；把鼠标移到窗口边沿或四角，出现双向箭头时拖动即可改变大小。松手即自动记住，下次启动保持原位。把窗口拖到屏幕边沿会自动开启「自动靠边隐藏」，拖离屏幕边沿则自动关闭。"
                                           FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,4,0,10"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="透明度（自动隐藏 / 普通置顶）" FontSize="14" FontWeight="Bold" Foreground="#1F2A37" Margin="0,16,0,4"/>
                        <Slider x:Name="SlSchOpacity" Minimum="0.2" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtSchOpacity" FontSize="12" Foreground="#6B7280"/>

                        <TextBlock Text="置顶显示时的透明度（半透明常驻，不影响看底层内容）" FontSize="14" FontWeight="Bold" Foreground="#1F2A37" Margin="0,16,0,4"/>
                        <Slider x:Name="SlSchOverlay" Minimum="0.2" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtSchOverlay" FontSize="12" Foreground="#6B7280"/>

                        <CheckBox x:Name="ChkSchTop" Content="置顶显示（始终在最前）" FontSize="14" Margin="0,16,0,8"/>
                        <CheckBox x:Name="ChkSchClick" Content="鼠标穿透（教室纯展示：仅隐藏按钮/标题/课卡仍可点，其余区域的点击落到底层窗口）" FontSize="14" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkSchHide" Content="自动靠边隐藏（移到屏幕边沿才滑出）" FontSize="14" Margin="0,0,0,4"/>
                        <CheckBox x:Name="ChkSchClassHide" Content="上课时间自动隐藏（上课期间缩到边沿，移到屏幕边沿才滑出，不影响上课用屏）" FontSize="14" Margin="0,4,0,4"/>

                        <TextBlock Text="自动隐藏后露出屏幕边沿的像素（0 = 完全移出屏幕，最干净）" FontSize="14" FontWeight="Bold" Foreground="#1F2A37" Margin="0,14,0,4"/>
                        <Slider x:Name="SlSchPeek" Minimum="0" Maximum="48" TickFrequency="2" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtSchPeek" FontSize="12" Foreground="#6B7280"/>
                        <TextBlock Text="屏幕边沿感应宽度（像素）：鼠标 / 触摸进入屏幕这一边缘范围就滑出" FontSize="14" FontWeight="Bold" Foreground="#1F2A37" Margin="0,12,0,4"/>
                        <Slider x:Name="SlSchEdge" Minimum="2" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtSchEdge" FontSize="12" Foreground="#6B7280"/>
                        <TextBlock Text="提示：默认不勾选「鼠标穿透」——此时隐藏按钮可单击、标题可双击换班/换日、课卡可拖动调课。「自动隐藏」模式下窗口本身也是可交互的；只有勾选「鼠标穿透」后，非交互区域的鼠标操作才会落到底层窗口。" FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 通知悬浮窗 -->
            <TabItem Header="通知悬浮窗（顶部字幕）">
                <ScrollViewer Margin="10">
                    <StackPanel>
                        <Border Background="#EEF3FF" BorderBrush="#C9D6EC" BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="位置 / 大小：直接在屏幕上拖" FontSize="15" FontWeight="Bold" Foreground="#1F2A37"/>
                                <TextBlock Text="按住通知条拖动即可移动位置（双击仍是编辑通知）；把鼠标移到条子边沿，出现双向箭头时拖动即可改变大小与条高。松手即自动记住。把通知条拖到屏幕边沿会自动开启「自动靠边隐藏」，拖离屏幕边沿则自动关闭。"
                                           FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,4,0,10"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="字幕字号" FontSize="14" FontWeight="Bold" Foreground="#1F2A37" Margin="0,16,0,4"/>
                        <Slider x:Name="SlNotFont" Minimum="14" Maximum="64" TickFrequency="2" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtNotFont" FontSize="12" Foreground="#6B7280"/>

                        <TextBlock Text="滚动速度（像素/秒）" FontSize="14" FontWeight="Bold" Foreground="#1F2A37" Margin="0,16,0,4"/>
                        <Slider x:Name="SlNotSpeed" Minimum="40" Maximum="400" TickFrequency="10" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtNotSpeed" FontSize="12" Foreground="#6B7280"/>

                        <TextBlock Text="透明度（自动隐藏 / 普通置顶）" FontSize="14" FontWeight="Bold" Foreground="#1F2A37" Margin="0,16,0,4"/>
                        <Slider x:Name="SlNotOpacity" Minimum="0.2" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtNotOpacity" FontSize="12" Foreground="#6B7280"/>

                        <TextBlock Text="置顶显示时的透明度（半透明常驻，不影响看底层内容）" FontSize="14" FontWeight="Bold" Foreground="#1F2A37" Margin="0,16,0,4"/>
                        <Slider x:Name="SlNotOverlay" Minimum="0.2" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtNotOverlay" FontSize="12" Foreground="#6B7280"/>

                        <CheckBox x:Name="ChkNotTop" Content="置顶显示（始终在最前）" FontSize="14" Margin="0,16,0,8"/>
                        <CheckBox x:Name="ChkNotClick" Content="鼠标穿透（教室纯展示：仅隐藏按钮与通知条仍可点，其余区域点击落到底层窗口）" FontSize="14" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkNotHide" Content="自动靠边隐藏（移到屏幕边沿才滑出）" FontSize="14" Margin="0,0,0,4"/>
                        <CheckBox x:Name="ChkNotClassHide" Content="上课时间自动隐藏（上课期间缩到边沿，移到屏幕边沿才滑出，不影响上课用屏）" FontSize="14" Margin="0,4,0,4"/>

                        <TextBlock Text="自动隐藏后露出屏幕边沿的像素（0 = 完全移出屏幕，最干净）" FontSize="14" FontWeight="Bold" Foreground="#1F2A37" Margin="0,14,0,4"/>
                        <Slider x:Name="SlNotPeek" Minimum="0" Maximum="48" TickFrequency="2" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtNotPeek" FontSize="12" Foreground="#6B7280"/>
                        <TextBlock Text="屏幕边沿感应宽度（像素）：鼠标 / 触摸进入屏幕这一边缘范围就滑出" FontSize="14" FontWeight="Bold" Foreground="#1F2A37" Margin="0,12,0,4"/>
                        <Slider x:Name="SlNotEdge" Minimum="2" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtNotEdge" FontSize="12" Foreground="#6B7280"/>
                        <TextBlock Text="提示：默认不勾选「鼠标穿透」——此时通知条可双击编辑、隐藏按钮可单击。勾选后非交互区域的鼠标操作才会落到底层窗口。" FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 桌面背景（当天课表 + 作业公示 + 缺交名单 合成壁纸） -->
            <TabItem Header="桌面背景">
                <ScrollViewer Margin="10">
                    <StackPanel>
                        <TextBlock Text="🖥 桌面背景（当天课表 + 作业公示 + 缺交名单）" FontSize="18" FontWeight="Bold" Foreground="#1F2A37" Margin="0,0,0,4"/>
                        <TextBlock Text="把「当天课表」「作业公示」「缺交作业名单」画成三张便签到桌面壁纸上：位于所有窗口之下，不遮挡、不影响电脑操作，也不会被误触。三张便签可同时显示，主题风格、位置与大小各自独立调整。"
                                   FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <TextBlock Text="显示内容" FontSize="16" FontWeight="Bold" Foreground="#1F2A37" Margin="0,0,0,8"/>
                        <WrapPanel Margin="12,0,0,6">
                            <CheckBox x:Name="ChkWpSchedule" Content="当天课表" FontSize="14" Margin="0,0,22,0" Click="WpSetting_Changed"/>
                            <CheckBox x:Name="ChkWpHomework" Content="作业公示" FontSize="14" Margin="0,0,22,0" Click="WpSetting_Changed"/>
                            <CheckBox x:Name="ChkWpMissing" Content="缺交作业名单" FontSize="14" Click="WpSetting_Changed"/>
                        </WrapPanel>
                        <CheckBox x:Name="ChkWpOrigin" Content="使用系统原壁纸作为底图（取消则用浅色渐变底）" FontSize="14" Margin="12,6,0,0" Click="WpSetting_Changed"/>

                        <!-- 所见即所得排版入口：替代原先的滑块调位置 / 大小 -->
                        <Border Background="#EEF3FF" BorderBrush="#C9D6EC" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,14,0,4">
                            <StackPanel>
                                <TextBlock Text="便签位置 / 大小：所见即所得调整" FontSize="15" FontWeight="Bold" Foreground="#1F2A37"/>
                                <TextBlock Text="点击下方按钮，可在模拟屏幕上直接拖动便签调整位置、拖动四角 / 四边改变大小，比滑块更直观便捷。"
                                           FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                <Button x:Name="BtnWpEdit" Content="🖱 打开所见即所得排版（拖动便签 / 拉边框改大小）"
                                        Padding="14,9" FontSize="14" HorizontalAlignment="Left"
                                        Background="#2D6CDF" Foreground="White" BorderBrush="#2D6CDF" Click="BtnWpEdit_Click"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="当天课表便签" FontSize="16" FontWeight="Bold" Foreground="#1F2A37" Margin="0,18,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,8">
                            <TextBlock Text="主题风格" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CbWpSchTheme" Width="190" FontSize="14" ItemTemplate="{StaticResource ThemeItemTemplate}" SelectionChanged="WpSetting_Changed"/>
                            <TextBlock Text="（课表便签底色 / 文字 / 强调色，与悬浮窗风格统一）" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="作业公示便签" FontSize="16" FontWeight="Bold" Foreground="#1F2A37" Margin="0,20,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,8">
                            <TextBlock Text="主题风格" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CbWpHwTheme" Width="190" FontSize="14" ItemTemplate="{StaticResource ThemeItemTemplate}" SelectionChanged="WpHwTheme_Changed"/>
                            <TextBlock Text="（与作业便签 / 控制面板共用同一主题）" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="缺交作业名单便签（独立）" FontSize="16" FontWeight="Bold" Foreground="#1F2A37" Margin="0,20,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,8">
                            <TextBlock Text="主题风格" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CbWpMsTheme" Width="190" FontSize="14" ItemTemplate="{StaticResource ThemeItemTemplate}" SelectionChanged="WpHwTheme_Changed"/>
                            <TextBlock Text="（与缺交便签共用同一主题）" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button x:Name="BtnApplyWp" Content="应用到桌面背景" Padding="18,9" FontSize="15" Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderBrush="{DynamicResource PrimaryBrush}" Click="BtnApplyWp_Click"/>
                            <Button x:Name="BtnClearWp" Content="清除（恢复原壁纸）" Padding="16,9" FontSize="15" Margin="12,0,0,0" Background="#FDE8E8" BorderBrush="#E0A0A0" Click="BtnClearWp_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtWpStatus" FontSize="12" Foreground="#6B7280" Margin="10,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="提示：应用后课表内容变化、跨天会自动更新；悬浮课表 / 作业便签 / 缺交便签底部与任务栏图标右键菜单都能一键开关各自在桌面背景上的显示。便签的位置与大小请在上方「所见即所得排版」里拖动调整。"
                                   FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnCancel" Content="取消" Padding="18,8" FontSize="14" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave" Content="保存并应用" Padding="18,8" FontSize="14" Click="BtnSave_Click" Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderBrush="{DynamicResource PrimaryBrush}"/>
        </StackPanel>
    </Grid>
</Window>
