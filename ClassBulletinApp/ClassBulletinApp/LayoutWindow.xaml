<Window x:Class="ClassBulletinApp.LayoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:ClassBulletinApp.Controls"
        Title="布局与显示设置" Height="720" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <!-- 便签主题下拉项：色块 + 名称 -->
        <DataTemplate x:Key="ThemeItemTemplate">
            <StackPanel Orientation="Horizontal" Margin="2">
                <Rectangle Width="18" Height="18" RadiusX="4" RadiusY="4"
                           Fill="{Binding Background}" Stroke="{DynamicResource HintBrush}" StrokeThickness="1" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" x:Name="MainTabs">
            <!-- 课表悬浮窗 -->
            <TabItem Header="课表悬浮窗">
                <ScrollViewer Margin="10">
                    <StackPanel>
                        <Border Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource PrimarySoftBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="位置 / 大小：直接在屏幕上拖" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="透明度（自动隐藏 / 普通置顶）" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,16,0,4"/>
                        <Slider x:Name="SlSchOpacity" Minimum="0.2" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtSchOpacity" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>

                        <TextBlock Text="置顶显示时的透明度（默认不透明；需要看底层内容时可调低）" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,16,0,4"/>
                        <Slider x:Name="SlSchOverlay" Minimum="0.2" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtSchOverlay" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>

                        <CheckBox x:Name="ChkSchTop" Content="置顶显示（始终在最前）" FontSize="14" Margin="0,16,0,8"/>
                        <CheckBox x:Name="ChkSchClick" Content="鼠标穿透（教室纯展示：仅隐藏按钮/标题/课卡仍可点，其余区域的点击落到底层窗口）" FontSize="14" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkSchHide" Content="自动靠边隐藏（移到屏幕边沿才滑出）" FontSize="14" Margin="0,0,0,4"/>
                        <CheckBox x:Name="ChkSchClassHide" Content="上课时间自动隐藏（上课期间缩到边沿，移到屏幕边沿才滑出，不影响上课用屏）" FontSize="14" Margin="0,4,0,4"/>

                        <TextBlock Text="自动隐藏后露出屏幕边沿的像素（0 = 完全移出屏幕，最干净）" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,14,0,4"/>
                        <Slider x:Name="SlSchPeek" Minimum="0" Maximum="48" TickFrequency="2" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtSchPeek" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Text="屏幕边沿感应宽度（像素）：鼠标 / 触摸进入屏幕这一边缘范围就滑出" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,12,0,4"/>
                        <Slider x:Name="SlSchEdge" Minimum="2" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtSchEdge" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 通知悬浮窗 -->
            <TabItem Header="通知悬浮窗（顶部字幕）">
                <ScrollViewer Margin="10">
                    <StackPanel>
                        <Border Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource PrimarySoftBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="位置 / 大小：直接在屏幕上拖" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- P2：字幕字号统一到「内容 → 通知公告 → 通知条样式」的下拉（12～96 共 22 档）。
                             旧滑块与数值标签保留为隐藏回退：控件、事件、读写都还在，把下面两行 Visibility 改回 Visible 即可恢复。 -->
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,16,0,4">
                            <StackPanel>
                                <TextBlock Text="字幕字号" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                            </StackPanel>
                        </Border>
                        <Slider x:Name="SlNotFont" Minimum="14" Maximum="64" TickFrequency="2" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left" Visibility="Collapsed"/>
                        <TextBlock x:Name="TxtNotFont" FontSize="12" Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed"/>

                        <TextBlock Text="滚动速度（像素/秒）" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,16,0,4"/>
                        <Slider x:Name="SlNotSpeed" Minimum="40" Maximum="400" TickFrequency="10" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtNotSpeed" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>

                        <TextBlock Text="透明度（自动隐藏 / 普通置顶）" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,16,0,4"/>
                        <Slider x:Name="SlNotOpacity" Minimum="0.2" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtNotOpacity" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>

                        <TextBlock Text="置顶显示时的透明度（默认不透明；需要看底层内容时可调低）" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,16,0,4"/>
                        <Slider x:Name="SlNotOverlay" Minimum="0.2" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtNotOverlay" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>

                        <CheckBox x:Name="ChkNotTop" Content="置顶显示（始终在最前）" FontSize="14" Margin="0,16,0,8"/>
                        <CheckBox x:Name="ChkNotClick" Content="鼠标穿透（纯展示：点击落到底层窗口，不挡课件操作）" FontSize="14" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkNotHoverFade" Content="鼠标移到通知条上时自动变透明（离开恢复，不挡视线）" FontSize="14" Margin="0,0,0,8"
                                  ToolTip="常驻显示时通知条始终压在屏幕最上层：把鼠标移过去它就让开（透明度降到 0），移开立刻回来。只在勾了「鼠标穿透」时生效 —— 没穿透时把条子淡到看不见等于对着空气点。"/>
                        <CheckBox x:Name="ChkNotHide" Content="自动靠边隐藏（移到屏幕边沿才滑出）" FontSize="14" Margin="0,0,0,4"/>
                        <CheckBox x:Name="ChkNotClassHide" Content="上课时间自动隐藏（上课期间缩到边沿，移到屏幕边沿才滑出，不影响上课用屏）" FontSize="14" Margin="0,4,0,4"/>

                        <TextBlock Text="自动隐藏后露出屏幕边沿的像素（0 = 完全移出屏幕，最干净）" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,14,0,4"/>
                        <Slider x:Name="SlNotPeek" Minimum="0" Maximum="48" TickFrequency="2" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtNotPeek" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Text="屏幕边沿感应宽度（像素）：鼠标 / 触摸进入屏幕这一边缘范围就滑出" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,12,0,4"/>
                        <Slider x:Name="SlNotEdge" Minimum="2" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtNotEdge" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 桌面背景（当天课表 + 作业公示 + 缺交名单 + 自定义便签 合成壁纸） -->
            <TabItem Header="桌面背景">
                <ScrollViewer Margin="10">
                    <StackPanel>
                        <TextBlock Text="🖥 桌面背景（可同时显示多张便签）" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,4"/>

                        <TextBlock Text="显示内容" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,8"/>
                        <WrapPanel Margin="12,0,0,6">
                            <CheckBox x:Name="ChkWpSchedule" Content="当天课表" FontSize="14" Margin="0,0,22,0" Click="WpSetting_Changed"/>
                            <CheckBox x:Name="ChkWpHomework" Content="作业公示" FontSize="14" Margin="0,0,22,0" Click="WpSetting_Changed"/>
                            <CheckBox x:Name="ChkWpMissing" Content="缺交作业名单" FontSize="14" Margin="0,0,22,0" Click="WpSetting_Changed"/>
                            <CheckBox x:Name="ChkWpCountdown" Content="倒计时" FontSize="14" Margin="0,0,22,0" Click="WpSetting_Changed"/>
                            <CheckBox x:Name="ChkWpDuty" Content="值日生名单" FontSize="14" Margin="0,0,22,0" Click="WpSetting_Changed"/>
                            <CheckBox x:Name="ChkWpNotice" Content="通知公告" FontSize="14" Click="WpSetting_Changed"/>
                        </WrapPanel>
                        <CheckBox x:Name="ChkWpOrigin" Content="使用系统原壁纸作为底图（取消则用浅色渐变底）" FontSize="14" Margin="12,6,0,0" Click="WpSetting_Changed"/>

                        <!-- 自定义便签：一张一行（没有自定义便签时整块隐藏） -->
                        <StackPanel x:Name="WpNotePanel" Margin="12,10,0,0"/>

                        <!-- 所见即所得排版入口：替代原先的滑块调位置 / 大小 -->
                        <Border Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource PrimarySoftBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,14,0,4">
                            <StackPanel>
                                <TextBlock Text="便签位置 / 大小：所见即所得调整" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                                <Button x:Name="BtnWpEdit" Content="🖱 打开所见即所得排版（拖动便签 / 拉边框改大小）"
                                        Padding="14,9" FontSize="14" HorizontalAlignment="Left"
                                        Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderBrush="{DynamicResource PrimaryBrush}" Click="BtnWpEdit_Click"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="当天课表便签" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,18,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,8">
                            <TextBlock Text="主题风格" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CbWpSchTheme" Width="190" FontSize="14" ItemTemplate="{StaticResource ThemeItemTemplate}" SelectionChanged="WpSetting_Changed"/>
                            <TextBlock Text="（课表便签底色 / 文字 / 强调色，与悬浮窗风格统一）" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="作业公示便签" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,20,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,8">
                            <TextBlock Text="主题风格" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CbWpHwTheme" Width="190" FontSize="14" ItemTemplate="{StaticResource ThemeItemTemplate}" SelectionChanged="WpHwTheme_Changed"/>
                            <TextBlock Text="（与作业便签 / 控制面板共用同一主题）" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="缺交作业名单便签（独立）" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,20,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,8">
                            <TextBlock Text="主题风格" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CbWpMsTheme" Width="190" FontSize="14" ItemTemplate="{StaticResource ThemeItemTemplate}" SelectionChanged="WpHwTheme_Changed"/>
                            <TextBlock Text="（与缺交便签共用同一主题）" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button x:Name="BtnApplyWp" Content="应用到桌面背景" Padding="18,9" FontSize="15" Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderBrush="{DynamicResource PrimaryBrush}" Click="BtnApplyWp_Click"/>
                            <Button x:Name="BtnClearWp" Content="取消背景（恢复悬浮窗）" Padding="16,9" FontSize="15" Margin="12,0,0,0" Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}"
                                    ToolTip="撤掉画在壁纸上的课表 / 便签，恢复系统原壁纸，并把当初隐藏的课表 / 便签放回悬浮窗"
                                    Click="BtnClearWp_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtWpStatus" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="10,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 全局玻璃底色已迁到「显示设置 → 界面主题」（r77）。此处不再提供玻璃设置。 -->

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnCancel" Content="取消" Padding="18,8" FontSize="14" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave" Content="保存并应用" Padding="18,8" FontSize="14" Click="BtnSave_Click" Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderBrush="{DynamicResource PrimaryBrush}"/>
        </StackPanel>
    </Grid>
</Window>
