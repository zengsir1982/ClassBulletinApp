<Window x:Class="ClassBulletinApp.LayoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="布局与显示设置" Height="720" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <!-- 便签主题下拉项：色块 + 名称 -->
        <DataTemplate x:Key="ThemeItemTemplate">
            <StackPanel Orientation="Horizontal" Margin="2">
                <Rectangle Width="18" Height="18" RadiusX="4" RadiusY="4"
                           Fill="{Binding Background}" Stroke="#9AA3AF" StrokeThickness="1" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" x:Name="MainTabs">
            <!-- 课表悬浮窗 -->
            <TabItem Header="课表悬浮窗">
                <ScrollViewer Margin="10">
                    <StackPanel>
                        <TextBlock Text="位置（贴边 / 居中）" FontSize="14" FontWeight="Bold" Foreground="#1F2A37" Margin="0,4,0,6"/>
                        <ComboBox x:Name="CbSchAnchor" Width="160" HorizontalAlignment="Left" FontSize="14" SelectedIndex="1">
                            <ComboBoxItem Content="左侧"/>
                            <ComboBoxItem Content="右侧"/>
                            <ComboBoxItem Content="顶部"/>
                            <ComboBoxItem Content="底部"/>
                            <ComboBoxItem Content="居中"/>
                        </ComboBox>

                        <TextBlock Text="宽度" FontSize="14" FontWeight="Bold" Foreground="#1F2A37" Margin="0,16,0,4"/>
                        <Slider x:Name="SlSchWidth" Minimum="240" Maximum="1200" TickFrequency="20" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtSchWidth" FontSize="12" Foreground="#6B7280"/>

                        <TextBlock Text="高度" FontSize="14" FontWeight="Bold" Foreground="#1F2A37" Margin="0,16,0,4"/>
                        <Slider x:Name="SlSchHeight" Minimum="200" Maximum="1080" TickFrequency="20" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtSchHeight" FontSize="12" Foreground="#6B7280"/>

                        <TextBlock Text="透明度（自动隐藏 / 普通置顶）" FontSize="14" FontWeight="Bold" Foreground="#1F2A37" Margin="0,16,0,4"/>
                        <Slider x:Name="SlSchOpacity" Minimum="0.2" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtSchOpacity" FontSize="12" Foreground="#6B7280"/>

                        <TextBlock Text="置顶显示时的透明度（半透明常驻，不影响看底层内容）" FontSize="14" FontWeight="Bold" Foreground="#1F2A37" Margin="0,16,0,4"/>
                        <Slider x:Name="SlSchOverlay" Minimum="0.2" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtSchOverlay" FontSize="12" Foreground="#6B7280"/>

                        <CheckBox x:Name="ChkSchTop" Content="置顶显示（始终在最前）" FontSize="14" Margin="0,16,0,8"/>
                        <CheckBox x:Name="ChkSchClick" Content="鼠标穿透（教室纯展示：仅隐藏按钮/标题/课卡仍可点，其余区域的点击落到底层窗口）" FontSize="14" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkSchHide" Content="自动靠边隐藏（移到屏幕边沿才滑出）" FontSize="14" Margin="0,0,0,4"/>
                        <CheckBox x:Name="ChkSchClassHide" Content="上课时间自动隐藏（上课期间缩到边沿，移到屏幕边沿才滑出，不影响上课用屏）" FontSize="14" Margin="0,4,0,4"/>

                        <TextBlock Text="自动隐藏后露出屏幕边沿的像素（0 = 完全移出屏幕，最干净）" FontSize="14" FontWeight="Bold" Foreground="#1F2A37" Margin="0,14,0,4"/>
                        <Slider x:Name="SlSchPeek" Minimum="0" Maximum="48" TickFrequency="2" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtSchPeek" FontSize="12" Foreground="#6B7280"/>
                        <TextBlock Text="屏幕边沿感应宽度（像素）：鼠标 / 触摸进入屏幕这一边缘范围就滑出" FontSize="14" FontWeight="Bold" Foreground="#1F2A37" Margin="0,12,0,4"/>
                        <Slider x:Name="SlSchEdge" Minimum="2" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtSchEdge" FontSize="12" Foreground="#6B7280"/>
                        <TextBlock Text="提示：默认不勾选「鼠标穿透」——此时隐藏按钮可单击、标题可双击换班/换日、课卡可拖动调课。「自动隐藏」模式下窗口本身也是可交互的；只有勾选「鼠标穿透」后，非交互区域的鼠标操作才会落到底层窗口。" FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 通知悬浮窗 -->
            <TabItem Header="通知悬浮窗（顶部字幕）">
                <ScrollViewer Margin="10">
                    <StackPanel>
                        <TextBlock Text="位置（贴边）" FontSize="14" FontWeight="Bold" Foreground="#1F2A37" Margin="0,4,0,6"/>
                        <ComboBox x:Name="CbNotAnchor" Width="160" HorizontalAlignment="Left" FontSize="14" SelectedIndex="0">
                            <ComboBoxItem Content="顶部"/>
                            <ComboBoxItem Content="底部"/>
                        </ComboBox>

                        <TextBlock Text="条高（像素）" FontSize="14" FontWeight="Bold" Foreground="#1F2A37" Margin="0,16,0,4"/>
                        <Slider x:Name="SlNotHeight" Minimum="30" Maximum="140" TickFrequency="2" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtNotHeight" FontSize="12" Foreground="#6B7280"/>

                        <TextBlock Text="宽度（像素，0 = 整屏宽）" FontSize="14" FontWeight="Bold" Foreground="#1F2A37" Margin="0,16,0,4"/>
                        <Slider x:Name="SlNotWidth" Minimum="0" Maximum="2560" TickFrequency="20" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtNotWidth" FontSize="12" Foreground="#6B7280"/>

                        <TextBlock Text="水平位置（顶部 / 底部条：居左 / 居中 / 居右）" FontSize="14" FontWeight="Bold" Foreground="#1F2A37" Margin="0,16,0,4"/>
                        <ComboBox x:Name="CbNotHAnchor" Width="160" HorizontalAlignment="Left" FontSize="14" SelectedIndex="1">
                            <ComboBoxItem Content="居左"/>
                            <ComboBoxItem Content="居中"/>
                            <ComboBoxItem Content="居右"/>
                        </ComboBox>

                        <TextBlock Text="字幕字号" FontSize="14" FontWeight="Bold" Foreground="#1F2A37" Margin="0,16,0,4"/>
                        <Slider x:Name="SlNotFont" Minimum="14" Maximum="64" TickFrequency="2" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtNotFont" FontSize="12" Foreground="#6B7280"/>

                        <TextBlock Text="滚动速度（像素/秒）" FontSize="14" FontWeight="Bold" Foreground="#1F2A37" Margin="0,16,0,4"/>
                        <Slider x:Name="SlNotSpeed" Minimum="40" Maximum="400" TickFrequency="10" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtNotSpeed" FontSize="12" Foreground="#6B7280"/>

                        <TextBlock Text="透明度（自动隐藏 / 普通置顶）" FontSize="14" FontWeight="Bold" Foreground="#1F2A37" Margin="0,16,0,4"/>
                        <Slider x:Name="SlNotOpacity" Minimum="0.2" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtNotOpacity" FontSize="12" Foreground="#6B7280"/>

                        <TextBlock Text="置顶显示时的透明度（半透明常驻，不影响看底层内容）" FontSize="14" FontWeight="Bold" Foreground="#1F2A37" Margin="0,16,0,4"/>
                        <Slider x:Name="SlNotOverlay" Minimum="0.2" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtNotOverlay" FontSize="12" Foreground="#6B7280"/>

                        <CheckBox x:Name="ChkNotTop" Content="置顶显示（始终在最前）" FontSize="14" Margin="0,16,0,8"/>
                        <CheckBox x:Name="ChkNotClick" Content="鼠标穿透（教室纯展示：仅隐藏按钮与通知条仍可点，其余区域点击落到底层窗口）" FontSize="14" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkNotHide" Content="自动靠边隐藏（移到屏幕边沿才滑出）" FontSize="14" Margin="0,0,0,4"/>
                        <CheckBox x:Name="ChkNotClassHide" Content="上课时间自动隐藏（上课期间缩到边沿，移到屏幕边沿才滑出，不影响上课用屏）" FontSize="14" Margin="0,4,0,4"/>

                        <TextBlock Text="自动隐藏后露出屏幕边沿的像素（0 = 完全移出屏幕，最干净）" FontSize="14" FontWeight="Bold" Foreground="#1F2A37" Margin="0,14,0,4"/>
                        <Slider x:Name="SlNotPeek" Minimum="0" Maximum="48" TickFrequency="2" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtNotPeek" FontSize="12" Foreground="#6B7280"/>
                        <TextBlock Text="屏幕边沿感应宽度（像素）：鼠标 / 触摸进入屏幕这一边缘范围就滑出" FontSize="14" FontWeight="Bold" Foreground="#1F2A37" Margin="0,12,0,4"/>
                        <Slider x:Name="SlNotEdge" Minimum="2" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" Width="420" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TxtNotEdge" FontSize="12" Foreground="#6B7280"/>
                        <TextBlock Text="提示：默认不勾选「鼠标穿透」——此时通知条可双击编辑、隐藏按钮可单击。勾选后非交互区域的鼠标操作才会落到底层窗口。" FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 桌面背景（当天课表 + 作业公示 合成壁纸） -->
            <TabItem Header="桌面背景">
                <ScrollViewer Margin="10">
                    <StackPanel>
                        <TextBlock Text="🖥 桌面背景（当天课表 + 作业公示 + 缺交名单）" FontSize="18" FontWeight="Bold" Foreground="#1F2A37" Margin="0,0,0,4"/>
                        <TextBlock Text="把「当天课表」「作业公示」「缺交作业名单」画成三张便签到桌面壁纸上：位于所有窗口之下，不遮挡、不影响电脑操作，也不会被误触。三张便签可同时显示，主题风格、位置与大小各自独立调整。"
                                   FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <TextBlock Text="显示内容" FontSize="16" FontWeight="Bold" Foreground="#1F2A37" Margin="0,0,0,8"/>
                        <WrapPanel Margin="12,0,0,6">
                            <CheckBox x:Name="ChkWpSchedule" Content="当天课表" FontSize="14" Margin="0,0,22,0" Click="WpSetting_Changed"/>
                            <CheckBox x:Name="ChkWpHomework" Content="作业公示" FontSize="14" Margin="0,0,22,0" Click="WpSetting_Changed"/>
                            <CheckBox x:Name="ChkWpMissing" Content="缺交作业名单" FontSize="14" Click="WpSetting_Changed"/>
                        </WrapPanel>
                        <CheckBox x:Name="ChkWpOrigin" Content="使用系统原壁纸作为底图（取消则用浅色渐变底）" FontSize="14" Margin="12,6,0,0" Click="WpSetting_Changed"/>

                        <TextBlock Text="当天课表便签" FontSize="16" FontWeight="Bold" Foreground="#1F2A37" Margin="0,20,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,8">
                            <TextBlock Text="主题风格" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CbWpSchTheme" Width="190" FontSize="14" ItemTemplate="{StaticResource ThemeItemTemplate}" SelectionChanged="WpSetting_Changed"/>
                            <TextBlock Text="（课表便签底色 / 文字 / 强调色，与悬浮窗风格统一）" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,10">
                            <TextBlock Text="位置" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CbWpSchAnchor" Width="120" FontSize="14" SelectedIndex="3" SelectionChanged="WpLayout_Changed">
                                <ComboBoxItem Content="左上"/>
                                <ComboBoxItem Content="中上"/>
                                <ComboBoxItem Content="右上"/>
                                <ComboBoxItem Content="左中"/>
                                <ComboBoxItem Content="居中"/>
                                <ComboBoxItem Content="右中"/>
                                <ComboBoxItem Content="左下"/>
                                <ComboBoxItem Content="中下"/>
                                <ComboBoxItem Content="右下"/>
                            </ComboBox>
                            <TextBlock Text="宽度（占屏宽）" FontSize="14" VerticalAlignment="Center" Margin="22,0,10,0"/>
                            <Slider x:Name="SlWpSchWidth" Minimum="0.18" Maximum="0.9" TickFrequency="0.02" IsSnapToTickEnabled="True" Width="170" ValueChanged="WpLayout_Changed"/>
                            <TextBlock x:Name="TxtWpSchWidth" FontSize="13" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="水平偏移（像素，向右为正）" FontSize="13" FontWeight="Bold" Foreground="#1F2A37" Margin="12,0,0,2"/>
                        <Slider x:Name="SlWpSchX" Minimum="-900" Maximum="900" TickFrequency="10" IsSnapToTickEnabled="True" Width="520" HorizontalAlignment="Left" Margin="12,0,0,0" ValueChanged="WpLayout_Changed"/>
                        <TextBlock x:Name="TxtWpSchX" FontSize="12" Foreground="#6B7280" Margin="12,0,0,0"/>
                        <TextBlock Text="垂直偏移（像素，向下为正）" FontSize="13" FontWeight="Bold" Foreground="#1F2A37" Margin="12,14,0,2"/>
                        <Slider x:Name="SlWpSchY" Minimum="-700" Maximum="700" TickFrequency="10" IsSnapToTickEnabled="True" Width="520" HorizontalAlignment="Left" Margin="12,0,0,0" ValueChanged="WpLayout_Changed"/>
                        <TextBlock x:Name="TxtWpSchY" FontSize="12" Foreground="#6B7280" Margin="12,0,0,0"/>

                        <!-- 固定大小的课表便签：位置不随当天节次多少而漂移 -->
                        <CheckBox x:Name="ChkSchFixed" Content="使用固定大小的课表便签（推荐：位置稳定，不随当天课程多少漂移）"
                                  FontSize="14" Margin="12,10,0,2" Click="WpLayout_Changed"/>
                        <StackPanel Orientation="Horizontal" Margin="12,6,0,2">
                            <TextBlock Text="固定宽度" FontSize="13" FontWeight="Bold" Foreground="#1F2A37" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Slider x:Name="SlWpSchFixedW" Minimum="220" Maximum="1200" TickFrequency="10" IsSnapToTickEnabled="True" Width="300" HorizontalAlignment="Left" ValueChanged="WpLayout_Changed"/>
                            <TextBlock x:Name="TxtWpSchFixedW" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="12,6,0,2">
                            <TextBlock Text="固定高度" FontSize="13" FontWeight="Bold" Foreground="#1F2A37" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Slider x:Name="SlWpSchFixedH" Minimum="0" Maximum="1000" TickFrequency="10" IsSnapToTickEnabled="True" Width="300" HorizontalAlignment="Left" ValueChanged="WpLayout_Changed"/>
                            <TextBlock x:Name="TxtWpSchFixedH" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                        <TextBlock Text="作业公示便签" FontSize="16" FontWeight="Bold" Foreground="#1F2A37" Margin="0,20,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,8">
                            <TextBlock Text="主题风格" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CbWpHwTheme" Width="190" FontSize="14" ItemTemplate="{StaticResource ThemeItemTemplate}" SelectionChanged="WpHwTheme_Changed"/>
                            <TextBlock Text="（与作业便签 / 控制面板共用同一主题）" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,10">
                            <TextBlock Text="位置" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CbHwAnchor" Width="120" FontSize="14" SelectedIndex="5" SelectionChanged="HwLayout_Changed">
                                <ComboBoxItem Content="左上"/>
                                <ComboBoxItem Content="中上"/>
                                <ComboBoxItem Content="右上"/>
                                <ComboBoxItem Content="左中"/>
                                <ComboBoxItem Content="居中"/>
                                <ComboBoxItem Content="右中"/>
                                <ComboBoxItem Content="左下"/>
                                <ComboBoxItem Content="中下"/>
                                <ComboBoxItem Content="右下"/>
                            </ComboBox>
                            <TextBlock Text="宽度（占屏宽）" FontSize="14" VerticalAlignment="Center" Margin="22,0,10,0"/>
                            <Slider x:Name="SlHwWidth" Minimum="0.18" Maximum="0.9" TickFrequency="0.02" IsSnapToTickEnabled="True" Width="170" ValueChanged="HwLayout_Changed"/>
                            <TextBlock x:Name="TxtHwWidth" FontSize="13" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="水平偏移（像素，向右为正）" FontSize="13" FontWeight="Bold" Foreground="#1F2A37" Margin="12,0,0,2"/>
                        <Slider x:Name="SlHwX" Minimum="-900" Maximum="900" TickFrequency="10" IsSnapToTickEnabled="True" Width="520" HorizontalAlignment="Left" Margin="12,0,0,0" ValueChanged="HwLayout_Changed"/>
                        <TextBlock x:Name="TxtHwX" FontSize="12" Foreground="#6B7280" Margin="12,0,0,0"/>
                        <TextBlock Text="垂直偏移（像素，向下为正）" FontSize="13" FontWeight="Bold" Foreground="#1F2A37" Margin="12,14,0,2"/>
                        <Slider x:Name="SlHwY" Minimum="-700" Maximum="700" TickFrequency="10" IsSnapToTickEnabled="True" Width="520" HorizontalAlignment="Left" Margin="12,0,0,0" ValueChanged="HwLayout_Changed"/>
                        <TextBlock x:Name="TxtHwY" FontSize="12" Foreground="#6B7280" Margin="12,0,0,0"/>

                        <!-- 固定大小的作业公示板：位置不随作业条数多少而漂移 -->
                        <CheckBox x:Name="ChkHwFixed" Content="使用固定大小的作业公示板（推荐：位置稳定，不随作业多少漂移）"
                                  FontSize="14" Margin="12,16,0,2" Click="HwLayout_Changed"/>
                        <StackPanel Orientation="Horizontal" Margin="12,6,0,2">
                            <TextBlock Text="固定宽度" FontSize="13" FontWeight="Bold" Foreground="#1F2A37" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Slider x:Name="SlHwFixedW" Minimum="220" Maximum="900" TickFrequency="10" IsSnapToTickEnabled="True" Width="300" HorizontalAlignment="Left" ValueChanged="HwLayout_Changed"/>
                            <TextBlock x:Name="TxtHwFixedW" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="12,6,0,2">
                            <TextBlock Text="固定高度" FontSize="13" FontWeight="Bold" Foreground="#1F2A37" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Slider x:Name="SlHwFixedH" Minimum="0" Maximum="1000" TickFrequency="10" IsSnapToTickEnabled="True" Width="300" HorizontalAlignment="Left" ValueChanged="HwLayout_Changed"/>
                            <TextBlock x:Name="TxtHwFixedH" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="固定高度为 0 时高度随内容自适应；设为具体像素后便签高度固定，内容过多时自动等比缩小以完整放进便签内（不溢出、不截断）。"
                                   FontSize="12" Foreground="#6B7280" TextWrapping="Wrap" Margin="12,4,0,0"/>

                        <!-- 缺交作业名单便签（独立） -->
                        <TextBlock Text="缺交作业名单便签（独立）" FontSize="16" FontWeight="Bold" Foreground="#1F2A37" Margin="0,20,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,8">
                            <TextBlock Text="主题风格" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CbWpMsTheme" Width="190" FontSize="14" ItemTemplate="{StaticResource ThemeItemTemplate}" SelectionChanged="WpHwTheme_Changed"/>
                            <TextBlock Text="（与缺交便签共用同一主题）" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,10">
                            <TextBlock Text="位置" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CbMsAnchor" Width="120" FontSize="14" SelectedIndex="8" SelectionChanged="MsLayout_Changed">
                                <ComboBoxItem Content="左上"/>
                                <ComboBoxItem Content="中上"/>
                                <ComboBoxItem Content="右上"/>
                                <ComboBoxItem Content="左中"/>
                                <ComboBoxItem Content="居中"/>
                                <ComboBoxItem Content="右中"/>
                                <ComboBoxItem Content="左下"/>
                                <ComboBoxItem Content="中下"/>
                                <ComboBoxItem Content="右下"/>
                            </ComboBox>
                            <TextBlock Text="宽度（占屏宽）" FontSize="14" VerticalAlignment="Center" Margin="22,0,10,0"/>
                            <Slider x:Name="SlMsWidth" Minimum="0.18" Maximum="0.9" TickFrequency="0.02" IsSnapToTickEnabled="True" Width="170" ValueChanged="MsLayout_Changed"/>
                            <TextBlock x:Name="TxtMsWidth" FontSize="13" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="水平偏移（像素，向右为正）" FontSize="13" FontWeight="Bold" Foreground="#1F2A37" Margin="12,0,0,2"/>
                        <Slider x:Name="SlMsX" Minimum="-900" Maximum="900" TickFrequency="10" IsSnapToTickEnabled="True" Width="520" HorizontalAlignment="Left" Margin="12,0,0,0" ValueChanged="MsLayout_Changed"/>
                        <TextBlock x:Name="TxtMsX" FontSize="12" Foreground="#6B7280" Margin="12,0,0,0"/>
                        <TextBlock Text="垂直偏移（像素，向下为正）" FontSize="13" FontWeight="Bold" Foreground="#1F2A37" Margin="12,14,0,2"/>
                        <Slider x:Name="SlMsY" Minimum="-700" Maximum="700" TickFrequency="10" IsSnapToTickEnabled="True" Width="520" HorizontalAlignment="Left" Margin="12,0,0,0" ValueChanged="MsLayout_Changed"/>
                        <TextBlock x:Name="TxtMsY" FontSize="12" Foreground="#6B7280" Margin="12,0,0,0"/>
                        <CheckBox x:Name="ChkMsFixed" Content="使用固定大小的缺交名单便签（推荐：位置稳定，不随名单条数漂移）"
                                  FontSize="14" Margin="12,10,0,2" Click="MsLayout_Changed"/>
                        <StackPanel Orientation="Horizontal" Margin="12,6,0,2">
                            <TextBlock Text="固定宽度" FontSize="13" FontWeight="Bold" Foreground="#1F2A37" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Slider x:Name="SlMsFixedW" Minimum="220" Maximum="900" TickFrequency="10" IsSnapToTickEnabled="True" Width="300" HorizontalAlignment="Left" ValueChanged="MsLayout_Changed"/>
                            <TextBlock x:Name="TxtMsFixedW" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="12,6,0,2">
                            <TextBlock Text="固定高度" FontSize="13" FontWeight="Bold" Foreground="#1F2A37" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Slider x:Name="SlMsFixedH" Minimum="0" Maximum="1000" TickFrequency="10" IsSnapToTickEnabled="True" Width="300" HorizontalAlignment="Left" ValueChanged="MsLayout_Changed"/>
                            <TextBlock x:Name="TxtMsFixedH" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button x:Name="BtnApplyWp" Content="应用到桌面背景" Padding="18,9" FontSize="15" Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderBrush="{DynamicResource PrimaryBrush}" Click="BtnApplyWp_Click"/>
                            <Button x:Name="BtnClearWp" Content="清除（恢复原壁纸）" Padding="16,9" FontSize="15" Margin="12,0,0,0" Background="#FDE8E8" BorderBrush="#E0A0A0" Click="BtnClearWp_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtWpStatus" FontSize="12" Foreground="#6B7280" Margin="10,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="提示：应用后调整上面的位置 / 宽度 / 主题会自动重绘；课表内容变化、跨天也会自动更新。开启「固定大小」后便签尺寸不变、位置稳定，内容过多时会自动等比缩小以完整显示。悬浮课表 / 作业便签 / 缺交便签底部与任务栏图标右键菜单都能一键开关各自在桌面背景上的显示。"
                                   FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnCancel" Content="取消" Padding="18,8" FontSize="14" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave" Content="保存并应用" Padding="18,8" FontSize="14" Click="BtnSave_Click" Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderBrush="{DynamicResource PrimaryBrush}"/>
        </StackPanel>
    </Grid>
</Window>
