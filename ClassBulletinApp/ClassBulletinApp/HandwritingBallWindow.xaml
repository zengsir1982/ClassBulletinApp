<Window x:Class="ClassBulletinApp.HandwritingBallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手写球" Width="56" Height="56"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False" WindowStartupLocation="Manual"
        UseLayoutRounding="True">

    <!-- 整个格子接鼠标：按下拖动 / 抬起点击。触摸会被 WPF 提升成鼠标事件，不必单独处理 Touch。 -->
    <Grid x:Name="Root" Background="Transparent"
          MouseLeftButtonDown="Root_MouseLeftButtonDown"
          MouseMove="Root_MouseMove"
          MouseLeftButtonUp="Root_MouseLeftButtonUp"
          ToolTip="点一下手写输入；按住可以拖到别处">

        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="手写字（插入到刚才的输入框）" Click="MenuWrite_Click"/>
                <MenuItem Header="隐藏这个球（可在控制面板里重新打开）" Click="MenuHide_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <Ellipse x:Name="BallFill" Fill="#2D6CDF" Stroke="#FFFFFF" StrokeThickness="2.5"/>

        <!-- 用文字而不是图标：教室里不需要猜"这个符号是干什么的" -->
        <TextBlock Text="手写" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsHitTestVisible="False"/>
    </Grid>
</Window>
