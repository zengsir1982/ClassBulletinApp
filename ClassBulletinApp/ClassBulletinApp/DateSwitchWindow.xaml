<Window x:Class="ClassBulletinApp.DateSwitchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="切换显示日期" Height="270" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="22">
        <TextBlock Text="选择要显示的日期（可用于调休上课）" FontSize="15" FontWeight="Bold" Foreground="#1F2A37" Margin="0,0,0,10"/>
        <DatePicker x:Name="Dp" FontSize="16" SelectedDateFormat="Long" Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="前一天" Padding="12,6" FontSize="13" Margin="0,0,6,0" Click="Prev_Click"/>
            <Button Content="后一天" Padding="12,6" FontSize="13" Margin="0,0,6,0" Click="Next_Click"/>
            <Button Content="今天" Padding="14,6" FontSize="13" Click="Today_Click" Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}"/>
        </StackPanel>

        <TextBlock Text="提示：选某工作日可查看该天课表（调休补课）；点「今天」切回实时当天。" FontSize="12" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,14"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Padding="14,7" FontSize="14" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="确定" Padding="14,7" FontSize="14" Click="Ok_Click" Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderBrush="{DynamicResource PrimaryBrush}"/>
        </StackPanel>
    </StackPanel>
</Window>
