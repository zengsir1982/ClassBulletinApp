<Window x:Class="ClassBulletinApp.HomeworkEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClassBulletinApp"
        xmlns:ctl="clr-namespace:ClassBulletinApp.Controls"
        Title="作业公示 · 编辑内容、格式与主题" Height="760" Width="800"
        MinWidth="640" MinHeight="520" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip" Background="{DynamicResource BarSurfaceBrush}">
    <Window.Resources>
        <local:HexToBrushConverter x:Key="HexToBrush"/>
        <local:SizeLevelToFontSizeConverter x:Key="LevelToFont"/>

        <!-- 正文：按条目的加粗 / 颜色 / 字号档位即时呈现（与便签、桌面背景一致）。
             颜色与字号用转换器解析，因此预设色之外的「自定义颜色」也能正确预览。 -->
        <Style x:Key="HwStyledBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="{Binding SizeLevel, Converter={StaticResource LevelToFont}}"/>
            <Setter Property="Foreground" Value="{Binding Color, Converter={StaticResource HexToBrush}}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Bold}" Value="True">
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 科目输入框：字号 / 颜色 / 粗细跟着科目样式走，改完立刻能看出效果 -->
        <Style x:Key="HwSubjectBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="{Binding SubjectStyle.SizeLevel, Converter={StaticResource LevelToFont}}"/>
            <Setter Property="Foreground" Value="{Binding SubjectStyle.Color, Converter={StaticResource HexToBrush}}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SubjectStyle.Bold}" Value="True">
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- r71 统一排版：预览 → 主题 / 锁定 → 格式条 → 总标题 → 添加与输入 → 底栏。
         格式条是整窗唯一入口（焦点跟随），所以输入框下面不再重复放小工具条。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ① 预览：最上方就能看见改完大概什么样 -->
        <Border Grid.Row="0" Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <Border x:Name="PreviewCard" CornerRadius="10" Padding="12" BorderThickness="1"
                    Background="#FFF9C4" BorderBrush="#F0DFA0">
                <StackPanel>
                    <TextBlock x:Name="PreviewTitle" Text="各科作业公示" FontSize="16" FontWeight="Bold" Foreground="#8D6E00"/>
                    <TextBlock x:Name="PreviewSubject" Text="【示例科目】" FontSize="13" FontWeight="Bold" Foreground="#A17400" Margin="0,6,0,0"/>
                    <TextBlock x:Name="PreviewBody" Text="示例：完成练习册 P32 第 1-8 题" FontSize="13" Foreground="#4A3F1A" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- ② 主题风格 + 锁定 -->
        <Border Grid.Row="1" Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="主题风格" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CbTheme" Width="190" FontSize="14" SelectionChanged="CbTheme_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <Rectangle Width="18" Height="18" RadiusX="4" RadiusY="4"
                                           Fill="{Binding Background}" Stroke="{DynamicResource HintBrush}" StrokeThickness="1" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox x:Name="ChkLocked" Content="锁定便签" Margin="18,0,0,0" FontSize="14" VerticalAlignment="Center"
                          ToolTip="锁定后该便签不能移动 / 缩放 / 编辑，防止误操作"/>
            </WrapPanel>
        </Border>

        <!-- ③ 文字格式：全窗只一条工具条，焦点落在哪个输入框就改哪个字段的格式 -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel LastChildFill="False">
                <TextBlock Text="文字格式" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ctl:TextStylePicker x:Name="PickStyle"/>
            </DockPanel>
        </Border>

        <!-- ④ 标签标题（总标题） -->
        <Border Grid.Row="3" Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="总标题" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtTitle" Width="420" FontSize="14" Padding="6" Background="White" BorderBrush="{DynamicResource InputBorderBrush}"/>
            </StackPanel>
        </Border>

        <!-- ⑤ 添加记录 + 各字段输入框 -->
        <ScrollViewer Grid.Row="4" Margin="14" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                    <TextBlock Text="各科作业" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                    <Button x:Name="BtnAddHw" DockPanel.Dock="Right" Content="＋ 添加科目" Click="BtnAddHw_Click" Padding="14,8" FontSize="14" MinHeight="40"
                            Background="{DynamicResource PrimarySoftBrush}" BorderBrush="#B9CBE8"/>
                </DockPanel>
                <ItemsControl x:Name="HwItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource HwSubjectBox}"
                                             Text="{Binding Subject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="8" MinHeight="40" Margin="0,0,6,0" Background="White" BorderBrush="{DynamicResource InputBorderBrush}" ToolTip="科目"
                                             GotFocus="HwSubject_GotFocus"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource HwStyledBox}" Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,6,0" Background="White" BorderBrush="{DynamicResource InputBorderBrush}" AcceptsReturn="True" Height="58" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="作业内容"
                                             GotFocus="HwContent_GotFocus"/>
                                    <Button Grid.Column="2" Content="删除" Padding="10,6" FontSize="13" MinHeight="38" Click="BtnDelHw_Click" Tag="{Binding}" Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}"/>
                                </Grid>
                                <!-- r71：上方已有整窗格式条，这里不再重复一套紧凑工具条 -->
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <DockPanel LastChildFill="False" Margin="0,4,0,8">
                    <TextBlock Text="缺交作业名单已独立为单独的便签" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 底栏 -->
        <Border Grid.Row="5" Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel LastChildFill="False">
                <!-- 触摸屏专用入口：把手指写的字识别后插回当前输入框 -->
                <Button x:Name="BtnHand" DockPanel.Dock="Left" Content="✎ 手写输入" Click="BtnHand_Click"
                        MinHeight="44" Padding="14,6" FontSize="15" Margin="0,0,16,0"
                        Background="{DynamicResource PrimarySoftBrush}" BorderBrush="#B9CBE8"
                        ToolTip="先用手指点一下要输入的输入框，再点这里手写"/>
                <Button x:Name="BtnOk" DockPanel.Dock="Right" Content="确定" Padding="24,8" FontSize="15" MinHeight="44" Margin="10,0,0,0"
                        Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderBrush="{DynamicResource PrimaryBrush}" IsDefault="True" Click="BtnOk_Click"/>
                <Button x:Name="BtnCancel" DockPanel.Dock="Right" Content="取消" Padding="24,8" FontSize="15" MinHeight="44"
                        Background="White" BorderBrush="{DynamicResource InputBorderBrush}" IsCancel="True" Click="BtnCancel_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
