<Window x:Class="ClassBulletinApp.HomeworkEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClassBulletinApp"
        xmlns:ctl="clr-namespace:ClassBulletinApp.Controls"
        Title="作业公示 · 编辑内容、格式与主题" Height="760" Width="800"
        MinWidth="640" MinHeight="520" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip" Background="#F2F5FA">
    <Window.Resources>
        <local:HexToBrushConverter x:Key="HexToBrush"/>
        <local:SizeLevelToFontSizeConverter x:Key="LevelToFont"/>

        <!-- 正文：按条目的加粗 / 颜色 / 字号档位即时呈现（与便签、桌面背景一致）。
             颜色与字号用转换器解析，因此预设色之外的「自定义颜色」也能正确预览。 -->
        <Style x:Key="HwStyledBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="{Binding SizeLevel, Converter={StaticResource LevelToFont}}"/>
            <Setter Property="Foreground" Value="{Binding Color, Converter={StaticResource HexToBrush}}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Bold}" Value="True">
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 科目输入框：字号 / 颜色 / 粗细跟着科目样式走，改完立刻能看出效果 -->
        <Style x:Key="HwSubjectBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="{Binding SubjectStyle.SizeLevel, Converter={StaticResource LevelToFont}}"/>
            <Setter Property="Foreground" Value="{Binding SubjectStyle.Color, Converter={StaticResource HexToBrush}}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SubjectStyle.Bold}" Value="True">
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：总标题 + 主题风格 + 预览 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E3E8EF" BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="总标题" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtTitle" Width="240" FontSize="14" Padding="6" Background="White" BorderBrush="#D1D5DB"/>
                    <TextBlock Text="主题风格" FontSize="14" VerticalAlignment="Center" Margin="18,0,8,0"/>
                    <ComboBox x:Name="CbTheme" Width="190" FontSize="14" SelectionChanged="CbTheme_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <Rectangle Width="18" Height="18" RadiusX="4" RadiusY="4"
                                               Fill="{Binding Background}" Stroke="#9AA3AF" StrokeThickness="1" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- 标题样式：加粗 / 字号 / 颜色一行搞定（与作业条目的「内容」共用同一个控件） -->
                <ctl:TextStylePicker x:Name="PickTitleStyle" Label="标题样式" PreviewText="各科作业公示"
                                     Margin="0,0,0,10"/>

                <Border x:Name="PreviewCard" CornerRadius="10" Padding="12" BorderThickness="1"
                        Background="#FFF9C4" BorderBrush="#F0DFA0">
                    <StackPanel>
                        <TextBlock x:Name="PreviewTitle" Text="各科作业公示" FontSize="16" FontWeight="Bold" Foreground="#8D6E00"/>
                        <TextBlock x:Name="PreviewSubject" Text="【示例科目】" FontSize="13" FontWeight="Bold" Foreground="#A17400" Margin="0,6,0,0"/>
                        <TextBlock x:Name="PreviewBody" Text="示例：完成练习册 P32 第 1-8 题" FontSize="13" Foreground="#4A3F1A" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- 中部：各科作业 + 缺交名单 -->
        <ScrollViewer Grid.Row="1" Margin="14" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                    <TextBlock Text="各科作业" FontSize="16" FontWeight="Bold" Foreground="#1F2A37" VerticalAlignment="Center"/>
                    <Button x:Name="BtnAddHw" DockPanel.Dock="Right" Content="＋ 添加科目" Click="BtnAddHw_Click" Padding="14,8" FontSize="14" MinHeight="40"
                            Background="#EAF1FD" BorderBrush="#B9CBE8"/>
                </DockPanel>
                <ItemsControl x:Name="HwItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F7F9FC" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Style="{StaticResource HwSubjectBox}"
                                                 Text="{Binding Subject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="8" MinHeight="40" Margin="0,0,6,0" Background="White" BorderBrush="#D1D5DB" ToolTip="科目"/>
                                        <TextBox Grid.Column="1" Style="{StaticResource HwStyledBox}" Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,6,0" Background="White" BorderBrush="#D1D5DB" AcceptsReturn="True" Height="58" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="作业内容"/>
                                        <Button Grid.Column="2" Content="删除" Padding="10,6" FontSize="13" MinHeight="38" Click="BtnDelHw_Click" Tag="{Binding}" Background="#FDE8E8" BorderBrush="#E0A0A0"/>
                                    </Grid>
                                    <!-- 科目与内容各一个「B + 字号 + 颜色」，紧凑模式只占一行，不再分两块重复排版。
                                         用 WrapPanel 按「标签 + 控件」成组换行：窗口拉窄时「内容」整组掉到下一行，
                                         而不是被裁掉半截（两套紧凑控件并排约 700px，窄窗口放不下）。 -->
                                    <WrapPanel Margin="0,7,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                            <TextBlock Text="科目" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ctl:TextStylePicker Compact="True" StyleData="{Binding SubjectStyle}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="内容" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ctl:TextStylePicker Compact="True" StyleData="{Binding ContentStyle}"/>
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <DockPanel LastChildFill="False" Margin="0,4,0,8">
                    <TextBlock Text="缺交作业名单已独立为单独的便签" FontSize="16" FontWeight="Bold" Foreground="#1F2A37" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="缺交名单可在控制面板「便签管理」页的「缺交作业名单」区块、或独立的缺交便签（双击）中编辑：支持独立主题、独立桌面便签位置与固定大小，作业条数再多也不会把它挤出可视区域。"
                           FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,12"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E3E8EF" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel LastChildFill="False">
                <!-- 触摸屏专用入口：把手指写的字识别后插回当前输入框 -->
                <Button x:Name="BtnHand" DockPanel.Dock="Left" Content="✎ 手写输入" Click="BtnHand_Click"
                        MinHeight="44" Padding="14,6" FontSize="15" Margin="0,0,16,0"
                        Background="#EEF5FF" BorderBrush="#B9CBE8"
                        ToolTip="先用手指点一下要输入的输入框，再点这里手写"/>
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#6B7280"
                           Text="提示：确定后会立即保存，并同步更新桌面背景（若已开启）。"/>
                <Button x:Name="BtnOk" DockPanel.Dock="Right" Content="确定" Padding="24,8" FontSize="15" MinHeight="44" Margin="10,0,0,0"
                        Background="#2D6CDF" Foreground="White" BorderBrush="#2D6CDF" IsDefault="True" Click="BtnOk_Click"/>
                <Button x:Name="BtnCancel" DockPanel.Dock="Right" Content="取消" Padding="24,8" FontSize="15" MinHeight="44"
                        Background="White" BorderBrush="#D1D5DB" IsCancel="True" Click="BtnCancel_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
