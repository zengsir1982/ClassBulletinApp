<UserControl x:Class="ClassBulletinApp.WeekView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ClassBulletinApp"
             x:Name="Root"
             Stylus.IsPressAndHoldEnabled="False"
             Stylus.IsFlicksEnabled="False">
    <DockPanel LastChildFill="True">
        <!-- 顶部工具栏 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PrimaryBrush}" Padding="12">
            <DockPanel LastChildFill="True">
                <TextBlock Text="📅 周课程表（拖拽调课）" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnPrevWeek" Content="上一周" Margin="4" Padding="10,5" FontSize="13" Click="BtnPrevWeek_Click"/>
                    <Button x:Name="BtnThisWeek" Content="本周" Margin="4" Padding="10,5" FontSize="13" Click="BtnThisWeek_Click"/>
                    <Button x:Name="BtnNextWeek" Content="下一周" Margin="4" Padding="10,5" FontSize="13" Click="BtnNextWeek_Click"/>
                    <Button x:Name="BtnClearAll" Content="清除本周调课" Margin="4" Padding="10,5" FontSize="13" Click="BtnClearAll_Click" Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}"/>
                    <!-- 周起始日：放在「清除本周调课」右边，改的是「周视图从哪天排到哪天」 -->
                    <Border Background="#FFFFFF" CornerRadius="4" Padding="8,2" Margin="10,4,4,4" VerticalAlignment="Center"
                            ToolTip="只改周视图从哪天排到哪天、以及「本周」是哪 7 天；课表内容与调代课记录不受影响。">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="一周从" FontSize="13" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CbWeekStartDay" Width="92" FontSize="13" VerticalAlignment="Center"
                                      SelectionChanged="CbWeekStartDay_SelectionChanged"/>
                            <TextBlock Text="开始" FontSize="13" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 周范围 -->
        <Border DockPanel.Dock="Top" Background="#EEF3FB" Padding="8">
            <TextBlock x:Name="TxtWeekRange" FontSize="14" Foreground="{DynamicResource InkBrush}"/>
        </Border>

        <!-- 提示 -->
        <TextBlock x:Name="TxtHint" DockPanel.Dock="Top" FontSize="12" Foreground="{DynamicResource HintBrush}" TextWrapping="Wrap" Margin="10,6"/>

        <!-- 周表格（动态生成）+ 拖动覆盖层。
             ★ PanningMode 必须是 None：只要交给系统托管，ScrollViewer 就会在触摸按下时捕获并
               标记「已处理」，触摸不再提升成鼠标事件，长按 / 拖动 / 双击全部失效。
               滚动由代码自己做（单指快速划动 / 双指划动），与悬浮课表完全同一套规则。
             ★ DragLayer 画在整个视图之上：幽灵卡跟手时不能被 ScrollViewer 裁掉。 -->
        <Grid>
            <ScrollViewer x:Name="WeekScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                          PanningMode="None">
                <Grid x:Name="WeekGrid" Margin="10" MinWidth="900"/>
            </ScrollViewer>
            <Canvas x:Name="DragLayer" IsHitTestVisible="False"/>
        </Grid>

        <!-- 状态栏 -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource BarSurfaceBrush}" Padding="8">
            <TextBlock x:Name="TxtStatus" FontSize="13" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
        </Border>
    </DockPanel>
</UserControl>
