<Window x:Class="ClassBulletinApp.RetrievePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="找回 / 重置密码" Height="500" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F5F7FA">
    <Border Background="White" CornerRadius="14" BorderBrush="#D8DEE9" BorderThickness="1" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" Opacity="0.25" ShadowDepth="4" Direction="300"/>
        </Border.Effect>
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="🔑 找回或重置密码" FontSize="22" FontWeight="Bold" Foreground="#1F2A37"/>
                <TextBlock Text="请输入用户名，并通过您在「用户中心」设置的电子邮箱 / 手机号码 / 密保问题验证身份。" FontSize="13" Foreground="#6B7280" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <RadioButton x:Name="RbRetrieve" Content="找回密码（显示当前密码）" GroupName="Mode" IsChecked="True" FontSize="14" Checked="Mode_Changed"/>
                    <RadioButton x:Name="RbReset" Content="重置密码（设置新密码）" GroupName="Mode" FontSize="14" Margin="16,0,0,0" Checked="Mode_Changed"/>
                </StackPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="用户名" FontSize="14" Foreground="#4B5563" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtUser" FontSize="15" Padding="9" Background="White" BorderBrush="#D1D5DB" TextChanged="TxtUser_TextChanged"/>

                    <Border Background="#F7F9FC" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="身份验证（任选一种您设置过的方式）" FontSize="13" FontWeight="Bold" Foreground="#4B5563" Margin="0,0,0,8"/>
                            <TextBlock Text="电子邮箱" FontSize="13" Foreground="#4B5563" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtEmail" FontSize="14" Padding="8" Background="White" BorderBrush="#D1D5DB" Margin="0,0,0,8"/>
                            <TextBlock Text="手机号码" FontSize="13" Foreground="#4B5563" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtPhone" FontSize="14" Padding="8" Background="White" BorderBrush="#D1D5DB" Margin="0,0,0,8"/>
                            <TextBlock Text="密保问题" FontSize="13" Foreground="#4B5563" Margin="0,0,0,3"/>
                            <TextBlock x:Name="TxtSecQuestion" FontSize="14" Padding="8" Background="#EEF2F7" Foreground="#4B5563" TextWrapping="Wrap" Margin="0,0,0,8">（请输入正确的用户名后显示）</TextBlock>
                            <TextBlock Text="密保答案" FontSize="13" Foreground="#4B5563" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtAnswer" FontSize="14" Padding="8" Background="White" BorderBrush="#D1D5DB"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="TxtReveal" FontSize="15" FontWeight="Bold" Foreground="#2E8B57" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

                    <StackPanel x:Name="PnlReset" Visibility="Collapsed" Margin="0,12,0,0">
                        <TextBlock Text="新密码" FontSize="14" Foreground="#4B5563" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="TxtNewPwd" FontSize="15" Padding="9" Background="White" BorderBrush="#D1D5DB" Margin="0,0,0,10"/>
                        <TextBlock Text="确认新密码" FontSize="14" Foreground="#4B5563" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="TxtNewPwd2" FontSize="15" Padding="9" Background="White" BorderBrush="#D1D5DB"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtMsg" FontSize="13" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="BtnVerify" Content="验证身份" Padding="16,8" FontSize="14" Margin="0,0,10,0"
                        Background="#2D6CDF" Foreground="White" BorderBrush="#2D6CDF" Click="BtnVerify_Click"/>
                <Button x:Name="BtnConfirmReset" Content="确认重置" Padding="16,8" FontSize="14" Margin="0,0,10,0" Visibility="Collapsed"
                        Background="#2E8B57" Foreground="White" BorderBrush="#2E8B57" Click="BtnConfirmReset_Click"/>
                <Button x:Name="BtnClose" Content="关闭" Padding="16,8" FontSize="14"
                        Background="White" BorderBrush="#D1D5DB" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
