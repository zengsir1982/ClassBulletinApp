<Window x:Class="ClassBulletinApp.ClassSwitchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="切换显示班级" Height="320" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="选择要显示的班级" FontSize="18" FontWeight="Bold" Foreground="#1F2A37" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="适用于多班共用一台设备时，快速切换悬浮窗显示的班级课表。" FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,14"/>

        <ComboBox x:Name="CbClass" Grid.Row="2" FontSize="16" Padding="10" Background="White" BorderBrush="#D1D5DB"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnCancel" Content="取消" Padding="14,8" FontSize="14" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button x:Name="BtnOk" Content="确定" Padding="14,8" FontSize="14" Click="BtnOk_Click" Background="#2D6CDF" Foreground="White" BorderBrush="#2D6CDF"/>
        </StackPanel>
    </Grid>
</Window>
