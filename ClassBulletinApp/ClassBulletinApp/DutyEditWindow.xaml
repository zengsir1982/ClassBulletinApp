<Window x:Class="ClassBulletinApp.DutyEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:ClassBulletinApp.Controls"
        xmlns:local="clr-namespace:ClassBulletinApp"
        Title="值日生名单 · 编辑" Height="660" Width="820"
        MinWidth="640" MinHeight="520" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip" Background="#F2F5FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 + 主题风格 + 高亮今天 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E3E8EF" BorderThickness="0,0,0,1" Padding="16,12">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="卡片标题" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtTitle" Width="200" FontSize="14" Padding="6" Background="White" BorderBrush="#D1D5DB"/>
                <TextBlock Text="主题风格" FontSize="14" VerticalAlignment="Center" Margin="18,0,8,0"/>
                <ComboBox x:Name="CbTheme" Width="176" FontSize="14" SelectionChanged="CbTheme_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <Rectangle Width="18" Height="18" RadiusX="4" RadiusY="4"
                                           Fill="{Binding Background}" Stroke="#9AA3AF" StrokeThickness="1" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox x:Name="ChkHighlight" Content="高亮今天那一行" Margin="18,0,0,0" FontSize="14"
                          VerticalAlignment="Center" ToolTip="按今天的星期几，把对应那一行的底色 / 竖条标出来"/>
            </WrapPanel>
        </Border>

        <!-- 文字样式：标题 / 内容各一行，用统一的 TextStylePicker（加粗 + 字号 + 颜色 + 预览） -->
        <Border Grid.Row="1" Background="#F7F9FC" BorderBrush="#E3E8EF" BorderThickness="0,0,0,1" Padding="16,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ctl:TextStylePicker x:Name="PickTitleStyle" Label="标题样式" PreviewText="值日生名单"
                                     Margin="0,0,26,0" StyleChanged="Style_Changed"/>
                <ctl:TextStylePicker x:Name="PickContentStyle" Label="姓名样式" PreviewText="张小明"
                                     Margin="0,0,26,0" StyleChanged="Style_Changed"/>
                <ctl:TextStylePicker x:Name="PickDayStyle" Label="星期样式" PreviewText="周一"
                                     Margin="0,0,26,0" StyleChanged="Style_Changed"/>
                <ctl:TextStylePicker x:Name="PickDutyStyle" Label="内容样式" PreviewText="扫地、拖地"
                                     StyleChanged="Style_Changed"/>
            </WrapPanel>
        </Border>

        <!-- 值日安排列表 -->
        <Grid Grid.Row="2" Margin="14,12,14,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6">
                <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="#4B5563"
                           Text="值日安排（姓名可用逗号 / 顿号分隔；「每天」用于天天一样的固定岗位）"/>
                <Button x:Name="BtnAdd" DockPanel.Dock="Right" Content="＋ 添加一条" Padding="12,5" FontSize="13"
                        Background="{DynamicResource PrimaryBrush}" Foreground="White"
                        BorderBrush="{DynamicResource PrimaryBrush}" Click="BtnAdd_Click"
                        ToolTip="新增一条值日安排"/>
                <Button x:Name="BtnDel" DockPanel.Dock="Right" Content="删除选中" Padding="12,5" FontSize="13" Margin="0,0,8,0"
                        Background="#FDE8E8" BorderBrush="#E0A0A0" Foreground="#C0392B" Click="BtnDel_Click"
                        ToolTip="删除列表里选中的那一条（不可撤销）"/>
                <Button x:Name="BtnTpl" DockPanel.Dock="Right" Content="一键铺满周一~周五" Padding="12,5" FontSize="13" Margin="0,0,8,0"
                        Background="White" BorderBrush="#D1D5DB" Click="BtnTpl_Click"
                        ToolTip="把周一到周五的空白行一次性补齐（已有对应星期的行不会重复添加）"/>
            </DockPanel>

            <DataGrid Grid.Row="1" x:Name="GridItems" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" CanUserResizeRows="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E8ECF2"
                      RowHeight="34" FontSize="13" Background="White" BorderBrush="#D1D5DB"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      AlternatingRowBackground="#FAFBFD">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="星期" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{x:Static local:DutyEditWindow.DayNameList}"
                                          SelectedItem="{Binding Day, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                          Margin="2,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="值日生姓名" Width="2*" Binding="{Binding Names, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="值日内容（可空）" Width="*" Binding="{Binding Duty, UpdateSourceTrigger=PropertyChanged}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- 底部按钮 -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E3E8EF" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel LastChildFill="False">
                <Button x:Name="BtnHand" DockPanel.Dock="Left" Content="✎ 手写输入" Click="BtnHand_Click"
                        Padding="14,7" FontSize="14" Margin="0,0,14,0"
                        Background="#EEF5FF" BorderBrush="#9EC1F0"
                        ToolTip="先在列表里双击要填的单元格（光标进了格子），再点这里手写；识别后插入"/>
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#6B7280"
                           Text="提示：确定后立即保存。在屏幕上双击值日便签也可打开本窗口。"/>
                <Button x:Name="BtnOk" DockPanel.Dock="Right" Content="确定" Padding="20,7" FontSize="14" Margin="10,0,0,0"
                        Background="#2D6CDF" Foreground="White" BorderBrush="#2D6CDF" IsDefault="True" Click="BtnOk_Click"/>
                <Button x:Name="BtnCancel" DockPanel.Dock="Right" Content="取消" Padding="20,7" FontSize="14"
                        Background="White" BorderBrush="#D1D5DB" IsCancel="True" Click="BtnCancel_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
