<Window x:Class="ClassBulletinApp.DutyEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:ClassBulletinApp.Controls"
        xmlns:local="clr-namespace:ClassBulletinApp"
        Title="值日生名单 · 编辑" Height="700" Width="820"
        MinWidth="640" MinHeight="520" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip" Background="{DynamicResource BarSurfaceBrush}">
    <!-- r71 统一排版：预览 → 主题 / 锁定 → 格式条 → 卡片标题 → 添加与输入 → 底栏 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ① 预览：标题跟着上面的输入框变，底色跟着主题下拉变（纯绑定，零额外代码） -->
        <Border Grid.Row="0" Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <Border x:Name="PreviewCard" CornerRadius="10" Padding="12" BorderThickness="1"
                    Background="{Binding SelectedItem.Background, ElementName=CbTheme}"
                    BorderBrush="{DynamicResource LineBrush}">
                <StackPanel>
                    <TextBlock Text="值日生名单 · 预览" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,2"/>
                    <TextBlock x:Name="PreviewTitle" Text="{Binding Text, ElementName=TxtTitle}"
                               FontSize="16" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                    <TextBlock x:Name="PreviewBody" Text="示例：周一　扫地、拖地　张三、李四"
                               FontSize="13" Foreground="{DynamicResource BodyBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- ② 主题风格 + 锁定 + 高亮今天（同一行） -->
        <Border Grid.Row="1" Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="主题风格" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CbTheme" Width="176" FontSize="14" SelectionChanged="CbTheme_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <Rectangle Width="18" Height="18" RadiusX="4" RadiusY="4"
                                           Fill="{Binding Background}" Stroke="{DynamicResource HintBrush}" StrokeThickness="1" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox x:Name="ChkLocked" Content="锁定便签" Margin="18,0,0,0" FontSize="14"
                          VerticalAlignment="Center" ToolTip="锁定后该便签不能移动 / 缩放 / 编辑，防止误操作"/>
                <CheckBox x:Name="ChkHighlight" Content="高亮今天那一行" Margin="18,0,0,0" FontSize="14"
                          VerticalAlignment="Center" ToolTip="按今天的星期几，把对应那一行的底色 / 竖条标出来"/>
            </WrapPanel>
        </Border>

        <!-- ③ 文字格式：全窗只一条工具条，焦点落在哪个输入框 / 表格列就改哪个的格式（Word 式） -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel LastChildFill="False">
                <TextBlock Text="文字格式" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ctl:TextStylePicker x:Name="PickStyle" StyleChanged="Style_Changed"/>
            </DockPanel>
        </Border>

        <!-- ④ 卡片标题 -->
        <Border Grid.Row="3" Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="卡片标题" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtTitle" Width="420" FontSize="14" Padding="6" Background="White" BorderBrush="{DynamicResource InputBorderBrush}"/>
            </StackPanel>
        </Border>

        <!-- ⑤ 添加记录 + 值日表格 -->
        <Grid Grid.Row="4" Margin="14,12,14,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,6">
                <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource BodyBrush}"
                           Text="值日安排（姓名可用逗号 / 顿号分隔；「每天」用于天天一样的固定岗位）"/>
                <Button x:Name="BtnAdd" DockPanel.Dock="Right" Content="＋ 添加一条" Padding="12,5" FontSize="13"
                        Background="{DynamicResource PrimaryBrush}" Foreground="White"
                        BorderBrush="{DynamicResource PrimaryBrush}" Click="BtnAdd_Click"
                        ToolTip="新增一条值日安排"/>
                <Button x:Name="BtnDel" DockPanel.Dock="Right" Content="删除选中" Padding="12,5" FontSize="13" Margin="0,0,8,0"
                        Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" Foreground="{DynamicResource DangerBrush}" Click="BtnDel_Click"
                        ToolTip="删除列表里选中的那一条（不可撤销）"/>
                <Button x:Name="BtnTpl" DockPanel.Dock="Right" Content="一键铺满周一~周五" Padding="12,5" FontSize="13" Margin="0,0,8,0"
                        Background="White" BorderBrush="{DynamicResource InputBorderBrush}" Click="BtnTpl_Click"
                        ToolTip="把周一到周五的空白行一次性补齐（已有对应星期的行不会重复添加）"/>
            </DockPanel>

            <DataGrid Grid.Row="1" x:Name="GridItems" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" CanUserResizeRows="False" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E8ECF2"
                      RowHeight="34" FontSize="13" Background="White" BorderBrush="{DynamicResource InputBorderBrush}"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      AlternatingRowBackground="#FAFBFD">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="星期" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{x:Static local:DutyEditWindow.DayNameList}"
                                          SelectedItem="{Binding Day, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                          Margin="2,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="值日生姓名" Width="2*" Binding="{Binding Names, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="值日内容（可空）" Width="*" Binding="{Binding Duty, UpdateSourceTrigger=PropertyChanged}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- 底栏 -->
        <Border Grid.Row="5" Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel LastChildFill="False">
                <Button x:Name="BtnHand" DockPanel.Dock="Left" Content="✎ 手写输入" Click="BtnHand_Click"
                        Padding="14,7" FontSize="14" Margin="0,0,14,0"
                        Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource PrimarySoftBorderBrush}"
                        ToolTip="先在列表里双击要填的单元格（光标进了格子），再点这里手写；识别后插入"/>
                <Button x:Name="BtnOk" DockPanel.Dock="Right" Content="确定" Padding="20,7" FontSize="14" Margin="10,0,0,0"
                        Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderBrush="{DynamicResource PrimaryBrush}" IsDefault="True" Click="BtnOk_Click"/>
                <Button x:Name="BtnCancel" DockPanel.Dock="Right" Content="取消" Padding="20,7" FontSize="14"
                        Background="White" BorderBrush="{DynamicResource InputBorderBrush}" IsCancel="True" Click="BtnCancel_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
