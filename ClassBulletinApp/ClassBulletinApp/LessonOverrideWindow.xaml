<Window x:Class="ClassBulletinApp.LessonOverrideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑临时调课 / 代课" Height="520" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 上半：可滚动的字段区 -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,22,22,12">
                <TextBlock x:Name="TxtTitle" FontSize="18" FontWeight="Bold" Foreground="#1F2A37" Margin="0,0,0,6"/>
                <TextBlock Text="填写后将临时替换该节课（优先于总课表），可随时清除恢复。" FontSize="13" Foreground="#6B7280" Margin="0,0,0,14" TextWrapping="Wrap"/>

                <Label Content="调课类型" FontSize="14" Padding="0,0,0,4"/>
                <ComboBox x:Name="CbType" FontSize="15" Padding="9" Background="White" BorderBrush="#D1D5DB" Margin="0,0,0,8">
                    <ComboBoxItem Content="调课"/>
                    <ComboBoxItem Content="代课"/>
                </ComboBox>

                <Label Content="从本课表选择科目（可选，自动带出教师）" FontSize="14" Padding="0,0,0,4"/>
                <ComboBox x:Name="CbSubjects" FontSize="15" Padding="9" Background="White" BorderBrush="#D1D5DB"
                          SelectionChanged="CbSubjects_SelectionChanged"/>

                <Label Content="科目" FontSize="14" Padding="0,8,0,4"/>
                <TextBox x:Name="TxtSubject" FontSize="15" Padding="9" Background="White" BorderBrush="#D1D5DB"/>
                <Label Content="教师" FontSize="14" Padding="0,8,0,4"/>
                <TextBox x:Name="TxtTeacher" FontSize="15" Padding="9" Background="White" BorderBrush="#D1D5DB"/>
                <Label Content="地点" FontSize="14" Padding="0,8,0,4"/>
                <TextBox x:Name="TxtLocation" FontSize="15" Padding="9" Background="White" BorderBrush="#D1D5DB"/>
                <Label Content="备注（调课原因，选填）" FontSize="14" Padding="0,8,0,4"/>
                <TextBox x:Name="TxtNote" FontSize="14" Padding="9" Height="46" TextWrapping="Wrap" AcceptsReturn="True" Background="White" BorderBrush="#D1D5DB"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 下半：固定底部按钮栏（始终可见，不会被裁切） -->
        <Border Grid.Row="1" Background="#F7F8FA" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,12">
                <Button x:Name="BtnClear" Content="清除调课" Padding="14,8" FontSize="14" Margin="0,0,10,0" Click="BtnClear_Click" Background="#FDECEA" BorderBrush="#F5B7B1" Foreground="#C0392B"/>
                <Button x:Name="BtnCancel" Content="取消" Padding="14,8" FontSize="14" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                <Button x:Name="BtnSave" Content="保存" Padding="14,8" FontSize="14" Click="BtnSave_Click" Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderBrush="{DynamicResource PrimaryBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
