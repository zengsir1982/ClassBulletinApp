<Window x:Class="ClassBulletinApp.NotificationEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:ClassBulletinApp.Controls"
        Title="编辑通知 / 公告" Height="700" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📢 通知 / 公告编辑（双击下方条目可载入修改）" FontSize="18" FontWeight="Bold"
                   Foreground="{DynamicResource InkBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <ListBox Grid.Row="1" x:Name="Lst" FontSize="14" MouseDoubleClick="Lst_MouseDoubleClick"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource InkBrush}"/>
                            <Border Background="#EEF2FF" CornerRadius="3" Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ScopeText}" FontSize="11" Foreground="#4338CA"/>
                            </Border>
                            <Border Background="#FFF4E5" CornerRadius="3" Padding="5,0" Margin="4,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DueText}" FontSize="11" Foreground="#8A5A00"/>
                            </Border>
                            <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="{DynamicResource HintBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Content}" FontSize="13" Foreground="{DynamicResource BodyBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <!-- 文字格式：全窗只一条工具条，放在第一个输入框上方；焦点落在标题 / 内容就改各自的格式 -->
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6"
                    Padding="10,6" Margin="0,0,0,8">
                <DockPanel LastChildFill="False">
                    <TextBlock Text="文字格式" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ctl:TextStylePicker x:Name="PickStyle" StyleChanged="Style_Changed"/>
                </DockPanel>
            </Border>
            <TextBlock Text="标题（选填）" FontSize="13" Foreground="{DynamicResource MutedBrush}"/>
            <TextBox x:Name="TxtTitle" FontSize="15" Padding="9" Margin="0,3,0,8" Background="White" BorderBrush="{DynamicResource InputBorderBrush}"/>
            <TextBlock Text="内容" FontSize="13" Foreground="{DynamicResource MutedBrush}"/>
            <TextBox x:Name="TxtContent" FontSize="14" Padding="9" Height="76" TextWrapping="Wrap" AcceptsReturn="True"
                     Background="White" BorderBrush="{DynamicResource InputBorderBrush}" VerticalScrollBarVisibility="Auto"/>
            <CheckBox x:Name="ChkSchool" Content="设为全校通知（随数据包同步到所有教室机；不勾选则只在本机显示）"
                      FontSize="13" Foreground="{DynamicResource BodyBrush}" Margin="0,9,0,0"/>
            <TextBlock Text="截止日期（有效期到哪天为止；留空 = 长期有效。到期后只在通知公告便签与跑马灯撤下，数据保留、可再改回来；置顶的通知不撤）"
                       FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
            <DatePicker x:Name="DtpDue" FontSize="14" Margin="0,3,0,0" FirstDayOfWeek="Monday"
                        BorderBrush="{DynamicResource InputBorderBrush}" Background="White"/>
            <CheckBox x:Name="ChkShowDeleted" Content="显示已撤下的通知（选中后点「更新选中」可恢复）"
                      FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" Click="ChkShowDeleted_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnAdd" Content="添加通知" Padding="12,7" FontSize="14" Margin="0,0,8,0" Click="BtnAdd_Click"
                    Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderBrush="{DynamicResource PrimaryBrush}"/>
            <Button x:Name="BtnUpdate" Content="更新选中" Padding="12,7" FontSize="14" Margin="0,0,8,0" Click="BtnUpdate_Click"/>
            <Button x:Name="BtnDelete" Content="撤下选中" Padding="12,7" FontSize="14" Margin="0,0,8,0" Click="BtnDelete_Click"
                    Background="#FDECEA" BorderBrush="#F5B7B1" Foreground="{DynamicResource DangerBrush}"/>
            <Button x:Name="BtnClose" Content="关闭" Padding="12,7" FontSize="14" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
