<Window x:Class="ClassBulletinApp.NotificationEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑通知 / 公告" Height="580" Width="580"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📢 通知 / 公告编辑（双击下方条目可载入修改）" FontSize="18" FontWeight="Bold"
                   Foreground="#1F2A37" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <ListBox Grid.Row="1" x:Name="Lst" FontSize="14" MouseDoubleClick="Lst_MouseDoubleClick"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,3">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" Foreground="#1F2A37"/>
                        <TextBlock Text="{Binding Content}" FontSize="13" Foreground="#4B5563" TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="标题（选填）" FontSize="13" Foreground="#6B7280"/>
            <TextBox x:Name="TxtTitle" FontSize="15" Padding="9" Margin="0,3,0,8" Background="White" BorderBrush="#D1D5DB"/>
            <TextBlock Text="内容" FontSize="13" Foreground="#6B7280"/>
            <TextBox x:Name="TxtContent" FontSize="14" Padding="9" Height="76" TextWrapping="Wrap" AcceptsReturn="True"
                     Background="White" BorderBrush="#D1D5DB" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnAdd" Content="添加通知" Padding="12,7" FontSize="14" Margin="0,0,8,0" Click="BtnAdd_Click"
                    Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderBrush="{DynamicResource PrimaryBrush}"/>
            <Button x:Name="BtnUpdate" Content="更新选中" Padding="12,7" FontSize="14" Margin="0,0,8,0" Click="BtnUpdate_Click"/>
            <Button x:Name="BtnDelete" Content="删除选中" Padding="12,7" FontSize="14" Margin="0,0,8,0" Click="BtnDelete_Click"
                    Background="#FDECEA" BorderBrush="#F5B7B1" Foreground="#C0392B"/>
            <Button x:Name="BtnClose" Content="关闭" Padding="12,7" FontSize="14" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
