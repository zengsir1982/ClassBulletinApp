<Window x:Class="ClassBulletinApp.ImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="智能导入课表 · 预览与校正" Height="680" Width="1120"
        MinHeight="480" MinWidth="900" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}">
    <Grid Margin="18,16,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题行 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TxtTitle" Text="智能导入课表 · 预览与校正" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtConfidence" Text="" FontSize="13" Foreground="#1E7A46"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="TxtFile" Text="" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- 提示条 -->
        <Border x:Name="TipBar" Grid.Row="1" Background="#FFF6E5" BorderBrush="#E8C48A" BorderThickness="1"
                CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
            <TextBlock x:Name="TxtTip" Text="" FontSize="13" Foreground="#8A5A12" TextWrapping="Wrap"/>
        </Border>

        <!-- 三栏主体 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260"/>
                <ColumnDefinition Width="268"/>
                <ColumnDefinition Width="*" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- 左：原始表格 -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                    CornerRadius="6" Background="White" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="原始表格（前若干行，标色为识别到的表头）" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource InkBrush}" Padding="12,10,12,6"/>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Padding="10,0,10,10">
                        <DataGrid x:Name="GridRaw" AutoGenerateColumns="True" HeadersVisibility="All"
                                  IsReadOnly="True" CanUserAddRows="False" CanUserResizeRows="False"
                                  GridLinesVisibility="All" FontSize="11" RowHeight="24"
                                  ColumnHeaderHeight="22"
                                  BorderThickness="0" Background="White"
                                  HorizontalGridLinesBrush="#E8EBF0" VerticalGridLinesBrush="#E8EBF0"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 中：识别参数 -->
            <Border Grid.Column="1" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                    CornerRadius="6" Background="White" Padding="12,10" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="识别参数（可改）" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource InkBrush}" Margin="0,0,0,10"/>

                        <TextBlock Text="工作表" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CbSheet" FontSize="13" Padding="6" Margin="0,0,0,10"/>

                        <TextBlock Text="星期方向" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CbOrientation" FontSize="13" Padding="6" Margin="0,0,0,10">
                            <ComboBoxItem Content="横排（星期在表头行）"/>
                            <ComboBoxItem Content="纵列（星期在最左列）"/>
                        </ComboBox>

                        <TextBlock Text="班级布局" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CbMainDim" FontSize="13" Padding="6" Margin="0,0,0,10">
                            <ComboBoxItem Content="多班 · 班级在行"/>
                            <ComboBoxItem Content="多班 · 班级在列"/>
                            <ComboBoxItem Content="单班 / 单教师"/>
                        </ComboBox>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="表头行/列" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtDayHeader" FontSize="13" Padding="6" PreviewTextInput="NumberOnly"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="节次列/行" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3"/>
                                <TextBox x:Name="TxtPeriodLabel" FontSize="13" Padding="6" PreviewTextInput="NumberOnly"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="节次写法" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CbPeriodStyle" FontSize="13" Padding="6" Margin="0,0,0,10">
                            <ComboBoxItem Content="第N节"/>
                            <ComboBoxItem Content="上午N / 下午N"/>
                            <ComboBoxItem Content="纯数字 1,2,3"/>
                        </ComboBox>

                        <TextBlock Text="单元格格式" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MinWidth="46"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" x:Name="CbCellLayout" FontSize="13" Padding="6"
                                      SelectionChanged="CbCellLayout_SelectionChanged"
                                      ToolTip="换行=科目与教师分两行；空格=「科目 教师」；括号=「科目(教师)」；自定义=自己填分隔符">
                                <ComboBoxItem Content="换行"/>
                                <ComboBoxItem Content="空格"/>
                                <ComboBoxItem Content="括号"/>
                                <ComboBoxItem Content="自定义符号"/>
                            </ComboBox>
                            <!-- r143：自定义分隔符，与档位同一行（挤在下面会被滚动条挡掉）。
                                 探测器猜到时会预填（见 ScheduleTemplateProbe.DetectCustomSeparator）。 -->
                            <TextBlock Grid.Column="1" Text="符号" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedBrush}" Margin="6,0,4,0"/>
                            <TextBox Grid.Column="2" x:Name="TxtCellSep" FontSize="13" Padding="4" MaxLength="4"
                                     IsEnabled="False"
                                     ToolTip="选「自定义符号」后可填，如 ｜ ； · ／（多字符也行，最多 4 个）"/>
                        </Grid>

                        <CheckBox x:Name="ChkTeacher" Content="教师课表（第二行是所教班级）"
                                  FontSize="12" Foreground="{DynamicResource BodyBrush}" Margin="0,0,0,10"/>

                        <TextBlock Text="单班名称（单班布局时）" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtSingleName" FontSize="13" Padding="6" Margin="0,0,0,6"/>

                        <Button x:Name="BtnReparse" Content="按参数重新解析" Click="BtnReparse_Click"
                                Style="{StaticResource AppPrimarySoftButton}" Padding="6,8" FontSize="13" Margin="0,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 右：解析结果 -->
            <Border Grid.Column="2" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                    CornerRadius="6" Background="White">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="解析结果" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"
                               Padding="12,10,12,6"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,0,12,8">
                        <Border Background="#EEF3FB" CornerRadius="6" Padding="10,6" Margin="0,0,8,0" MinWidth="66">
                            <StackPanel>
                                <TextBlock x:Name="StatClasses" Text="0" FontSize="18" FontWeight="Bold" Foreground="#1E4FA3" HorizontalAlignment="Center"/>
                                <TextBlock Text="班级" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#EEF3FB" CornerRadius="6" Padding="10,6" Margin="0,0,8,0" MinWidth="66">
                            <StackPanel>
                                <TextBlock x:Name="StatLessons" Text="0" FontSize="18" FontWeight="Bold" Foreground="#1E4FA3" HorizontalAlignment="Center"/>
                                <TextBlock Text="课时" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="UnparsedBox" Background="#FCEDED" CornerRadius="6" Padding="10,6" MinWidth="66">
                            <StackPanel>
                                <TextBlock x:Name="StatUnparsed" Text="0" FontSize="18" FontWeight="Bold" Foreground="#C0392B" HorizontalAlignment="Center"/>
                                <TextBlock Text="未识别" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="12,0,12,10">
                        <StackPanel x:Name="SamplePanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部按钮 -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="0,1,0,0"
                Margin="0,12,0,0" Padding="0,12,0,0">
            <DockPanel>
                <TextBlock x:Name="TxtStatus" Text="" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           VerticalAlignment="Center" DockPanel.Dock="Left" TextWrapping="Wrap" Margin="0,0,12,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button x:Name="BtnCancel" Content="取消" Click="BtnCancel_Click" MinWidth="90" Margin="0,0,10,0"
                            Style="{StaticResource AppGhostButton}" Padding="14,9" FontSize="14"/>
                    <Button x:Name="BtnConfirm" Content="确认导入" Click="BtnConfirm_Click" MinWidth="120"
                            Style="{StaticResource AppPrimaryButton}" Padding="14,9" FontSize="14"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
