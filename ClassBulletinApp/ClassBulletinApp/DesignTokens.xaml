<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        班级公布栏 UI 设计 token（P0）。
        目标：把 60 多种硬编码色、17 种字号、11 种 padding 收敛成一套可复用口径。
        主色 4 个键（PrimaryBrush / PrimaryDarkBrush / PrimaryLightBrush / PrimaryBorderBrush）
        仍由 ThemeManager 在 App.xaml 里动态替换，切主题时这里所有引用主色的样式会一起跟着变。
        新 UI 一律引用本文件的 token；旧页面内联样式留到后续分期逐页替换，避免一次性大改。
    -->

    <!-- 中性色：文字 / 描边 / 表面。WCAG AA 对比度见文末说明
         r76 沉稳口径：三支灰统一到同一支冷灰（Hue 215），避免 #1F2A37(偏蓝) / #4B5563(偏绿) /
         #6B7280(偏紫) 混用带来的「脏感」；背景与卡片之差由 3% 拉到 5%，卡片才有厚度。 -->
    <SolidColorBrush x:Key="InkBrush" Color="#1B2836"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#667085"/>
    <SolidColorBrush x:Key="HintBrush" Color="#98A2B3"/>
    <SolidColorBrush x:Key="LineBrush" Color="#E1E6EE"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F4F6FA"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#EDF1F7"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#2E7D4F"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#C0392B"/>

    <!-- r75：补语义色。原来各页内联写 #4B5563 / #D1D5DB / #EEF3FF / #EEF5FF 各写各的，
         同一含义三种深浅，拼在一起就显得「配色不协调」。新页面只用这些键 -->
    <SolidColorBrush x:Key="BodyBrush" Color="#475467"/>          <!-- 正文（比 Ink 浅一档） -->
    <SolidColorBrush x:Key="InputBorderBrush" Color="#C7CFDA"/>   <!-- 输入框 / 次按钮描边 -->
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#E9EFF9"/>   <!-- 主色淡底：提示卡 / 选中行 -->
    <SolidColorBrush x:Key="PrimarySoftBorderBrush" Color="#C2D2E9"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDE8E8"/>    <!-- 危险动作按钮底 -->
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#E0A0A0"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E8F3EC"/>   <!-- 成功 / 正向动作按钮底 -->
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#B7D6C4"/>
    <SolidColorBrush x:Key="BarSurfaceBrush" Color="#F1F4F9"/>    <!-- 工具条 / 分组条的浅底 -->
    <SolidColorBrush x:Key="BarDividerBrush" Color="#E1E6EE"/>    <!-- 条内分隔线 -->

    <!--
        工具条（格式条）共用外观 —— r75 从 Controls/TextStylePicker.xaml 上移到这里。
        为什么上移：通知公告页也有一条同样的工具栏，两份各写一遍必然慢慢跑偏（就是「突兀」的来源）。
        现在全项目只有这一份定义，编辑窗 15 处 + 主窗通知条都用它。
    -->
    <Style x:Key="BarSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BarSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="BarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#374151"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="5" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E8EEF7"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#D7E2F2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BarToggleStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Foreground" Value="#374151"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent"
                            CornerRadius="5" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E8EEF7"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/>
                            <Setter Property="Foreground" Value="#1D4ED8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BarComboStyle" TargetType="ComboBox">
        <Setter Property="Width" Value="70"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- 色板色格：用 Border 不用 Button —— 默认 Button 模板悬停会被系统刷成蓝底，和色块本色打架 -->
    <Style x:Key="BarSwatchStyle" TargetType="Border">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#33000000"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource MutedBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 字号阶梯：12 / 13 / 14 / 16 / 20 / 28，禁用半档 -->
    <sys:Double x:Key="FsCaption">12</sys:Double>
    <sys:Double x:Key="FsSmall">13</sys:Double>
    <sys:Double x:Key="FsBody">14</sys:Double>
    <sys:Double x:Key="FsSection">16</sys:Double>
    <sys:Double x:Key="FsPage">20</sys:Double>
    <sys:Double x:Key="FsDisplay">28</sys:Double>

    <!-- 4pt 基准间距 -->
    <sys:Double x:Key="Sp1">4</sys:Double>
    <sys:Double x:Key="Sp2">8</sys:Double>
    <sys:Double x:Key="Sp3">12</sys:Double>
    <sys:Double x:Key="Sp4">16</sys:Double>
    <sys:Double x:Key="Sp6">24</sys:Double>
    <sys:Double x:Key="Sp8">32</sys:Double>

    <!-- 圆角：控件 8 / 卡片 12 / 弹窗 16 -->
    <CornerRadius x:Key="CrControl">8</CornerRadius>
    <CornerRadius x:Key="CrCard">12</CornerRadius>
    <CornerRadius x:Key="CrDialog">16</CornerRadius>

    <!-- 文本层级 -->
    <Style x:Key="TextPageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FsPage}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    </Style>
    <Style x:Key="TextSection" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FsSection}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    </Style>
    <Style x:Key="TextBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FsBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="TextHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FsCaption}"/>
        <Setter Property="Foreground" Value="{DynamicResource HintBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 卡片容器 -->
    <Style x:Key="AppCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CrCard}"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- 主按钮：主色底 + 白字（#1E4FA8 白字对比度 7.0:1） -->
    <Style x:Key="AppPrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="{DynamicResource FsBody}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource PrimaryBrush}"
                            CornerRadius="{DynamicResource CrControl}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 次按钮：描边 + 主色文字 -->
    <Style x:Key="AppGhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource FsSmall}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource CrControl}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        危险动作按钮（r79）：与 AppGhostButton 同构，只把底色/描边/文字换成危险色。
        为什么要单独一份：AppGhostButton 的模板里 Background 写死 DynamicResource CardBrush，
        外挂 Background="..." 是无效的（模板不读 TemplateBinding），
        所以「清除本周调课」「一键清除全部导入数据」这类必须有自己的模板。
    -->
    <Style x:Key="AppDangerButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource FsSmall}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource DangerSoftBrush}"
                            BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource CrControl}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        成功 / 接收类动作（导入数据包、导入临时课表）：绿色语义底。
        原来这些地方直接写 #E8F6EE + #7FC99A，两页各写一遍、深浅还不一样。
    -->
    <Style x:Key="AppSuccessButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource FsSmall}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource SuccessSoftBrush}"
                            BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource CrControl}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主色淡底按钮：需要强调但不是「页面唯一主操作」时用（如工具栏里的发布信息） -->
    <Style x:Key="AppPrimarySoftButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDarkBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource FsSmall}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource PrimaryLightBrush}"
                            BorderBrush="{DynamicResource PrimaryBorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource CrControl}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 左侧一级导航按钮：选中态由代码设置 Background，故模板只用 TemplateBinding -->
    <Style x:Key="AppNavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource FsBody}"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource CrControl}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 二级导航（分段条）按钮 -->
    <Style x:Key="AppSubNavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource FsSmall}"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource CrControl}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        无头 TabControl：只渲染 SelectedContent，Tab 头由左侧导航接管。
        关键：TabItem 的顺序、索引、x:Name 全部保持不变，
        SelectedIndex / SelectionChanged / 诊断截图目标因此零回归。
    -->
    <Style x:Key="HeadlessTabs" TargetType="TabControl">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <ContentPresenter ContentSource="SelectedContent" Margin="{TemplateBinding Padding}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ===== P3 悬浮窗共用外观 =====
        六个悬浮窗的标题栏原本是 6 份手写拷贝。这里只收敛「结构类」属性（圆角 / 内距 / 字号 /
        按钮描边），各窗口的主题色仍由自己的 ApplyTheme() 直接赋值（本地值优先于 Style Setter）。
        ★ 用法边界：只给现有元素加 Style 引用，x:Name / Click / Grid.Row / DragLayer 一行都不动。
          ScheduleWindow 的 HeaderBar 是 FloatChrome.EnableDrag 的拖动注册区，
          也是 SetClickThrough 的交互白名单来源，绝对不能换成 UserControl。
    -->
    <Style x:Key="FloatHeader" TargetType="Border">
        <Setter Property="CornerRadius" Value="11,11,0,0"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style x:Key="FloatTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="FloatCloseButton" TargetType="Button">
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="Background" Value="#33FFFFFF"/>
        <Setter Property="BorderBrush" Value="#55FFFFFF"/>
    </Style>
    <Style x:Key="FloatScheduleHeader" TargetType="Border">
        <Setter Property="CornerRadius" Value="14,14,0,0"/>
        <Setter Property="Padding" Value="14,9"/>
    </Style>
    <Style x:Key="FloatScheduleButton" TargetType="Button">
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="#33FFFFFF"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#66FFFFFF"/>
    </Style>

    <!--
        ===== P5 悬浮便签共用底栏 =====
        作业 / 缺交 / 倒计时 / 值日 / 自定义便签 的底栏原本是 5 份完全相同的拷贝
        （Padding 10,6 + BorderThickness 0,1,0,0 + BorderBrush #22000000 + Background #12000000），
        按钮也统一是 Padding 8,3 / FontSize 11。这里只收敛这两层「结构类」属性。
        ★ 边界：按钮各自的 Margin / Content / ToolTip / Click / x:Name 全部保持原样 ——
          DockPanel 左右停靠方向不同，Margin 不能进 Style；TxtHint 的前景色由各窗
          ApplyTheme() 逐窗赋值，也不进 Style。
     -->
    <Style x:Key="FloatFooter" TargetType="Border">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="BorderBrush" Value="#22000000"/>
        <Setter Property="Background" Value="#12000000"/>
    </Style>
    <Style x:Key="FloatFooterButton" TargetType="Button">
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <!--
        ===== P4 提醒设置三组卡片（上课 / 下课 / 放学，3 × 5 个同构输入框）=====
        只把重复属性收成 Style，x:Name / TextChanged / Click / 文案 / Margin 全部保持原样，
        所以 ReloadReminderUi / SaveReminderUi 的逐条赋值与「立即保存」机制零回归。
        卡片底色用 DynamicResource 主色键，切主题时跟随 ThemeManager。
    -->
    <Style x:Key="ReminderCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style x:Key="ReminderSwitch" TargetType="CheckBox">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    </Style>
    <Style x:Key="ReminderLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Width" Value="92"/>
    </Style>
    <Style x:Key="ReminderInput" TargetType="TextBox">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Width" Value="500"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#D1D5DB"/>
    </Style>
    <Style x:Key="ReminderLeadInput" TargetType="TextBox">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Width" Value="56"/>
        <Setter Property="Margin" Value="6,0"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <!--
        ===== 问号说明气泡（r70）=====
        常显的操作说明 / 注意事项统一收成 18px 圆标，外层留 34×34 命中区给触屏用。
        颜色全部走主色 token，切主题时跟随 ThemeManager；弹层卡片沿用 CardBrush / CrCard。
        ★ 视觉尺寸 18px、命中区 34px 是刻意的：一体机上小图标要点得中，
          但又不能像一颗按钮那样把整行排版撑开。
    -->
    <Style x:Key="HelpButton" TargetType="Button">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Width="34" Height="34" Background="Transparent">
                        <Border x:Name="Circle" Width="18" Height="18" CornerRadius="9"
                                Background="{DynamicResource PrimaryLightBrush}"
                                BorderBrush="{DynamicResource PrimaryBorderBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="?" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryDarkBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Circle" Property="Background" Value="{DynamicResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Circle" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HelpPopupCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CrCard}"/>
        <Setter Property="Padding" Value="14"/>
    </Style>

    <!--
        对比度（白底）：#1B2836 = 15.2:1，#475467 = 8.1:1，#667085 = 5.4:1，#98A2B3 = 2.9:1（仅提示文字，不承载正文），均满足 WCAG AA。
        状态一律配文字标签，不靠颜色单独传达。
        触控热区最小 44px，视觉尺寸可小于热区但 Padding 要补足。
    -->
</ResourceDictionary>
