<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--
        班级公布栏 UI 设计 token（P0）。
        目标：把 60 多种硬编码色、17 种字号、11 种 padding 收敛成一套可复用口径。
        主色 4 个键（PrimaryBrush / PrimaryDarkBrush / PrimaryLightBrush / PrimaryBorderBrush）
        仍由 ThemeManager 在 App.xaml 里动态替换，切主题时这里所有引用主色的样式会一起跟着变。
        新 UI 一律引用本文件的 token；旧页面内联样式留到后续分期逐页替换，避免一次性大改。
    -->

    <!-- 中性色：文字 / 描边 / 表面。WCAG AA 对比度见文末说明
         r76 沉稳口径：三支灰统一到同一支冷灰（Hue 215），避免 #1F2A37(偏蓝) / #4B5563(偏绿) /
         #6B7280(偏紫) 混用带来的「脏感」；背景与卡片之差由 3% 拉到 5%，卡片才有厚度。 -->
    <SolidColorBrush x:Key="InkBrush" Color="#1B2836"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#667085"/>
    <SolidColorBrush x:Key="HintBrush" Color="#98A2B3"/>
    <SolidColorBrush x:Key="LineBrush" Color="#E1E6EE"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F4F6FA"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#EDF1F7"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#2E7D4F"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#B45309"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#C0392B"/>

    <!-- r75：补语义色。原来各页内联写 #4B5563 / #D1D5DB / #EEF3FF / #EEF5FF 各写各的，
         同一含义三种深浅，拼在一起就显得「配色不协调」。新页面只用这些键 -->
    <SolidColorBrush x:Key="BodyBrush" Color="#475467"/>          <!-- 正文（比 Ink 浅一档） -->
    <SolidColorBrush x:Key="InputBorderBrush" Color="#C7CFDA"/>   <!-- 输入框 / 次按钮描边 -->
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#E9EFF9"/>   <!-- 主色淡底：提示卡 / 选中行 -->
    <SolidColorBrush x:Key="PrimarySoftBorderBrush" Color="#C2D2E9"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDE8E8"/>    <!-- 危险动作按钮底 -->
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#E0A0A0"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E8F3EC"/>   <!-- 成功 / 正向动作按钮底 -->
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#B7D6C4"/>
    <SolidColorBrush x:Key="BarSurfaceBrush" Color="#F1F4F9"/>    <!-- 工具条 / 分组条的浅底 -->
    <SolidColorBrush x:Key="BarDividerBrush" Color="#E1E6EE"/>    <!-- 条内分隔线 -->
    <!-- r166：提示条（琥珀）。原来信息管理页把 #FFF4E5 / #E8B874 / #8A5A00 / #9A6B22
         四个值直接写在 XAML 里，别处想用同一套颜色只能再抄一遍 -->
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#FFF6E5"/>
    <SolidColorBrush x:Key="WarnBorderBrush" Color="#F0DCB0"/>
    <SolidColorBrush x:Key="WarnTextBrush" Color="#8A5A00"/>
    <SolidColorBrush x:Key="WarnSubTextBrush" Color="#9A6B22"/>

    <!--
        工具条（格式条）共用外观 —— r75 从 Controls/TextStylePicker.xaml 上移到这里。
        为什么上移：通知公告页也有一条同样的工具栏，两份各写一遍必然慢慢跑偏（就是「突兀」的来源）。
        现在全项目只有这一份定义，编辑窗 15 处 + 主窗通知条都用它。
    -->
    <Style x:Key="BarSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BarSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="BarButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#374151"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="5" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E8EEF7"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#D7E2F2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BarToggleStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Foreground" Value="#374151"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent"
                            CornerRadius="5" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E8EEF7"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/>
                            <Setter Property="Foreground" Value="#1D4ED8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BarComboStyle" TargetType="ComboBox">
        <Setter Property="Width" Value="70"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- 色板色格：用 Border 不用 Button —— 默认 Button 模板悬停会被系统刷成蓝底，和色块本色打架 -->
    <Style x:Key="BarSwatchStyle" TargetType="Border">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#33000000"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource MutedBrush}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 字号阶梯：12 / 13 / 14 / 16 / 20 / 28，禁用半档 -->
    <sys:Double x:Key="FsCaption">12</sys:Double>
    <sys:Double x:Key="FsSmall">13</sys:Double>
    <sys:Double x:Key="FsBody">14</sys:Double>
    <sys:Double x:Key="FsSection">16</sys:Double>
    <sys:Double x:Key="FsPage">20</sys:Double>
    <sys:Double x:Key="FsDisplay">28</sys:Double>

    <!-- 4pt 基准间距 -->
    <sys:Double x:Key="Sp1">4</sys:Double>
    <sys:Double x:Key="Sp2">8</sys:Double>
    <sys:Double x:Key="Sp3">12</sys:Double>
    <sys:Double x:Key="Sp4">16</sys:Double>
    <sys:Double x:Key="Sp6">24</sys:Double>
    <sys:Double x:Key="Sp8">32</sys:Double>

    <!-- 圆角：控件 8 / 卡片 12 / 弹窗 16 -->
    <CornerRadius x:Key="CrControl">8</CornerRadius>
    <CornerRadius x:Key="CrCard">12</CornerRadius>
    <CornerRadius x:Key="CrDialog">16</CornerRadius>

    <!-- 文本层级 -->
    <Style x:Key="TextPageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FsPage}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    </Style>
    <Style x:Key="TextSection" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FsSection}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    </Style>
    <Style x:Key="TextBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FsBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="TextHint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FsCaption}"/>
        <Setter Property="Foreground" Value="{DynamicResource HintBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 卡片容器 -->
    <Style x:Key="AppCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CrCard}"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <!-- 主按钮：主色底 + 白字（#1E4FA8 白字对比度 7.0:1） -->
    <Style x:Key="AppPrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="{DynamicResource FsBody}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource PrimaryBrush}"
                            CornerRadius="{DynamicResource CrControl}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 次按钮：描边 + 主色文字 -->
    <!--
        浅底 + 主色描边的次级按钮（r169）。
        ★ 由来：「课表悬浮：开 / 关」原来靠内联 Background/BorderBrush 撑出浅蓝底，
          可旁边「布局设置 / 启动选项 / 任务栏菜单 / 黑板管理」用的是没设模板的 TabBtn，
          走系统默认灰方块 —— 五个按钮并排，一看就是两套东西。
        ★ 现在颜色收进样式：开关按钮只管改文字（代码只动 Content），内联颜色全部删掉，
          以后再往这一排加按钮，套 AppSoftButton 就自动一致。
    -->
    <Style x:Key="AppSoftButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDarkBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource FsSmall}"/>
        <Setter Property="Padding" Value="13,7"/>
        <Setter Property="MinWidth" Value="118"/>
        <Setter Property="Margin" Value="0,0,10,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource PrimaryLightBrush}"
                            BorderBrush="{DynamicResource PrimaryBorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource CrControl}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppGhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource FsSmall}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource CrControl}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        文字链接按钮（r130）：纯文字 + 下划线，用来挂在主按钮后面当辅助入口（如「下载模板」）。
        ★ 为什么不用 AppGhostButton：描边按钮和主按钮并排会平分注意力，
          而「下载模板」只是「智能导入」的前置小工具，做成人人都认识的文字链接才不会被误读成独立功能。
        ★ Padding 给 6,10：文字只有 13px，但命中区要够手指点；VisualTree 里仍是一个 Button，权限 Set 照常可用。
    -->
    <Style x:Key="AppLinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource FsSmall}"/>
        <Setter Property="Padding" Value="6,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <TextBlock x:Name="Tx" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   TextDecorations="Underline" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource PrimaryDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        危险动作按钮（r79）：与 AppGhostButton 同构，只把底色/描边/文字换成危险色。
        为什么要单独一份：AppGhostButton 的模板里 Background 写死 DynamicResource CardBrush，
        外挂 Background="..." 是无效的（模板不读 TemplateBinding），
        所以「清除本周调课」「一键清除全部导入数据」这类必须有自己的模板。
    -->
    <Style x:Key="AppDangerButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource FsSmall}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource DangerSoftBrush}"
                            BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource CrControl}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        成功 / 接收类动作（导入数据包、导入临时课表）：绿色语义底。
        原来这些地方直接写 #E8F6EE + #7FC99A，两页各写一遍、深浅还不一样。
    -->
    <Style x:Key="AppSuccessButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource FsSmall}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource SuccessSoftBrush}"
                            BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource CrControl}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主色淡底按钮：需要强调但不是「页面唯一主操作」时用（如工具栏里的发布信息） -->
    <Style x:Key="AppPrimarySoftButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryDarkBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource FsSmall}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource PrimaryLightBrush}"
                            BorderBrush="{DynamicResource PrimaryBorderBrush}" BorderThickness="1"
                            CornerRadius="{DynamicResource CrControl}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 左侧一级导航按钮：选中态由代码设置 Background，故模板只用 TemplateBinding -->
    <Style x:Key="AppNavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource FsBody}"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource CrControl}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        二级导航（分段条）—— r167 重做。
        原来这一排是「通栏白底 + 几个透明按钮」，组内哪一项对应当前页谁都没标，
        在「设置」组里点「用户中心」之后，条上六项长得一模一样，得回头看内容才知道自己在哪。
        现在：底板一块（SegBar）、当前页一块白（本地值 Background=White），其余透明。
        ★ 悬浮态必须写在 Style.Triggers 里，不能写进 ControlTemplate.Triggers：
          依赖属性优先级是「本地值 > Style 触发器 > Style Setter > 模板触发器」，
          放进模板触发器会把代码设的白色也一起盖掉 —— 选中项一悬浮就变回灰底。
        ★ BorderThickness 恒为 1、未选中 BorderBrush 透明：不是装饰，
          是为了选中时只换颜色不换尺寸，否则白块出现的一瞬间文字会横跳 1px。
    -->
    <Style x:Key="SegBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BarSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SegDivider" TargetType="Border">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="15"/>
        <Setter Property="Background" Value="{DynamicResource LineBrush}"/>
        <Setter Property="Margin" Value="5,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="AppSubNavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="FontSize" Value="{DynamicResource FsSmall}"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- 圆角 7 = 底板 9 减去内边距 2，白块看上去才像嵌在槽里 -->
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="7" SnapsToDevicePixels="True"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
            </Trigger>
            <!-- 动作项（发布信息 / 帮助）点了不常驻，靠这层淡描边提示「可以点，但不是页面」 -->
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        无头 TabControl：只渲染 SelectedContent，Tab 头由左侧导航接管。
        关键：TabItem 的顺序、索引、x:Name 全部保持不变，
        SelectedIndex / SelectionChanged / 诊断截图目标因此零回归。
    -->
    <Style x:Key="HeadlessTabs" TargetType="TabControl">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <ContentPresenter ContentSource="SelectedContent" Margin="{TemplateBinding Padding}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ===== P3 悬浮窗共用外观 =====
        六个悬浮窗的标题栏原本是 6 份手写拷贝。这里只收敛「结构类」属性（圆角 / 内距 / 字号 /
        按钮描边），各窗口的主题色仍由自己的 ApplyTheme() 直接赋值（本地值优先于 Style Setter）。
        ★ 用法边界：只给现有元素加 Style 引用，x:Name / Click / Grid.Row / DragLayer 一行都不动。
          ScheduleWindow 的 HeaderBar 是 FloatChrome.EnableDrag 的拖动注册区，
          也是 SetClickThrough 的交互白名单来源，绝对不能换成 UserControl。
    -->
    <Style x:Key="FloatHeader" TargetType="Border">
        <Setter Property="CornerRadius" Value="11,11,0,0"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style x:Key="FloatTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="FloatCloseButton" TargetType="Button">
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="8,0,0,0"/>
        <Setter Property="Background" Value="#33FFFFFF"/>
        <Setter Property="BorderBrush" Value="#55FFFFFF"/>
    </Style>
    <Style x:Key="FloatScheduleHeader" TargetType="Border">
        <Setter Property="CornerRadius" Value="14,14,0,0"/>
        <Setter Property="Padding" Value="14,9"/>
    </Style>
    <Style x:Key="FloatScheduleButton" TargetType="Button">
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="#33FFFFFF"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#66FFFFFF"/>
    </Style>

    <!--
        ===== P5 悬浮便签共用底栏 =====
        作业 / 缺交 / 倒计时 / 值日 / 自定义便签 的底栏原本是 5 份完全相同的拷贝
        （Padding 10,6 + BorderThickness 0,1,0,0 + BorderBrush #22000000 + Background #12000000），
        按钮也统一是 Padding 8,3 / FontSize 11。这里只收敛这两层「结构类」属性。
        ★ 边界：按钮各自的 Margin / Content / ToolTip / Click / x:Name 全部保持原样 ——
          DockPanel 左右停靠方向不同，Margin 不能进 Style；TxtHint 的前景色由各窗
          ApplyTheme() 逐窗赋值，也不进 Style。
     -->
    <Style x:Key="FloatFooter" TargetType="Border">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="BorderBrush" Value="#22000000"/>
        <Setter Property="Background" Value="#12000000"/>
    </Style>
    <Style x:Key="FloatFooterButton" TargetType="Button">
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <!--
        ===== P4 提醒设置三组卡片（上课 / 下课 / 放学，3 × 5 个同构输入框）=====
        只把重复属性收成 Style，x:Name / TextChanged / Click / 文案 / Margin 全部保持原样，
        所以 ReloadReminderUi / SaveReminderUi 的逐条赋值与「立即保存」机制零回归。
        卡片底色用 DynamicResource 主色键，切主题时跟随 ThemeManager。
    -->
    <Style x:Key="ReminderCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style x:Key="ReminderSwitch" TargetType="CheckBox">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    </Style>
    <Style x:Key="ReminderLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Width" Value="92"/>
    </Style>
    <Style x:Key="ReminderInput" TargetType="TextBox">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Width" Value="500"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#D1D5DB"/>
    </Style>
    <Style x:Key="ReminderLeadInput" TargetType="TextBox">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Width" Value="56"/>
        <Setter Property="Margin" Value="6,0"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <!--
        ===== 问号说明气泡（r70）=====
        常显的操作说明 / 注意事项统一收成 18px 圆标，外层留 34×34 命中区给触屏用。
        颜色全部走主色 token，切主题时跟随 ThemeManager；弹层卡片沿用 CardBrush / CrCard。
        ★ 视觉尺寸 18px、命中区 34px 是刻意的：一体机上小图标要点得中，
          但又不能像一颗按钮那样把整行排版撑开。
    -->
    <Style x:Key="HelpButton" TargetType="Button">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Width="34" Height="34" Background="Transparent">
                        <Border x:Name="Circle" Width="18" Height="18" CornerRadius="9"
                                Background="{DynamicResource PrimaryLightBrush}"
                                BorderBrush="{DynamicResource PrimaryBorderBrush}"
                                BorderThickness="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="?" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryDarkBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Circle" Property="Background" Value="{DynamicResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Circle" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HelpPopupCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CrCard}"/>
        <Setter Property="Padding" Value="14"/>
    </Style>

    <!--
        ===== P6 主窗口四页视觉收敛（r166）=====

        背景：主窗口今日 / 信息管理 / 显示设置 / 黑板发送窗四页各写各的字号、圆角、按钮颜色，
        同一屏里 14 / 15 / 16 / 13 / 12.5 / 11.5 混用，四类发布按钮还是蓝 / 红 / 绿 / 紫各一色。
        这一组键只做「收敛」：把重复出现的组合收成有语义的名字，页面里改成引用。

        ★ 边界（很重要）：
          1. 只新增键，不改动上面任何既有键的取值 —— 悬浮课表窗（ScheduleWindow）等
             已经不打算再动，改旧键会连带把它们的观感改掉。
          2. 不设隐式样式（没有 x:Key 的 Style），否则会打到 WeekView、各编辑窗、
             台账窗等没参与本轮收敛的界面。
          3. 所有 Height 只写在本组键里，页面就地引用；不往 AppGhostButton 里加，
             否则编辑窗那排紧凑按钮会集体长高 2px。
    -->

    <!-- 卡片小标签（「需要你处理」「今天怎么上」）：12 号灰字，只作分类用，不抢主文 -->
    <Style x:Key="CardLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FsCaption}"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 卡片主文（「没有待办」「最近检查失败」）：20 号，全页最大的字就这一档 -->
    <Style x:Key="CardHeadline" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FsPage}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 卡片说明：12 号正文色，行高 19（原来 12.5 是半档，已废弃） -->
    <Style x:Key="CardDesc" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FsCaption}"/>
        <Setter Property="Foreground" Value="{DynamicResource BodyBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="19"/>
    </Style>

    <!-- 状态胶囊：高 20、圆角 10（正好半高）、左右留 8。底色与文字色由各处指定，
         因为同一种「正常」在今日页是绿色、在信息管理页是灰色，语义色不在这里写死 -->
    <Style x:Key="StatusPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
    </Style>
    <Style x:Key="StatusPillText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FsCaption}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 区块标题（「发布哪一类信息」「界面主题」）：16 号，取代原来的 15 Bold + ①②③ 圈号 -->
    <Style x:Key="BlockTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FsSection}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 区块说明（跟在标题右边那一句）：12 号提示色，不换行时也只占一行 -->
    <Style x:Key="BlockDesc" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FsCaption}"/>
        <Setter Property="Foreground" Value="{DynamicResource HintBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 设置页复选框：标签 13 号 + 说明 12 号灰字分两行，替掉原来「一句话塞两件事」的长 Content -->
    <Style x:Key="OptLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FsSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="OptDesc" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FsCaption}"/>
        <Setter Property="Foreground" Value="{DynamicResource HintBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <!-- 白卡（信息管理 / 显示设置的分组）：12 圆角 + 1px 线，和今日四卡同一套 -->
    <Style x:Key="GroupCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CrCard}"/>
        <Setter Property="Padding" Value="16,14"/>
    </Style>

    <!-- 表单行标签：右对齐到固定宽度，输入框左边缘才能齐成一条竖线 -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FsSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource BodyBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Right"/>
    </Style>

    <!-- 输入框 / 下拉：高 32、圆角 8、1px 输入描边。ComboBox 只给 MinHeight，
         因为默认模板的内部内容不跟 Height 居中，硬拉会偏 -->
    <Style x:Key="AppInput" TargetType="TextBox">
        <Setter Property="Height" Value="32"/>
        <Setter Property="FontSize" Value="{DynamicResource FsSmall}"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    </Style>
    <!--
        下拉项（r167）：白弹层里的一行。原来沿用系统高亮蓝，和主色 #1E4FA3 不是同一个蓝，
        在黑板发送窗那种一屏五个下拉的地方特别显眼。现在选中 / 悬浮都用主色淡底。
    -->
    <Style x:Key="AppComboItem" TargetType="ComboBoxItem">
        <Setter Property="FontSize" Value="{DynamicResource FsSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource BodyBrush}"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                          ClipToBounds="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryDarkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource HintBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        统一下拉框（r167 由「只设字号」升级为完整模板）。
        为什么要自己写模板：默认模板是系统灰底直角，黑板发送窗一块白卡上嵌四个，
        和旁边已圆角的输入框明显不是一套。
        ★ 唯一必须守住的：可编辑下拉（IsEditable=true，老师要能手打名单外的班级名）
          依赖名叫 PART_EditableTextBox 的 TextBox 部件，ComboBox 内部按名字找它。
          名字写错或漏掉 → 下拉能拉开、但点不进去也打不了字，是最容易踩的坑。
        ★ 层级顺序：底色 → 整个 ToggleButton（含右侧三角）→ 只读文本 → 可编辑 TextBox。
          ToggleButton 必须垫在文本下面：只读时文本层 IsHitTestVisible=False，点击直接落到
          ToggleButton 上（点哪都开）；可编辑时 TextBox 在上面接住打字，右侧 28px 的
          Margin 空档留给箭头，点那里照样展开。
    -->
    <Style x:Key="AppCombo" TargetType="ComboBox">
        <Setter Property="FontSize" Value="{DynamicResource FsSmall}"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Padding" Value="10,0,28,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MaxDropDownHeight" Value="260"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource AppComboItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CrControl}" SnapsToDevicePixels="True"/>

                        <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                                      Background="Transparent" BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent">
                                        <Path x:Name="Arrow" Data="M0,0 L4.5,5 L9,0 Z"
                                              Fill="{DynamicResource MutedBrush}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,11,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource InkBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          ClipToBounds="True"/>

                        <!-- 名字不能改：ComboBox 内部按 PART_EditableTextBox 找它 -->
                        <TextBox x:Name="PART_EditableTextBox" Visibility="Collapsed"
                                 Margin="{TemplateBinding Padding}" Padding="0"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{TemplateBinding Foreground}"
                                 FontSize="{TemplateBinding FontSize}"
                                 VerticalContentAlignment="Center"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"/>

                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                    CornerRadius="{DynamicResource CrControl}" Padding="4"
                                    Margin="0,3,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{Binding MaxDropDownHeight, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.14" Color="#101828"/>
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" SnapsToDevicePixels="True">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BarSurfaceBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource HintBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        对比度（白底）：#1B2836 = 15.2:1，#475467 = 8.1:1，#667085 = 5.4:1，#98A2B3 = 2.9:1（仅提示文字，不承载正文），均满足 WCAG AA。
        状态一律配文字标签，不靠颜色单独传达。
        触控热区最小 44px，视觉尺寸可小于热区但 Padding 要补足。
    -->
</ResourceDictionary>
