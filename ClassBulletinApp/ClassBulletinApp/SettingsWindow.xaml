<Window x:Class="ClassBulletinApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="360" Width="470"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock Text="启动选项" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,16"/>

        <CheckBox x:Name="ChkFullscreen" Content="启动时直接进入全屏展示" FontSize="15" Margin="0,0,0,12"/>
        <CheckBox x:Name="ChkLocked" Content="启动即进入防误触锁定（按 Ctrl+L 解锁）" FontSize="15" Margin="0,0,0,12"/>
        <CheckBox x:Name="ChkHidePanel" Content="登录后直接显示悬浮窗，不打开控制面板" FontSize="15" Margin="0,0,0,4"/>
        <TextBlock Text="要打开控制面板时：双击任务栏托盘图标，或右键托盘图标选「打开控制面板」。"
                   FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                   Margin="22,0,0,20"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancel" Content="取消" Padding="16,8" FontSize="14" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave" Content="保存" Padding="16,8" FontSize="14" Click="BtnSave_Click" Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderBrush="{DynamicResource PrimaryBrush}"/>
        </StackPanel>

        <TextBlock x:Name="TxtVersion" HorizontalAlignment="Left" FontSize="12" Foreground="{DynamicResource HintBrush}" Margin="0,16,0,0"/>
    </StackPanel>
</Window>
