<Window x:Class="ClassBulletinApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Height="360" Width="470"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock Text="启动选项" FontSize="20" FontWeight="Bold" Foreground="#1F2A37" Margin="0,0,0,16"/>

        <CheckBox x:Name="ChkFullscreen" Content="启动时直接进入全屏展示" FontSize="15" Margin="0,0,0,12"/>
        <CheckBox x:Name="ChkLocked" Content="启动即进入防误触锁定（按 Ctrl+L 解锁）" FontSize="15" Margin="0,0,0,24"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancel" Content="取消" Padding="16,8" FontSize="14" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave" Content="保存" Padding="16,8" FontSize="14" Click="BtnSave_Click" Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderBrush="{DynamicResource PrimaryBrush}"/>
        </StackPanel>

        <TextBlock x:Name="TxtVersion" HorizontalAlignment="Left" FontSize="12" Foreground="#9CA3AF" Margin="0,16,0,0"/>
    </StackPanel>
</Window>
