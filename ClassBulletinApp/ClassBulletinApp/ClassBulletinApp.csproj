<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ClassBulletinApp</AssemblyName>
    <RootNamespace>ClassBulletinApp</RootNamespace>

    <!-- 版本信息：发版时只需改这里 -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>东凤中学</Company>
    <Product>班级公布栏</Product>
    <Title>班级公布栏</Title>
    <Description>教室多媒体屏班级公布栏：当日课表、通知公告、作业公示与自定义便签</Description>
    <Copyright>Copyright (c) 2026 东凤中学</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ScheduleCore\ScheduleCore.csproj" />
  </ItemGroup>
</Project>
