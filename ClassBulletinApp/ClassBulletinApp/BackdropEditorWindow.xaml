<Window x:Class="ClassBulletinApp.BackdropEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面背景便签排版（所见即所得）" Height="820" Width="1200"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#F2F5FA" FontFamily="Microsoft YaHei UI">
    <Grid Background="#F2F5FA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="272"/>
        </Grid.ColumnDefinitions>

        <!-- 预览区：模拟整块屏幕，便签可直接拖动 / 拉边 -->
        <Border Grid.Column="0" x:Name="PreviewHost" Background="#1F2733" Margin="12" CornerRadius="10">
            <Canvas x:Name="PreviewCanvas" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
        </Border>

        <!-- 侧栏 -->
        <Grid Grid.Column="1" Margin="0,12,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="所见即所得排版" FontSize="18" FontWeight="Bold" Foreground="#1F2A37"/>
                <TextBlock Text="· 直接拖动便签：调整位置&#10;· 拖动便签四角 / 四边：改变大小&#10;· 选中便签后可在右侧勾选「固定大小」"
                           FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,6,0,8" LineHeight="20"/>
                <TextBlock x:Name="TxtSel" FontSize="13" Foreground="#2D6CDF" TextWrapping="Wrap" MinHeight="20"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="CardList"/>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <Button x:Name="BtnApply" Content="应用并关闭" Padding="14,10" FontSize="15"
                        Background="#2D6CDF" Foreground="White" BorderBrush="#2D6CDF" Click="BtnApply_Click"/>
                <Button x:Name="BtnCancel" Content="取消" Padding="14,10" FontSize="14" Margin="0,8,0,0" Click="BtnCancel_Click"/>
                <TextBlock Text="未「应用到桌面背景」前，本窗口只调整布局不改变当前壁纸；若壁纸已应用，关闭时会按新布局自动重绘。"
                           FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
