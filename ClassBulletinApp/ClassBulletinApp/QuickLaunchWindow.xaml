<Window x:Class="ClassBulletinApp.QuickLaunchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:ClassBulletinApp.Controls"
        xmlns:local="clr-namespace:ClassBulletinApp"
        Title="应用快捷方式" Height="640" Width="560" MinHeight="520" MinWidth="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BarSurfaceBrush}">
    <Window.Resources>
        <local:QlIconConverter x:Key="QlIcon"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="应用快捷方式" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
            <ctl:HelpBubble PopupTitle="快捷方式" Text="在悬浮课表底部添加常用软件 / 文件夹，点击即可打开。可设置「仅显示图标」并调整图标大小，节省空间。" Margin="0,0,0,8"/>

            <TextBlock Text="预览（与悬浮课表底部一致）" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,6"/>
            <Border Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
                <StackPanel>
                    <WrapPanel x:Name="PreviewWrap" Orientation="Horizontal"/>
                    <TextBlock x:Name="TxtPreviewEmpty" Text="（还没有添加任何快捷方式）" FontSize="12" Foreground="{DynamicResource HintBrush}"/>
                </StackPanel>
            </Border>

            <CheckBox x:Name="ChkIconOnly" Content="仅显示图标（不显示文字，更节省空间）" FontSize="14" Margin="0,14,0,6"
                      Click="ChkIconOnly_Click"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="图标大小" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Slider x:Name="SlIconSize" Minimum="16" Maximum="48" TickFrequency="2" IsSnapToTickEnabled="True"
                        Width="240" VerticalAlignment="Center" ValueChanged="SlIconSize_ValueChanged"/>
                <TextBlock x:Name="TxtIconSize" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <!-- 内置快捷（作业 / 缺交 / 便签 / 倒计时 / 值日 / 设置）：六个是一整排，共用同一个大小 -->
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10"
                    Padding="12,9" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="内置快捷（九个直达入口）"
                                   FontSize="14" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtBuiltinSize" DockPanel.Dock="Right" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </DockPanel>

                    <Slider x:Name="SlBuiltinSize" Minimum="9" Maximum="22" TickFrequency="0.5"
                            IsSnapToTickEnabled="True" Margin="0,8,0,0"
                            ValueChanged="SlBuiltinSize_ValueChanged"
                            ToolTip="拖动调整六个快捷按钮的大小（字号 9~22）。勾选下面的「自动」则跟随悬浮课表宽度。"/>

                    <CheckBox x:Name="ChkBuiltinAuto" Content="自动：跟随悬浮课表宽度（推荐）" FontSize="13.5"
                              Foreground="{DynamicResource InkBrush}" Margin="0,6,0,0" Click="ChkBuiltinAuto_Click"
                              ToolTip="窗口窄时自动收小，六个不会挤成两行；拉宽后自动放大"/>

                    <TextBlock x:Name="TxtBuiltinHint" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                               Margin="0,6,0,8"/>

                    <WrapPanel x:Name="BuiltinPreview" Orientation="Horizontal"/>

                    <ctl:HelpBubble PopupTitle="内置快捷" Text="显示哪几个（取消勾选即在悬浮课表底部隐藏；当前账号没有权限的入口不可选）" Margin="0,0,0,8"/>
                    <WrapPanel x:Name="BuiltinToggleWrap" Orientation="Horizontal"/>
                </StackPanel>
            </Border>

            <WrapPanel Margin="0,10,0,0">
                <Button x:Name="BtnAddProgram" Content="＋ 添加程序" Padding="12,7" FontSize="14" Margin="0,0,10,0"
                        Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}" Click="BtnAddProgram_Click"/>
                <Button x:Name="BtnAddFolder" Content="＋ 添加文件夹" Padding="12,7" FontSize="14"
                        Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}" Click="BtnAddFolder_Click"/>
            </WrapPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Margin="0,12,0,0">
            <ScrollViewer Margin="10" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ListPanel"/>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,12,0,0">
            <ctl:HelpBubble PopupTitle="保存说明" Text="提示：确定后保存到悬浮课表底部的应用栏。" Margin="0,0,0,8"/>
            <Button x:Name="BtnOk" DockPanel.Dock="Right" Content="确定" Padding="20,7" FontSize="14" Margin="10,0,0,0"
                    Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderBrush="{DynamicResource PrimaryBrush}" IsDefault="True" Click="BtnOk_Click"/>
            <Button x:Name="BtnCancel" DockPanel.Dock="Right" Content="取消" Padding="20,7" FontSize="14"
                    Background="White" BorderBrush="{DynamicResource InputBorderBrush}" IsCancel="True" Click="BtnCancel_Click"/>
        </DockPanel>
    </Grid>
</Window>
