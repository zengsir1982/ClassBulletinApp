<Window x:Class="ClassBulletinApp.QuickLaunchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClassBulletinApp"
        Title="应用快捷方式" Height="560" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#F2F5FA">
    <Window.Resources>
        <local:QlIconConverter x:Key="QlIcon"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="应用快捷方式" FontSize="20" FontWeight="Bold" Foreground="#1F2A37"/>
            <TextBlock Text="在悬浮课表底部添加常用软件 / 文件夹，点击即可打开。可设置「仅显示图标」并调整图标大小，节省空间。"
                       FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,4,0,12"/>

            <TextBlock Text="预览（与悬浮课表底部一致）" FontSize="14" FontWeight="Bold" Foreground="#1F2A37" Margin="0,0,0,6"/>
            <Border Background="White" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="10" Padding="10">
                <StackPanel>
                    <WrapPanel x:Name="PreviewWrap" Orientation="Horizontal"/>
                    <TextBlock x:Name="TxtPreviewEmpty" Text="（还没有添加任何快捷方式）" FontSize="12" Foreground="#9CA3AF"/>
                </StackPanel>
            </Border>

            <CheckBox x:Name="ChkIconOnly" Content="仅显示图标（不显示文字，更节省空间）" FontSize="14" Margin="0,14,0,6"
                      Click="ChkIconOnly_Click"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="图标大小" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Slider x:Name="SlIconSize" Minimum="16" Maximum="48" TickFrequency="2" IsSnapToTickEnabled="True"
                        Width="240" VerticalAlignment="Center" ValueChanged="SlIconSize_ValueChanged"/>
                <TextBlock x:Name="TxtIconSize" FontSize="13" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <WrapPanel Margin="0,10,0,0">
                <Button x:Name="BtnAddProgram" Content="＋ 添加程序" Padding="12,7" FontSize="14" Margin="0,0,10,0"
                        Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}" Click="BtnAddProgram_Click"/>
                <Button x:Name="BtnAddFolder" Content="＋ 添加文件夹" Padding="12,7" FontSize="14"
                        Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}" Click="BtnAddFolder_Click"/>
            </WrapPanel>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="10" Margin="0,12,0,0">
            <ScrollViewer Margin="10" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ListPanel"/>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,12,0,0">
            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#6B7280"
                       Text="提示：确定后保存到悬浮课表底部的应用栏。"/>
            <Button x:Name="BtnOk" DockPanel.Dock="Right" Content="确定" Padding="20,7" FontSize="14" Margin="10,0,0,0"
                    Background="#2D6CDF" Foreground="White" BorderBrush="#2D6CDF" IsDefault="True" Click="BtnOk_Click"/>
            <Button x:Name="BtnCancel" DockPanel.Dock="Right" Content="取消" Padding="20,7" FontSize="14"
                    Background="White" BorderBrush="#D1D5DB" IsCancel="True" Click="BtnCancel_Click"/>
        </DockPanel>
    </Grid>
</Window>
