<Window x:Class="ClassBulletinApp.MissingEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClassBulletinApp"
        Title="缺交作业名单 · 编辑内容、格式与主题" Height="620" Width="720"
        MinWidth="560" MinHeight="460" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip" Background="#F2F5FA">
    <Window.Resources>
        <local:HexToBrushConverter x:Key="HexToBrush"/>
        <local:SizeLevelToFontSizeConverter x:Key="LevelToFont"/>

        <!-- 正文：按条目的加粗 / 颜色 / 字号档位即时呈现（与便签、桌面背景一致）。
             颜色与字号用转换器解析，因此预设色之外的「自定义颜色」也能正确预览。 -->
        <Style x:Key="MsStyledBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="{Binding SizeLevel, Converter={StaticResource LevelToFont}}"/>
            <Setter Property="Foreground" Value="{Binding Color, Converter={StaticResource HexToBrush}}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Bold}" Value="True">
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：总标题 + 主题风格 + 预览 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E3E8EF" BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="总标题" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtTitle" Width="240" FontSize="14" Padding="6" Background="White" BorderBrush="#D1D5DB"/>
                    <TextBlock Text="主题风格" FontSize="14" VerticalAlignment="Center" Margin="18,0,8,0"/>
                    <ComboBox x:Name="CbTheme" Width="190" FontSize="14" SelectionChanged="CbTheme_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <Rectangle Width="18" Height="18" RadiusX="4" RadiusY="4"
                                               Fill="{Binding Background}" Stroke="#9AA3AF" StrokeThickness="1" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <Border x:Name="PreviewCard" CornerRadius="10" Padding="12" BorderThickness="1"
                        Background="#FCE4EC" BorderBrush="#F8BBD0">
                    <StackPanel>
                        <TextBlock x:Name="PreviewTitle" Text="缺交作业名单" FontSize="16" FontWeight="Bold" Foreground="#AD1457"/>
                        <TextBlock x:Name="PreviewLabel" Text="【数学】缺交：" FontSize="13" FontWeight="Bold" Foreground="#C0392B" Margin="0,6,0,0"/>
                        <TextBlock x:Name="PreviewBody" Text="示例：张三、李四" FontSize="13" Foreground="#5C2A3A" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- 中部：缺交记录列表 -->
        <ScrollViewer Grid.Row="1" Margin="14" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                    <TextBlock Text="缺交记录" FontSize="16" FontWeight="Bold" Foreground="#C0392B" VerticalAlignment="Center"/>
                    <Button x:Name="BtnAddMiss" DockPanel.Dock="Right" Content="＋ 添加记录" Click="BtnAddMiss_Click" Padding="10,4" FontSize="13"
                            Background="#FDE8E8" BorderBrush="#E0A0A0"/>
                </DockPanel>
                <TextBlock Text="科目留空表示不区分科目；学生姓名每行一个或用逗号 / 顿号分隔。"
                           FontSize="12" Foreground="#6B7280" Margin="0,0,0,10" TextWrapping="Wrap"/>
                <ItemsControl x:Name="MissItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFF6F5" BorderBrush="#F3C9C4" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Content="删除" Padding="8,4" FontSize="12" Click="BtnDelMiss_Click" Tag="{Binding}" Background="#FDE8E8" BorderBrush="#E0A0A0"/>
                                        <TextBox Text="{Binding Subject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="13" Padding="6" Margin="0,0,6,0" Background="White" BorderBrush="#D1D5DB" ToolTip="科目（留空表示通用）"/>
                                    </DockPanel>
                                    <TextBox Style="{StaticResource MsStyledBox}" Text="{Binding Students, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,6,0,0" Background="White" BorderBrush="#D1D5DB" AcceptsReturn="True" Height="52" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="缺交学生姓名：每行一个或用逗号 / 顿号分隔"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <ToggleButton Content="B" FontWeight="Bold" Padding="8,2" FontSize="12" IsChecked="{Binding Bold, Mode=TwoWay}" ToolTip="加粗"/>
                                        <ComboBox Width="132" Margin="6,0,0,0" FontSize="12" Padding="4,2"
                                                  ItemsSource="{Binding ColorOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="文字颜色（12 种预设；要别的颜色点右侧「调色…」）">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="1">
                                                        <Rectangle Width="15" Height="15" RadiusX="3" RadiusY="3"
                                                                   Fill="{Binding Swatch}" Stroke="#9AA3AF" StrokeThickness="1" Margin="0,0,7,0"/>
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button Content="调色…" Padding="8,3" FontSize="11" Margin="4,0,0,0"
                                                Click="BtnPickColor_Click" Tag="{Binding}"
                                                Background="White" BorderBrush="#D1D5DB"
                                                ToolTip="从系统调色板里选任意颜色"/>
                                        <ComboBox Width="92" Margin="6,0,0,0" FontSize="12" Padding="4,2"
                                                  ItemsSource="{Binding SizeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedValuePath="Level"
                                                  SelectedValue="{Binding SizeLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="文字大小（小 → 巨大 共 7 档）">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" FontSize="{Binding PreviewSize}" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E3E8EF" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel LastChildFill="False">
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#6B7280"
                           Text="提示：确定后会立即保存，并同步更新桌面背景便签（若已开启）。"/>
                <Button x:Name="BtnOk" DockPanel.Dock="Right" Content="确定" Padding="20,7" FontSize="14" Margin="10,0,0,0"
                        Background="#2D6CDF" Foreground="White" BorderBrush="#2D6CDF" IsDefault="True" Click="BtnOk_Click"/>
                <Button x:Name="BtnCancel" DockPanel.Dock="Right" Content="取消" Padding="20,7" FontSize="14"
                        Background="White" BorderBrush="#D1D5DB" IsCancel="True" Click="BtnCancel_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
