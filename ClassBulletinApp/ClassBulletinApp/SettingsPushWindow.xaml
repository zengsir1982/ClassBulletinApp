<Window x:Class="ClassBulletinApp.SettingsPushWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="下发设置到教室机"
        Width="760" Height="800"
        MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource SurfaceBrush}"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部说明 -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Padding="24,20,24,14"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="下发设置到教室机" FontSize="19" FontWeight="Bold"
                           Foreground="{DynamicResource InkBrush}"/>
                <TextBlock FontSize="12.5" Foreground="{DynamicResource BodyBrush}" TextWrapping="Wrap"
                           Margin="0,6,0,0" LineHeight="19"
                           Text="只推送设置，不重下课表包。教室机下次自动检查时应用，无人值守也会生效。这里改的是「要下发的值」，不会改动本机自己的设置（提醒设置除外，见下）。"/>
                <Border Background="#F0F4FB" CornerRadius="6" Padding="10,7" Margin="0,10,0,0">
                    <TextBlock x:Name="TxtSourceInfo" FontSize="12" Foreground="{DynamicResource BodyBrush}"
                               TextWrapping="Wrap" Text="数据源：未配置"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- 设置分组 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16,24,8">
            <StackPanel>

                <!-- ① 显示 -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="18,16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="① 显示设置" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource InkBrush}" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="每周起始日" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource BodyBrush}"/>
                            <ComboBox x:Name="CmbWeekStart" Grid.Column="1" Width="150" HorizontalAlignment="Left"
                                      FontSize="13">
                                <ComboBoxItem Content="周一" Tag="1"/>
                                <ComboBoxItem Content="周日" Tag="0"/>
                                <ComboBoxItem Content="周六" Tag="6"/>
                            </ComboBox>
                        </Grid>

                        <WrapPanel Orientation="Horizontal">
                            <CheckBox x:Name="ChkPanelOnStart" Content="启动时显示面板" FontSize="13" Margin="0,0,22,10"/>
                            <CheckBox x:Name="ChkAutoSchedule" Content="自动展开课表" FontSize="13" Margin="0,0,22,10"/>
                            <CheckBox x:Name="ChkAutoNotification" Content="自动展开通知" FontSize="13" Margin="0,0,22,10"/>
                            <CheckBox x:Name="ChkAutoHomework" Content="自动展开作业" FontSize="13" Margin="0,0,22,10"/>
                            <CheckBox x:Name="ChkAutoMissing" Content="自动展开缺交" FontSize="13" Margin="0,0,22,10"/>
                            <CheckBox x:Name="ChkAutoNotice" Content="自动展开公告" FontSize="13" Margin="0,0,22,10"/>
                            <CheckBox x:Name="ChkDoodleRestore" Content="启动恢复黑板" FontSize="13" Margin="0,0,22,10"/>
                            <CheckBox x:Name="ChkDoodleCollapsed" Content="黑板收起启动" FontSize="13" Margin="0,0,22,10"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ② 提醒 -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="18,16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="② 上下课提醒" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource InkBrush}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="ChkReminder" Content="随本次下发提醒设置（本机当前配置）" FontSize="13"/>
                        <TextBlock FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                   Margin="22,6,0,0" LineHeight="18"
                                   Text="提醒配置字段多（上课 / 下课 / 放学、提前秒数、语音、小窗位置等），这里直接沿用本机现有值整组下发。需要调整请先在本机「提醒设置」页改好，再回到这里下发。提醒自 r113 起不再随课表包下发，只能从这里推。"/>
                        <TextBlock x:Name="TxtReminderSummary" FontSize="12"
                                   Foreground="{DynamicResource BodyBrush}" Margin="22,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- ③ 教学日历（r143）：调休 / 放假日 + 开学日，跟设置走独立通道，不必重发整包 -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="18,16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="③ 教学日历（调休 / 放假 + 开学日）" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource InkBrush}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="ChkCalendar" Content="随本次下发教学日历（本机当前校历）" FontSize="13"
                                  Checked="ChkCalendar_Changed" Unchecked="ChkCalendar_Changed"/>
                        <TextBlock FontSize="11.5" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                                   Margin="22,6,0,0" LineHeight="18"
                                   Text="学校的「第几周」全靠开学日推算，所以开学日跟调休一起下发。要改请先在本机「校历」里改好（或点下面的按钮），再回到这里勾选下发。教室机下次检查时自动生效，大屏立刻按新校历显示。"/>
                        <TextBlock x:Name="TxtCalendarSummary" FontSize="12"
                                   Foreground="{DynamicResource BodyBrush}" Margin="22,8,0,0" TextWrapping="Wrap"/>
                        <Button x:Name="BtnOpenCalendar" Content="打开本机校历…" Click="BtnOpenCalendar_Click"
                                Style="{StaticResource AppGhostButton}" Padding="10,5" FontSize="12"
                                HorizontalAlignment="Left" Margin="22,10,0,0"
                                ToolTip="在这里改完调休/放假，回到本窗口会自动刷新预览；确认无误后点最下方「下发」"/>
                    </StackPanel>
                </Border>

                <!-- ④ 同步 -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="18,16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="④ 班级内容同步" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource InkBrush}" Margin="0,0,0,12"/>
                        <WrapPanel Orientation="Horizontal">
                            <CheckBox x:Name="ChkSyncEnabled" Content="启用班级内容同步" FontSize="13" Margin="0,0,22,10"/>
                            <CheckBox x:Name="ChkSyncPopup" Content="课间弹窗" FontSize="13" Margin="0,0,22,10"/>
                            <CheckBox x:Name="ChkSyncFullScreen" Content="全屏提醒" FontSize="13" Margin="0,0,22,10"/>
                            <CheckBox x:Name="ChkSyncVoice" Content="语音提醒" FontSize="13" Margin="0,0,22,10"/>
                            <CheckBox x:Name="ChkSyncAutoApply" Content="自动应用变动" FontSize="13" Margin="0,0,22,10"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ⑤ 更新来源（危险区） -->
                <Border Background="#FDF3F2" BorderBrush="#C0392B" BorderThickness="1.4"
                        CornerRadius="10" Padding="18,16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="⑤ 更新来源与同步路径（改错会断掉教室机的更新通道）"
                                   FontSize="15" FontWeight="Bold" Foreground="#C0392B" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkIncludeSource" FontSize="13" Foreground="#8A2B20"
                                  Content="随本次下发这几项（默认不勾，仅在换数据源 / 换服务器时临时勾选）"/>
                        <TextBlock FontSize="11.5" Foreground="#8A2B20" TextWrapping="Wrap"
                                   Margin="22,6,0,12" LineHeight="18"
                                   Text="⚠ 教室机的数据源路径通常和发布机不同（例如发布机走 WPS 云盘、教室机走 FTP）。勾选后会用这里的值覆盖所有教室机，一旦填错，教室机会再也拉不到更新，且现场很难看出来。"/>

                        <StackPanel x:Name="PnlSource" IsEnabled="False" Opacity="0.55">
                            <CheckBox x:Name="ChkAutoUpdate" Content="启用自动更新" FontSize="13" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="数据源类型" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource BodyBrush}"/>
                                <ComboBox x:Name="CmbSourceKind" Grid.Column="1" Width="170" HorizontalAlignment="Left" FontSize="13">
                                    <ComboBoxItem Content="共享文件夹 / U 盘" Tag="folder"/>
                                    <ComboBoxItem Content="FTP" Tag="ftp"/>
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="共享路径" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource BodyBrush}"/>
                                <TextBox x:Name="TxtFolder" Grid.Column="1" FontSize="13" Padding="8,6"
                                         VerticalContentAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="FTP 地址" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource BodyBrush}"/>
                                <TextBox x:Name="TxtFtpUrl" Grid.Column="1" FontSize="13" Padding="8,6"
                                         VerticalContentAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="检查间隔" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource BodyBrush}"/>
                                <TextBox x:Name="TxtInterval" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                         FontSize="13" Padding="8,6" VerticalContentAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="分钟" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,0"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="启动延迟" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource BodyBrush}"/>
                                <TextBox x:Name="TxtDelay" Grid.Column="1" Width="90" HorizontalAlignment="Left"
                                         FontSize="13" Padding="8,6" VerticalContentAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="秒" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,0"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="同步根目录" FontSize="13" VerticalAlignment="Center"
                                           Foreground="{DynamicResource BodyBrush}"/>
                                <TextBox x:Name="TxtSyncRoot" Grid.Column="1" FontSize="13" Padding="8,6"
                                         VerticalContentAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ⑥ 代次重置（r144）：教室机的代次虚高时，正常的「下发」永远追不上。
                     这条指令让教室机把高水位清零，之后的正常下发与整包才重新生效。 -->
                <Border Background="#FFFAEE" BorderBrush="#D9A23B" BorderThickness="1.2"
                        CornerRadius="10" Padding="18,16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="⑥ 重置教室机代次（高级 · 只在「下发了没反应」时用）"
                                   FontSize="15" FontWeight="Bold" Foreground="#8A5A00" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkResetRev" FontSize="13" Foreground="#8A5A00"
                                  Content="随本次下发，让教室机清零「已应用代次」"
                                  Checked="ChkResetRev_Changed" Unchecked="ChkResetRev_Changed"/>
                        <TextBlock FontSize="11.5" Foreground="#8A5A00" TextWrapping="Wrap"
                                   Margin="22,6,0,8" LineHeight="18"
                                   Text="教室机各自累加「已应用设置代次 / 已应用教学日历代次」，新内容比它大才生效。恢复过备份、换过机器或改过配置的教室机可能把它顶到很大的值（例如 999），发布端才 3 —— 这时不管发多少遍都没反应，页面也不会报错。勾上这项会把它们清零。"/>
                        <CheckBox x:Name="ChkResetPackage" FontSize="13" Foreground="#8A5A00" IsEnabled="False"
                                  Content="同时让教室机重新下载一次课表包（清空已下载摘要）" Margin="22,0,0,0"/>
                        <TextBlock FontSize="11.5" Foreground="#8A5A00" TextWrapping="Wrap"
                                   Margin="44,6,0,8" LineHeight="18"
                                   Text="只影响「有没有更新」的判断：清掉后教室机下次检查会认为有新版本，重下一遍整包。课表内容本身不会被改坏，但会多一次下载。"/>
                        <TextBlock x:Name="TxtRevSummary" FontSize="12" Foreground="{DynamicResource BodyBrush}"
                                   TextWrapping="Wrap" Margin="22,4,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作 -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" Padding="24,14"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <!-- r148：下发前把「装了什么 / 跟本机差在哪 / 有没有危险项」摊开，避免盲发 -->
                    <Border Background="#F0F4FB" CornerRadius="6" Padding="9,7" Margin="0,0,12,7">
                        <TextBlock x:Name="TxtPushPreview" FontSize="11.5" Foreground="{DynamicResource BodyBrush}"
                                   TextWrapping="Wrap" LineHeight="17" Text="本次下发：正在计算…"/>
                    </Border>
                    <CheckBox x:Name="ChkForce" FontSize="12.5" Foreground="{DynamicResource BodyBrush}"
                              Content="强制重新下发（内容没变也重推一次，用于拉回被改乱的教室机）"/>
                    <TextBlock x:Name="TxtResult" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,6,12,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnCancel" Content="取消" Padding="20,10" FontSize="14" Margin="0,0,10,0"
                            Style="{StaticResource AppGhostButton}" Click="BtnCancel_Click"/>
                    <Button x:Name="BtnPush" Content="下发" Padding="26,10" FontSize="14"
                            Style="{StaticResource AppPrimarySoftButton}" Click="BtnPush_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
