<Window x:Class="ClassBulletinApp.ScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClassBulletinApp"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="课表悬浮窗" WindowStyle="None" ResizeMode="CanResize"
        MinWidth="220" MinHeight="200"
        ShowInTaskbar="False" AllowsTransparency="True"
        Background="Transparent" Loaded="Window_Loaded"
        Stylus.IsPressAndHoldEnabled="False"
        Stylus.IsFlicksEnabled="False"
        PreviewMouseRightButtonDown="Window_PreviewMouseRightButtonDown"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewTouchDown="Window_PreviewTouchDown"
        PreviewTouchMove="Window_PreviewTouchMove"
        PreviewTouchUp="Window_PreviewTouchUp"
        LostMouseCapture="Window_LostMouseCapture">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:QlIconConverter x:Key="QlIcon"/>

        <!--
            课表行尺寸（自适应）：这几项由 ApplyRowMetrics() 在窗口尺寸 / 内容变化后按
            「当前可用高度 ÷ 今天的课节数」实时改写，字号与行高一起走。

            为什么不全写死：100% 缩放时窗口能拉到 1000 DIP 高，8 节加固定行放得下；
            屏幕设成 125% 后逻辑画布只剩约 830 DIP，同样的内容装不进去，用户只能靠滚动条
            一节一节往下看。这里保留一份默认值（等于原来写死的那套），只作首帧兜底 ——
            第一次布局完成前模板可能已经实例化，DynamicResource 找不到 key 会退化成继承值。
        -->
        <sys:Double x:Key="LessonRowMinHeight">0</sys:Double>
        <sys:Double x:Key="LessonSubjectSize">19</sys:Double>
        <sys:Double x:Key="LessonTeacherSize">13</sys:Double>
        <sys:Double x:Key="LessonPeriodSize">18</sys:Double>
        <sys:Double x:Key="LessonWeekTagSize">12</sys:Double>
        <Thickness x:Key="LessonCardPadding" Left="10" Top="10" Right="10" Bottom="10"/>
        <Thickness x:Key="LessonCardMargin" Left="0" Top="0" Right="0" Bottom="8"/>

        <!--
            底部内置快捷按钮（作业 / 缺交 / 便签）的胶囊外观定义在 App.xaml（QuickActionBtn），
            与「管理」窗口里的预览共用同一份，字号 / 内边距由 QuickActionStyle 统一计算。
        -->

        <!-- 普通课程行 -->
        <DataTemplate x:Key="LessonRowTpl">
            <Border Background="{Binding CardBg}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="10" MinHeight="{DynamicResource LessonRowMinHeight}"
                    Padding="{DynamicResource LessonCardPadding}"
                    Margin="{DynamicResource LessonCardMargin}" Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!--
                        ★ 左列 = 拖动专用抓手：按住这里立刻可以搬（不必等 0.5 秒长按），
                          按住不动直接松开 = 打开调课窗（等同鼠标右键）。

                          为什么必须有它：手指刚按下的头 10px 很容易抖出去，而按"一动就优先滚动"
                          的铁律，一过 10px 就被判成滚动、本次按下永久失能 —— 长按换课于是
                          "时灵时不灵"。抓手给了用户一个明确的"我要搬这一节"的入口，
                          在这个区域里不参与滚动判定。

                        ★ 必须是 Grid，不能是 Border：Border 加上 PeriodRow 的 DataContext 会被
                          FindPeriodRow / HitTestBorder 当成"课程行的根 Border"，幽灵卡就会缩成
                          74px 宽的一条。Background 也必须显式给定，否则文字之间的空白点不中。
                    -->
                    <Grid Grid.Column="0" Tag="Grip" Cursor="SizeAll"
                          ToolTip="按住这里可直接把这一节拖到别的节；按住不动松手 = 打开调课">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <!-- 鼠标 / 触摸按上去时给一点点色，让人知道这块是"抓手" -->
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F4F7FC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding PeriodText}" FontSize="{DynamicResource LessonPeriodSize}" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text="{Binding TimeRange}" FontSize="11" Foreground="{DynamicResource HintBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="1">
                        <ItemsControl ItemsSource="{Binding Lessons}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <!--
                                            调 / 代课标记：与科目同一行、靠右显示的小胶囊。
                                            以前是单独占一行（在科目上方），一出现就把这一格撑高，
                                            整列课表跟着往下挤；挂在同一行后格子高度与普通课完全一致。
                                            科目过长时省略号收尾，不会把胶囊挤出格子。
                                        -->
                                        <DockPanel LastChildFill="True">
                                            <Border DockPanel.Dock="Right" Background="{Binding OverrideBadgeColor}"
                                                    CornerRadius="4" Padding="5,0" Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsOverridden, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="{Binding OverrideNote}">
                                                <TextBlock Text="{Binding OverrideBadgeText}" Foreground="White" FontSize="10"/>
                                            </Border>
                                            <TextBlock FontSize="{DynamicResource LessonSubjectSize}" FontWeight="Bold" Foreground="{Binding SubjectColor}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center">
                                                <Run Text="{Binding DisplaySubject, Mode=OneWay}"/>
                                                <Run Text="{Binding WeekTag}" FontSize="{DynamicResource LessonWeekTagSize}" Foreground="{DynamicResource HintBrush}" FontWeight="Normal"/>
                                            </TextBlock>
                                        </DockPanel>
                                        <TextBlock FontSize="{DynamicResource LessonTeacherSize}" Foreground="{DynamicResource BodyBrush}" Tag="TeacherTag" Cursor="Hand"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   ToolTip="双击可切换到该教师 / 班级的课表">
                                            <Run Text="{Binding TeacherPrefix}" FontWeight="Bold"/>
                                            <Run Text="{Binding Teacher}"/>
                                            <Run Text="{Binding LocationText}" Foreground="#2E8B57"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 固定时段行（大课间 / 眼保健操 / 午休）：单行灰色横条，左边名称、右边时间 -->
        <DataTemplate x:Key="FixedRowTpl">
            <Border Background="{Binding CardBg}" CornerRadius="8" Padding="9,4" Margin="0,0,0,6">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding PeriodText}" FontSize="13"
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding TimeRange}" FontSize="11"
                               Foreground="{DynamicResource HintBrush}" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </DataTemplate>
        <!--
            板书工具条按钮（r107）：原先是 7,2 内边距 + 11 号字的「小方块」，
            教室里 3~4 米外根本看不清，手指也点不准。
            ★ 不写死 Background/BorderBrush 的触发器，选中态由代码给 Tag="on" —— 见 UpdateHandToolVisual()。
        -->
        <Style x:Key="HandToolButton" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="MinWidth" Value="52"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D7DEE8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#2B3A4A"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="Bd" Property="Background" Value="#E6F1FB"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8FB8DF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 日期翻页：比工具按钮更轻，只在悬停时才显形 -->
        <Style x:Key="HandNavButton" TargetType="Button" BasedOn="{StaticResource HandToolButton}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="40"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
    </Window.Resources>
    <Grid x:Name="Shell">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="HandCol" Width="0"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--
            板书模式的手写区（r105）。
            ★ 默认整块 Collapsed、列宽 0：简洁模式下窗口宽度与改造前一模一样，
              不会凭空多出一条边，也不会让「设为背景」的旧坐标对不上。
            ★ 这里是独立的 InkCanvas，和涂鸦板各自存笔迹：按日期一天一个 ISF 文件，
              只保留最近 7 天（见 ScheduleWindow.HandInk.cs）。
        -->
        <Border x:Name="HandPanel" Grid.Column="0" Visibility="Collapsed"
                Background="#FDFDFB" CornerRadius="14,0,0,14"
                BorderBrush="#D8DEE9" BorderThickness="1,1,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="HandHeader" Grid.Row="0" Background="{DynamicResource PrimaryBrush}" Padding="12,8">
                    <Grid>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,96,0">
                            <TextBlock x:Name="TxtHandClass" FontSize="16" FontWeight="Bold" Foreground="White"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtHandSub" FontSize="12" Foreground="#B9CBEA" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button x:Name="BtnHandCollapse" Content="收起" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="BtnHandCollapse_Click"
                                Style="{StaticResource FloatScheduleButton}"
                                Height="34" MinWidth="76" FontSize="13.5" Padding="12,0"
                                ToolTip="收起左边这块板书，回到简洁模式（笔迹每天一份，7 天内都在）"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ClipToBounds="True">
                    <!-- 淡横线：像备忘纸，写满也一眼能对齐；用平铺绘图刷，不用逐个 Canvas 画线 -->
                    <Border>
                        <Border.Background>
                            <DrawingBrush TileMode="Tile" Stretch="None"
                                          Viewport="0,0,1000,44" ViewportUnits="Absolute"
                                          Viewbox="0,0,1000,44" ViewboxUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing>
                                        <GeometryDrawing.Pen>
                                            <Pen Brush="#EDF0F4" Thickness="1"/>
                                        </GeometryDrawing.Pen>
                                        <GeometryDrawing.Geometry>
                                            <LineGeometry StartPoint="0,43.5" EndPoint="1000,43.5"/>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Border.Background>
                    </Border>
                    <InkCanvas x:Name="HandInk" Background="Transparent" Focusable="True"
                               Stylus.IsPressAndHoldEnabled="False" Stylus.IsFlicksEnabled="False"
                               StrokeCollected="HandInk_StrokeCollected"
                               StrokeErased="HandInk_StrokeErased"/>
                </Grid>

                <!--
                    板书工具条（r107 放大）：原先 11 号字 + 7,2 内边距的小按钮，
                    教室里 3~4 米外看不清、手指也点不准。现在 48 高、图标 + 文字，
                    图标由 StyleHandToolBar() 在代码里装配（Path 跟着主题换色）。
                -->
                <Border x:Name="HandBar" Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0"
                        BorderThickness="0,1,0,0" Padding="10,7">
                    <DockPanel LastChildFill="False">
                        <!-- 右：笔 / 橡皮 / 撤销 / 清空。
                             ★ 先停靠右边：DockPanel 按加入顺序排，日期那组在后面能拿到的余量才不会被工具组吃掉。
                             ★ 竖排「图标 + 小字」：手写区最窄时（约 420）也放得下四个 52 宽的大按钮。 -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnHandClear" Style="{StaticResource HandToolButton}"
                                    Click="BtnHandClear_Click" ToolTip="清空这一天的板书（会先问一次）"/>
                            <Button x:Name="BtnHandUndo" Style="{StaticResource HandToolButton}"
                                    Click="BtnHandUndo_Click" ToolTip="撤销刚才写的那一笔"/>
                            <Button x:Name="BtnHandEraser" Style="{StaticResource HandToolButton}"
                                    Click="BtnHandEraser_Click" ToolTip="橡皮：擦掉写错的地方"/>
                            <Button x:Name="BtnHandPen" Style="{StaticResource HandToolButton}"
                                    Click="BtnHandPen_Click" ToolTip="点一下选中笔，再点一次换颜色与粗细"/>
                        </StackPanel>
                        <!-- 左：日期翻页 ‹ 日期 › -->
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnHandPrev" Style="{StaticResource HandNavButton}"
                                    Click="BtnHandPrev_Click" ToolTip="前一天"/>
                            <TextBlock x:Name="TxtHandDate" VerticalAlignment="Center" FontSize="15" FontWeight="Bold"
                                       Margin="6,0" Cursor="Hand" TextTrimming="CharacterEllipsis"
                                       MouseLeftButtonDown="TxtHandDate_MouseLeftButtonDown"
                                       ToolTip="点一下回到今天"/>
                            <Button x:Name="BtnHandNext" Style="{StaticResource HandNavButton}"
                                    Click="BtnHandNext_Click" ToolTip="后一天"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!--
            两区中间这条缝（r107 改语义）。
            ★ 拖它 = 改「课表」宽度：手写区宽度一个像素都不动，整块跟着缝左右平移，
              窗口右边界钉在原处（跟拖窗口左边框一个手感）。
              手写区自己的宽度由窗口左沿控制 —— 见 OnHandWindowGeometryChanged()。
            ★ 不能用 GridSplitter：它只会在固定窗口宽里把两列此消彼长。
        -->
        <Border x:Name="HandSplitter" Grid.Column="0" Visibility="Collapsed"
                HorizontalAlignment="Right" Width="9" Background="Transparent"
                Cursor="SizeWE"
                MouseLeftButtonDown="HandSplitter_MouseLeftButtonDown"
                MouseMove="HandSplitter_MouseMove"
                MouseLeftButtonUp="HandSplitter_MouseLeftButtonUp"
                MouseEnter="HandSplitter_MouseEnter" MouseLeave="HandSplitter_MouseLeave"
                ToolTip="拖动可调整课表宽度（手写区宽度不变）">
            <Border x:Name="HandSplitterLine" Width="2" HorizontalAlignment="Center"
                    Background="#DCE3EC" CornerRadius="1" Margin="0,10"/>
        </Border>

        <!-- 手写区左沿的抓手提示：真正的拖动是系统窗口缩放（左沿改变手写区宽度） -->
        <Border x:Name="HandLeftHint" Grid.Column="0" Visibility="Collapsed"
                HorizontalAlignment="Left" VerticalAlignment="Center"
                Height="58" Width="9" IsHitTestVisible="False" Background="Transparent">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="3" Height="3" CornerRadius="1.5" Background="#C2CEDC" Margin="0,2.5"/>
                <Border Width="3" Height="3" CornerRadius="1.5" Background="#C2CEDC" Margin="0,2.5"/>
                <Border Width="3" Height="3" CornerRadius="1.5" Background="#C2CEDC" Margin="0,2.5"/>
            </StackPanel>
        </Border>

        <Border x:Name="MainFrame" Grid.Column="1" Background="#FFFFFF" CornerRadius="14" BorderBrush="#D8DEE9" BorderThickness="1"
            Margin="0" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 头部：班级（双击换班级）/ 日期（双击换日期）/ 单双周·星期；空白处按住可拖动整个窗口 -->
            <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource PrimaryBrush}" Style="{StaticResource FloatScheduleHeader}"
                    ToolTip="按住空白处可拖动窗口；拖动窗口边沿可改变大小">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <!-- 班级/教师区：双击切换 -->
                        <StackPanel x:Name="ClassHeader" Background="Transparent" Cursor="Hand"
                                   MouseLeftButtonDown="ClassHeader_MouseLeftButtonDown"
                                   ToolTip="双击此处可切换显示其他班级课表">
                            <TextBlock x:Name="TxtClass" FontSize="23" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                        <!-- 日期区：双击切换显示其他日期（调休上课） -->
                        <StackPanel x:Name="DateHeader" Background="Transparent" Cursor="Hand" Margin="0,3,0,0"
                                   MouseLeftButtonDown="DateHeader_MouseLeftButtonDown"
                                   ToolTip="双击此处可切换显示其他日期（调休上课）">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtDate" Grid.Column="0" FontSize="14" Foreground="#E3ECFB"
                                           TextTrimming="CharacterEllipsis"/>
                                <!-- 实时时钟：紧跟在日期后面（靠左），字号小一号、颜色略淡；关闭时不占位。
                                     ★ 不能靠右对齐：标题栏右上角是「自动隐藏 / 更新课表」两个按钮，
                                       时钟贴到右边就会跟按钮叠在一起（宽度一变就互相压字）。 -->
                                <TextBlock x:Name="TxtClock" Grid.Column="1" FontSize="12" Foreground="#B9CBEA"
                                           HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                           Margin="10,0,0,2" Visibility="Collapsed" ToolTip="当前时间"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <TextBlock x:Name="TxtWeek" FontSize="14" Foreground="#E3ECFB" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- 右侧操作区：自动隐藏 / 常驻显示 与 更新课表 上下排列，同白底半透明风格，整齐显眼 -->
                    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Right">
                        <!-- 板书模式开关：点一下在左边多长出一块手写区，再点收起。
                             放在这一组最上面，与「自动隐藏 / 更新课表」同一套白底按钮样式。 -->
                        <Button x:Name="BtnHandToggle" Content="板书" Click="BtnHandToggle_Click"
                                VerticalAlignment="Top" Margin="0,0,0,4" Style="{StaticResource FloatScheduleButton}"
                                ToolTip="在旁边多开一块手写板（板书），可以随手写；再点一次收起"/>
                        <Button x:Name="BtnHide" Content="自动隐藏" Click="BtnHide_Click"
                                VerticalAlignment="Top" Margin="0,0,0,4" Style="{StaticResource FloatScheduleButton}"
                                ToolTip="点「自动隐藏」可切换为靠边自动隐藏（鼠标移到屏幕边沿滑出）；点「常驻显示」则始终常驻屏幕最前"/>
                        <Button x:Name="BtnQaUpdate" Click="BtnQaUpdate_Click"
                                VerticalAlignment="Top" Style="{StaticResource FloatScheduleButton}"
                                ToolTip="立即从数据源检查并应用最新的课表 / 调代课">
                            <TextBlock x:Name="TxtQaUpdate" Text="更新课表"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 课表滚动区（紧凑，减小内边距与字号，留出更多底部空间）。
                 滚动条 Hidden 而不是 Disabled：内容超长时仍能用滚轮 / 手指拖动滚动，
                 只是不显示那条灰白竖条 —— 悬浮窗本来就窄，一条滚动条要吃掉十几个像素，
                 而且教室屏幕大、课表通常一屏放得下，滚动条更多是"没内容也不该出现的装饰"。

                 ★ PanningMode 恒为 None（见 ApplyTouchScrollMode）：
                   只要不是 None，ScrollViewer 在触摸按下时就会捕获触摸并标记「已处理」，
                   WPF 不再把这次触摸提升成鼠标事件 —— 单击 / 双击 / 拖动换节会全部失效。
                   滚动一律由代码自己算（单指快划 + 双指划动都走同一套位移），
                   见 ScheduleWindow.xaml.cs 顶部的手势判定说明。 -->
            <ScrollViewer x:Name="ScheduleScroll" Grid.Row="1" Margin="10" VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled" PanningMode="None">
                <StackPanel>
                    <ItemsControl x:Name="TodayPanel">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 固定时段（大课间/眼保健操/午休）走单行横条模板，其余走课程卡模板 -->
                                <ContentControl Content="{Binding}" HorizontalContentAlignment="Stretch">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="ContentTemplate" Value="{StaticResource LessonRowTpl}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFixed}" Value="True">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource FixedRowTpl}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 状态栏：课表更新时间 + 更新失败红字，拼成一条字幕；文字比宽度长时自动匀速滚过，
                 放得下就静态显示（短句滚动反而难读）。右侧「背景：已设/未设」固定不动，方便一眼看到 -->
            <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                    Padding="10,4" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 字幕视口：Canvas 让文字按真实宽度排版（不被窗口宽度挤断），ClipToBounds 负责裁边 -->
                    <Canvas x:Name="MarqueeView" Grid.Column="0" Height="15" ClipToBounds="True"
                            SizeChanged="MarqueeView_SizeChanged">
                        <TextBlock x:Name="TxtMarquee" Canvas.Top="0" FontSize="11" Foreground="#8A94A6"
                                   VerticalAlignment="Center" TextWrapping="NoWrap">
                            <TextBlock.RenderTransform>
                                <TranslateTransform X="0"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Canvas>

                    <TextBlock x:Name="TxtWpState" Grid.Column="1" FontSize="11" Foreground="#8A94A6"
                               VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                               Text="未设为背景"/>
                </Grid>
            </Border>

            <!-- 底部应用快捷栏：常用软件 / 文件夹入口，点击直达；图标模式 + 大小可在「布局设置 → 课表」或右下「管理」里调 -->
            <Border Grid.Row="3" Background="{DynamicResource BarSurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                    Padding="8,6">
                <StackPanel>
                    <!-- 内置快捷：作业 / 缺交 / 便签。三个都是「图标 + 两个字」，宽度天然一致、一眼能认。
                         按账号权限显示，没权限的整条隐藏（更新课表已移至标题栏） -->
                    <WrapPanel x:Name="BuiltinWrap" Orientation="Horizontal">
                        <Button x:Name="BtnQaHomework" Style="{StaticResource QuickActionBtn}" Click="BtnQaHomework_Click"
                                Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource PrimarySoftBorderBrush}"
                                ToolTip="打开「作业公示」便签，可以直接编辑各科作业内容">
                            <TextBlock Text="📋 作业"/>
                        </Button>
                        <Button x:Name="BtnQaMissing" Style="{StaticResource QuickActionBtn}" Click="BtnQaMissing_Click"
                                Background="#FFF4E5" BorderBrush="#F0C48A"
                                ToolTip="打开「缺交作业名单」便签，可以直接登记谁没交">
                            <TextBlock Text="📝 缺交"/>
                        </Button>
                        <Button x:Name="BtnQaNote" Style="{StaticResource QuickActionBtn}" Click="BtnQaNote_Click"
                                Background="#F2EDFD" BorderBrush="#BFAFE8"
                                ToolTip="打开自定义便签（教师寄语 / 温馨提示等）；还没有便签时会新建一张">
                            <TextBlock Text="📌 便签"/>
                        </Button>
                        <Button x:Name="BtnQaCountdown" Style="{StaticResource QuickActionBtn}" Click="BtnQaCountdown_Click"
                                Background="#FFF8E1" BorderBrush="#E8CE8A"
                                ToolTip="打开倒计时便签（期末考试 / 运动会还有几天）；还没有事件时会直接弹出编辑窗口">
                            <TextBlock Text="⏳ 倒数"/>
                        </Button>
                        <Button x:Name="BtnQaDuty" Style="{StaticResource QuickActionBtn}" Click="BtnQaDuty_Click"
                                Background="#E8F5E9" BorderBrush="#A5CFA8"
                                ToolTip="打开值日生名单便签；还没有安排时会直接弹出编辑窗口">
                            <TextBlock Text="🧹 值日"/>
                        </Button>
                        <Button x:Name="BtnQaSettings" Style="{StaticResource QuickActionBtn}" Click="BtnQaSettings_Click"
                                Background="#EEF1F5" BorderBrush="#B9C2CE"
                                ToolTip="打开控制面板的「显示设置」页（字号、颜色、悬浮窗、手写球等都在这里）">
                            <TextBlock Text="⚙ 设置"/>
                        </Button>
                        <!-- 「周课 / 发布 / 信息」是新加的三个直达入口：显隐与顺序都由 QuickActionCatalog 按角色决定，
                             这里只管摆出来；XAML 顺序不影响实际顺序（运行时会按角色重排）。 -->
                        <Button x:Name="BtnQaWeek" Style="{StaticResource QuickActionBtn}" Click="BtnQaWeek_Click"
                                Background="#E8F0FE" BorderBrush="#A8C0E8"
                                ToolTip="打开控制面板的「周课程表」页（整周课表，可拖动课程卡调课）">
                            <TextBlock Text="🗓 周课"/>
                        </Button>
                        <Button x:Name="BtnQaPublish" Style="{StaticResource QuickActionBtn}" Click="BtnQaPublish_Click"
                                Background="#EAF7F0" BorderBrush="#9FD3B4"
                                ToolTip="新建班级内容变更单：把作业 / 缺交 / 通知发到教室机（目标班级仍以「信息管理」页勾选为准）">
                            <TextBlock Text="📤 发布"/>
                        </Button>
                        <Button x:Name="BtnQaInfo" Style="{StaticResource QuickActionBtn}" Click="BtnQaInfo_Click"
                                Background="#F0F4FF" BorderBrush="#B8C6EC"
                                ToolTip="打开「信息管理」的消息台账 / 回执窗口（教室里是收件箱，老师这边是发送箱）">
                            <TextBlock Text="📨 信息"/>
                        </Button>
                    </WrapPanel>

                    <TextBlock x:Name="TxtQlEmpty" Text="点击下方「＋」添加常用软件 / 文件夹"
                               FontSize="11" Foreground="{DynamicResource HintBrush}" Margin="2,0,0,4"
                               Visibility="Collapsed"/>
                    <WrapPanel x:Name="QlWrap" Orientation="Horizontal"/>
                    <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="BtnAddFolder" Content="＋ 文件夹" Click="BtnAddFolder_Click" Padding="6,2" FontSize="11"
                                Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}"/>
                        <Button x:Name="BtnAddQl" Content="＋ 程序" Click="BtnAddQl_Click" Padding="6,2" FontSize="11" Margin="6,0,0,0"
                                Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}"/>
                        <Button x:Name="BtnQlManage" Content="管理" Click="BtnQlManage_Click" Padding="6,2" FontSize="11" Margin="6,0,0,0"
                                Background="White" BorderBrush="{DynamicResource InputBorderBrush}"
                                ToolTip="管理快捷方式：增删、仅显示图标、调整图标大小"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 最下方：置顶（最左，与便签同风格同功能，切换始终置顶）/ 锁定 + 位置 / 桌面背景（右侧）。
                 注意：标题栏「自动隐藏 / 常驻显示」管的是「是否始终显示（不靠边隐藏）」，本处「置顶」管的是「是否始终在最上层」，
                 两者语义不同，故各保留一个按钮，不冲突。 -->
            <Border Grid.Row="4" Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12" Padding="10,7">
                <DockPanel LastChildFill="False">
                    <Button x:Name="BtnTop" DockPanel.Dock="Left" Content="置顶" Click="BtnTop_Click"
                            Padding="8,3" FontSize="11" Margin="6,0,0,0"
                            Background="White" BorderBrush="{DynamicResource InputBorderBrush}" Foreground="Black"
                            ToolTip="切换置顶（始终显示在所有窗口最上层）/ 普通层级"/>
                    <Button x:Name="BtnLock" DockPanel.Dock="Left" Content="🔓" Click="BtnLock_Click"
                            Padding="10,4" FontSize="12" Margin="6,0,0,0" Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}"
                            ToolTip="锁定后不能移动 / 缩放 / 编辑，防止误操作"/>
                    <!-- 主操作「设为背景」放最右（与便签一致）；「位置」用于在排版窗口里微调 -->
                    <Button x:Name="BtnWp" DockPanel.Dock="Right" Content="设为背景" Click="BtnWp_Click"
                            Padding="10,4" FontSize="12" Margin="6,0,0,0" Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}"
                            ToolTip="按「现在的位置和大小」一键设为桌面背景，并把本悬浮课表改为靠边自动隐藏。要取消：布局设置 → 桌面背景 取消勾选"/>
                    <Button x:Name="BtnPos" DockPanel.Dock="Right" Content="位置" Click="BtnPos_Click"
                            Padding="10,4" FontSize="12" Margin="6,0,0,0" Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}"
                            ToolTip="在模拟屏幕上拖动便签，微调桌面背景里课表的位置与大小"/>
                </DockPanel>
            </Border>

            <!-- 手势提示条：卡片"浮起来"以后浮在课表底部。
                 拖动中显示「松手交换 第3节 数学 ⇄ 第5节 英语」，
                 交换成功后变成「已交换 …」并带一个 5 秒有效的「撤销」。
                 不占布局（贴在 Row 1 底部），平时 Collapsed。 -->
            <Border x:Name="ActionBar" Grid.Row="1" VerticalAlignment="Bottom" Margin="10,0,10,6"
                    Panel.ZIndex="70" Visibility="Collapsed" CornerRadius="8" Padding="9,5"
                    Background="#F2FFFFFF" BorderBrush="#B5D4F4" BorderThickness="1">
                <DockPanel LastChildFill="True">
                    <Button x:Name="BtnActionUndo" DockPanel.Dock="Right" Content="撤销" Click="BtnActionUndo_Click"
                            Visibility="Collapsed" Padding="10,2" FontSize="12" Margin="8,0,0,0"
                            Background="White" BorderBrush="#378ADD" Foreground="#1E5FA8"/>
                    <TextBlock x:Name="TxtAction" FontSize="12" Foreground="{DynamicResource InkBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- 拖动覆盖层：跟手的幽灵卡 + 原位留白虚框，全部由代码创建和定位。
                 必须 IsHitTestVisible=False，否则会挡住底下所有命中测试。 -->
            <Canvas x:Name="DragLayer" Grid.RowSpan="5" IsHitTestVisible="False"
                    ClipToBounds="False" Panel.ZIndex="80"/>
        </Grid>
        </Border>
    </Grid>
</Window>
