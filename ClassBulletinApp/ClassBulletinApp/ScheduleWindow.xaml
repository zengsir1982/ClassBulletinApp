<Window x:Class="ClassBulletinApp.ScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClassBulletinApp"
        Title="课表悬浮窗" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" AllowsTransparency="True"
        Background="Transparent" Loaded="Window_Loaded"
        PreviewMouseRightButtonDown="Window_PreviewMouseRightButtonDown"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewTouchDown="Window_PreviewTouchDown"
        PreviewTouchUp="Window_PreviewTouchUp"
        LostMouseCapture="Window_LostMouseCapture">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:QlIconConverter x:Key="QlIcon"/>
    </Window.Resources>
    <Border Background="#FFFFFF" CornerRadius="14" BorderBrush="#D8DEE9" BorderThickness="1"
            Margin="0" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 头部：班级（双击换班级）/ 日期（双击换日期）/ 单双周·星期 -->
            <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}" CornerRadius="14,14,0,0" Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <!-- 班级/教师区：双击切换 -->
                        <StackPanel x:Name="ClassHeader" Background="Transparent" Cursor="Hand"
                                   MouseLeftButtonDown="ClassHeader_MouseLeftButtonDown"
                                   ToolTip="双击此处可切换显示其他班级课表">
                            <TextBlock x:Name="TxtClass" FontSize="26" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                        <!-- 日期区：双击切换显示其他日期（调休上课） -->
                        <StackPanel x:Name="DateHeader" Background="Transparent" Cursor="Hand" Margin="0,5,0,0"
                                   MouseLeftButtonDown="DateHeader_MouseLeftButtonDown"
                                   ToolTip="双击此处可切换显示其他日期（调休上课）">
                            <TextBlock x:Name="TxtDate" FontSize="15" Foreground="#E3ECFB"/>
                            <TextBlock x:Name="TxtWeek" FontSize="15" Foreground="#E3ECFB" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="BtnHide" Grid.Column="1" Content="自动隐藏" Click="BtnHide_Click"
                            VerticalAlignment="Top" Padding="8,3" FontSize="12"
                            Background="#33FFFFFF" Foreground="White" BorderBrush="#66FFFFFF"
                            ToolTip="点「自动隐藏」可切换为靠边自动隐藏（鼠标移到屏幕边沿滑出）；点「置顶显示」则常驻最前"/>
                </Grid>
            </Border>

            <!-- 课表滚动区 -->
            <ScrollViewer Grid.Row="1" Margin="14" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl x:Name="TodayPanel">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding CardBg}" BorderBrush="#E3E8EF" BorderThickness="1"
                                        CornerRadius="12" Padding="14" Margin="0,0,0,12"
                                        Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding PeriodText}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                                            <TextBlock Text="{Binding TimeRange}" FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <ItemsControl ItemsSource="{Binding Lessons}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,2">
                                                            <Border Background="{Binding OverrideBadgeColor}" CornerRadius="4" Padding="6,2" Margin="0,0,0,6"
                                                                    HorizontalAlignment="Left"
                                                                    Visibility="{Binding IsOverridden, Converter={StaticResource BoolToVis}}"
                                                                    ToolTip="{Binding OverrideNote}">
                                                                <TextBlock Text="{Binding OverrideBadgeText}" Foreground="White" FontSize="11"/>
                                                            </Border>
                                                            <TextBlock FontSize="21" FontWeight="Bold" Foreground="{Binding SubjectColor}">
                                                                <Run Text="{Binding Subject}"/>
                                                                <Run Text="{Binding WeekTag}" FontSize="13" Foreground="#9CA3AF" FontWeight="Normal"/>
                                                            </TextBlock>
                                                            <TextBlock FontSize="14" Foreground="#4B5563" Tag="TeacherTag" Cursor="Hand"
                                                                       ToolTip="双击可切换到该教师 / 班级的课表">
                                                                <Run Text="{Binding TeacherPrefix}" FontWeight="Bold"/>
                                                                <Run Text="{Binding Teacher}"/>
                                                                <Run Text="{Binding LocationText}" Foreground="#2E8B57"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- 常用快捷：替换原操作说明，可自定义常用软件 / 文件夹，点击直达 -->
                    <StackPanel x:Name="QuickLaunchSection" Margin="0,12,0,0">
                        <DockPanel LastChildFill="False" Margin="0,0,0,6">
                            <TextBlock Text="常用快捷" FontSize="13" FontWeight="Bold" Foreground="#6B7280" VerticalAlignment="Center"/>
                            <Button x:Name="BtnAddFolder" DockPanel.Dock="Right" Content="＋ 文件夹" Click="BtnAddFolder_Click" Padding="8,2" FontSize="12"
                                    Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}"/>
                            <Button x:Name="BtnAddQl" DockPanel.Dock="Right" Content="＋ 程序" Click="BtnAddQl_Click" Padding="8,2" FontSize="12" Margin="0,0,4,0"
                                    Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}"/>
                        </DockPanel>
                        <ItemsControl x:Name="QuickLaunchPanel">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="8" Margin="0,0,6,6">
                                        <DockPanel LastChildFill="False">
                                            <Button DockPanel.Dock="Left" Click="QlItem_Click" Tag="{Binding}" Background="Transparent"
                                                    BorderThickness="0" Padding="6,3" ToolTip="{Binding Path}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Image Source="{Binding Path, Converter={StaticResource QlIcon}}" Width="16" Height="16" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Button>
                                            <Button DockPanel.Dock="Right" Click="QlRemove_Click" Tag="{Binding}" Content="×" FontSize="13" Width="18" Height="18"
                                                    Background="Transparent" BorderThickness="0" Foreground="#9CA3AF" ToolTip="移除"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="TxtQlEmpty" Text="点击「＋ 程序 / ＋ 文件夹」添加常用入口" FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 最下方：一键把当天课表设为桌面背景（画到桌面壁纸，不遮挡任何操作） -->
            <Border Grid.Row="2" Background="{DynamicResource PrimaryLightBrush}" BorderBrush="#E3E8EF" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12" Padding="12,8">
                <DockPanel LastChildFill="True">
                    <Button x:Name="BtnWp" DockPanel.Dock="Right" Content="桌面背景：关" Click="BtnWp_Click"
                            Padding="10,4" FontSize="12" Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}"
                            ToolTip="把「当天课表」画到桌面壁纸上：位于所有窗口之下、不遮挡操作，可与作业公示一起显示"/>
                    <TextBlock x:Name="TxtWpState" VerticalAlignment="Center" FontSize="12"
                               Foreground="#6B7280" TextTrimming="CharacterEllipsis"
                               Text="当天课表可设为桌面背景（壁纸层显示）"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
