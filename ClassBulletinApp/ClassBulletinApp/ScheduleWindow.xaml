<Window x:Class="ClassBulletinApp.ScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClassBulletinApp"
        Title="课表悬浮窗" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" AllowsTransparency="True"
        Background="Transparent" Loaded="Window_Loaded"
        PreviewMouseRightButtonDown="Window_PreviewMouseRightButtonDown"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewTouchDown="Window_PreviewTouchDown"
        PreviewTouchUp="Window_PreviewTouchUp">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Border Background="#FFFFFF" CornerRadius="14" BorderBrush="#D8DEE9" BorderThickness="1"
            Margin="0" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 头部：班级（单行）/ 日期（单行）/ 单双周·星期（单行） -->
            <Border Grid.Row="0" Background="#2D6CDF" CornerRadius="14,14,0,0" Padding="18,14">
                <StackPanel>
                    <TextBlock x:Name="TxtClass" FontSize="26" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="TxtDate" FontSize="15" Foreground="#E3ECFB" Margin="0,5,0,0"/>
                    <TextBlock x:Name="TxtWeek" FontSize="15" Foreground="#E3ECFB" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- 课表滚动区 -->
            <ScrollViewer Grid.Row="1" Margin="14" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="右键或长按任一节课可临时调课 / 代课" FontSize="12" Foreground="#9CA3AF" Margin="0,0,0,8"
                               x:Name="TxtHint"/>
                    <ItemsControl x:Name="TodayPanel">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding CardBg}" BorderBrush="#E3E8EF" BorderThickness="1"
                                        CornerRadius="12" Padding="14" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding PeriodText}" FontSize="20" FontWeight="Bold" Foreground="#2D6CDF"/>
                                            <TextBlock Text="{Binding TimeRange}" FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <ItemsControl ItemsSource="{Binding Lessons}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,2">
                                                            <Border Background="{Binding OverrideBadgeColor}" CornerRadius="4" Padding="6,2" Margin="0,0,0,6"
                                                                    HorizontalAlignment="Left"
                                                                    Visibility="{Binding IsOverridden, Converter={StaticResource BoolToVis}}"
                                                                    ToolTip="{Binding OverrideNote}">
                                                                <TextBlock Text="{Binding OverrideBadgeText}" Foreground="White" FontSize="11"/>
                                                            </Border>
                                                            <TextBlock FontSize="21" FontWeight="Bold" Foreground="{Binding SubjectColor}">
                                                                <Run Text="{Binding Subject}"/>
                                                                <Run Text="{Binding WeekTag}" FontSize="13" Foreground="#9CA3AF" FontWeight="Normal"/>
                                                            </TextBlock>
                                                            <TextBlock FontSize="14" Foreground="#4B5563">
                                                                <Run Text="{Binding Teacher}"/>
                                                                <Run Text="{Binding LocationText}" Foreground="#2E8B57"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
