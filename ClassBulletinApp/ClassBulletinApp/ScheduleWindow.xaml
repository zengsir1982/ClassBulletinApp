<Window x:Class="ClassBulletinApp.ScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClassBulletinApp"
        Title="课表悬浮窗" WindowStyle="None" ResizeMode="CanResize"
        MinWidth="220" MinHeight="200"
        ShowInTaskbar="False" AllowsTransparency="True"
        Background="Transparent" Loaded="Window_Loaded"
        PreviewMouseRightButtonDown="Window_PreviewMouseRightButtonDown"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewTouchDown="Window_PreviewTouchDown"
        PreviewTouchUp="Window_PreviewTouchUp"
        LostMouseCapture="Window_LostMouseCapture">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:QlIconConverter x:Key="QlIcon"/>

        <!--
            底部内置快捷按钮（作业 / 缺交 / 便签）的胶囊外观定义在 App.xaml（QuickActionBtn），
            与「管理」窗口里的预览共用同一份，字号 / 内边距由 QuickActionStyle 统一计算。
        -->

        <!-- 普通课程行 -->
        <DataTemplate x:Key="LessonRowTpl">
            <Border Background="{Binding CardBg}" BorderBrush="#E3E8EF" BorderThickness="1"
                    CornerRadius="10" Padding="10" Margin="0,0,0,8" Cursor="Hand">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding PeriodText}" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text="{Binding TimeRange}" FontSize="11" Foreground="#9CA3AF" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <ItemsControl ItemsSource="{Binding Lessons}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <!--
                                            调 / 代课标记：与科目同一行、靠右显示的小胶囊。
                                            以前是单独占一行（在科目上方），一出现就把这一格撑高，
                                            整列课表跟着往下挤；挂在同一行后格子高度与普通课完全一致。
                                            科目过长时省略号收尾，不会把胶囊挤出格子。
                                        -->
                                        <DockPanel LastChildFill="True">
                                            <Border DockPanel.Dock="Right" Background="{Binding OverrideBadgeColor}"
                                                    CornerRadius="4" Padding="5,0" Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsOverridden, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="{Binding OverrideNote}">
                                                <TextBlock Text="{Binding OverrideBadgeText}" Foreground="White" FontSize="10"/>
                                            </Border>
                                            <TextBlock FontSize="19" FontWeight="Bold" Foreground="{Binding SubjectColor}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center">
                                                <Run Text="{Binding DisplaySubject, Mode=OneWay}"/>
                                                <Run Text="{Binding WeekTag}" FontSize="12" Foreground="#9CA3AF" FontWeight="Normal"/>
                                            </TextBlock>
                                        </DockPanel>
                                        <TextBlock FontSize="13" Foreground="#4B5563" Tag="TeacherTag" Cursor="Hand"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   ToolTip="双击可切换到该教师 / 班级的课表">
                                            <Run Text="{Binding TeacherPrefix}" FontWeight="Bold"/>
                                            <Run Text="{Binding Teacher}"/>
                                            <Run Text="{Binding LocationText}" Foreground="#2E8B57"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 固定时段行（大课间 / 眼保健操 / 午休）：单行灰色横条，左边名称、右边时间 -->
        <DataTemplate x:Key="FixedRowTpl">
            <Border Background="{Binding CardBg}" CornerRadius="8" Padding="9,4" Margin="0,0,0,6">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding PeriodText}" FontSize="13"
                               Foreground="#6B7280" VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding TimeRange}" FontSize="11"
                               Foreground="#9CA3AF" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Border Background="#FFFFFF" CornerRadius="14" BorderBrush="#D8DEE9" BorderThickness="1"
            Margin="0" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 头部：班级（双击换班级）/ 日期（双击换日期）/ 单双周·星期；空白处按住可拖动整个窗口 -->
            <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource PrimaryBrush}" CornerRadius="14,14,0,0" Padding="14,9"
                    ToolTip="按住空白处可拖动窗口；拖动窗口边沿可改变大小">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <!-- 班级/教师区：双击切换 -->
                        <StackPanel x:Name="ClassHeader" Background="Transparent" Cursor="Hand"
                                   MouseLeftButtonDown="ClassHeader_MouseLeftButtonDown"
                                   ToolTip="双击此处可切换显示其他班级课表">
                            <TextBlock x:Name="TxtClass" FontSize="23" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                        <!-- 日期区：双击切换显示其他日期（调休上课） -->
                        <StackPanel x:Name="DateHeader" Background="Transparent" Cursor="Hand" Margin="0,3,0,0"
                                   MouseLeftButtonDown="DateHeader_MouseLeftButtonDown"
                                   ToolTip="双击此处可切换显示其他日期（调休上课）">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtDate" Grid.Column="0" FontSize="14" Foreground="#E3ECFB"
                                           TextTrimming="CharacterEllipsis"/>
                                <!-- 实时时钟：紧跟在日期后面（靠左），字号小一号、颜色略淡；关闭时不占位。
                                     ★ 不能靠右对齐：标题栏右上角是「自动隐藏 / 更新课表」两个按钮，
                                       时钟贴到右边就会跟按钮叠在一起（宽度一变就互相压字）。 -->
                                <TextBlock x:Name="TxtClock" Grid.Column="1" FontSize="12" Foreground="#B9CBEA"
                                           HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                           Margin="10,0,0,2" Visibility="Collapsed" ToolTip="当前时间"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <TextBlock x:Name="TxtWeek" FontSize="14" Foreground="#E3ECFB" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- 右侧操作区：自动隐藏 / 常驻显示 与 更新课表 上下排列，同白底半透明风格，整齐显眼 -->
                    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Right">
                        <Button x:Name="BtnHide" Content="自动隐藏" Click="BtnHide_Click"
                                VerticalAlignment="Top" Padding="8,3" FontSize="12" Margin="0,0,0,4"
                                Background="#33FFFFFF" Foreground="White" BorderBrush="#66FFFFFF"
                                ToolTip="点「自动隐藏」可切换为靠边自动隐藏（鼠标移到屏幕边沿滑出）；点「常驻显示」则始终常驻屏幕最前"/>
                        <Button x:Name="BtnQaUpdate" Click="BtnQaUpdate_Click"
                                VerticalAlignment="Top" Padding="8,3" FontSize="12"
                                Background="#33FFFFFF" Foreground="White" BorderBrush="#66FFFFFF"
                                ToolTip="立即从数据源检查并应用最新的课表 / 调代课">
                            <TextBlock x:Name="TxtQaUpdate" Text="更新课表"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 课表滚动区（紧凑，减小内边距与字号，留出更多底部空间）。
                 滚动条 Hidden 而不是 Disabled：内容超长时仍能用滚轮 / 手指拖动滚动，
                 只是不显示那条灰白竖条 —— 悬浮窗本来就窄，一条滚动条要吃掉十几个像素，
                 而且教室屏幕大、课表通常一屏放得下，滚动条更多是"没内容也不该出现的装饰"。 -->
            <ScrollViewer Grid.Row="1" Margin="10" VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel>
                    <ItemsControl x:Name="TodayPanel">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 固定时段（大课间/眼保健操/午休）走单行横条模板，其余走课程卡模板 -->
                                <ContentControl Content="{Binding}" HorizontalContentAlignment="Stretch">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <Setter Property="ContentTemplate" Value="{StaticResource LessonRowTpl}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFixed}" Value="True">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource FixedRowTpl}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 状态栏：课表更新时间 + 更新失败红字，拼成一条字幕；文字比宽度长时自动匀速滚过，
                 放得下就静态显示（短句滚动反而难读）。右侧「背景：已设/未设」固定不动，方便一眼看到 -->
            <Border Grid.Row="2" Background="#F7F9FC" BorderBrush="#E3E8EF" BorderThickness="0,1,0,0"
                    Padding="10,4" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 字幕视口：Canvas 让文字按真实宽度排版（不被窗口宽度挤断），ClipToBounds 负责裁边 -->
                    <Canvas x:Name="MarqueeView" Grid.Column="0" Height="15" ClipToBounds="True"
                            SizeChanged="MarqueeView_SizeChanged">
                        <TextBlock x:Name="TxtMarquee" Canvas.Top="0" FontSize="11" Foreground="#8A94A6"
                                   VerticalAlignment="Center" TextWrapping="NoWrap">
                            <TextBlock.RenderTransform>
                                <TranslateTransform X="0"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Canvas>

                    <TextBlock x:Name="TxtWpState" Grid.Column="1" FontSize="11" Foreground="#8A94A6"
                               VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                               Text="未设为背景"/>
                </Grid>
            </Border>

            <!-- 底部应用快捷栏：常用软件 / 文件夹入口，点击直达；图标模式 + 大小可在「布局设置 → 课表」或右下「管理」里调 -->
            <Border Grid.Row="3" Background="#F5F7FA" BorderBrush="#E3E8EF" BorderThickness="0,1,0,0"
                    Padding="8,6">
                <StackPanel>
                    <!-- 内置快捷：作业 / 缺交 / 便签。三个都是「图标 + 两个字」，宽度天然一致、一眼能认。
                         按账号权限显示，没权限的整条隐藏（更新课表已移至标题栏） -->
                    <WrapPanel x:Name="BuiltinWrap" Orientation="Horizontal">
                        <Button x:Name="BtnQaHomework" Style="{StaticResource QuickActionBtn}" Click="BtnQaHomework_Click"
                                Background="#EAF2FD" BorderBrush="#9EC1F0"
                                ToolTip="打开「作业公示」便签，可以直接编辑各科作业内容">
                            <TextBlock Text="📋 作业"/>
                        </Button>
                        <Button x:Name="BtnQaMissing" Style="{StaticResource QuickActionBtn}" Click="BtnQaMissing_Click"
                                Background="#FFF4E5" BorderBrush="#F0C48A"
                                ToolTip="打开「缺交作业名单」便签，可以直接登记谁没交">
                            <TextBlock Text="📝 缺交"/>
                        </Button>
                        <Button x:Name="BtnQaNote" Style="{StaticResource QuickActionBtn}" Click="BtnQaNote_Click"
                                Background="#F2EDFD" BorderBrush="#BFAFE8"
                                ToolTip="打开自定义便签（教师寄语 / 温馨提示等）；还没有便签时会新建一张">
                            <TextBlock Text="📌 便签"/>
                        </Button>
                        <Button x:Name="BtnQaCountdown" Style="{StaticResource QuickActionBtn}" Click="BtnQaCountdown_Click"
                                Background="#FFF8E1" BorderBrush="#E8CE8A"
                                ToolTip="打开倒计时便签（期末考试 / 运动会还有几天）；还没有事件时会直接弹出编辑窗口">
                            <TextBlock Text="⏳ 倒数"/>
                        </Button>
                        <Button x:Name="BtnQaDuty" Style="{StaticResource QuickActionBtn}" Click="BtnQaDuty_Click"
                                Background="#E8F5E9" BorderBrush="#A5CFA8"
                                ToolTip="打开值日生名单便签；还没有安排时会直接弹出编辑窗口">
                            <TextBlock Text="🧹 值日"/>
                        </Button>
                        <Button x:Name="BtnQaSettings" Style="{StaticResource QuickActionBtn}" Click="BtnQaSettings_Click"
                                Background="#EEF1F5" BorderBrush="#B9C2CE"
                                ToolTip="打开控制面板的「显示设置」页（字号、颜色、悬浮窗、手写球等都在这里）">
                            <TextBlock Text="⚙ 设置"/>
                        </Button>
                    </WrapPanel>

                    <TextBlock x:Name="TxtQlEmpty" Text="点击下方「＋」添加常用软件 / 文件夹"
                               FontSize="11" Foreground="#9CA3AF" Margin="2,0,0,4"
                               Visibility="Collapsed"/>
                    <WrapPanel x:Name="QlWrap" Orientation="Horizontal"/>
                    <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button x:Name="BtnAddFolder" Content="＋ 文件夹" Click="BtnAddFolder_Click" Padding="6,2" FontSize="11"
                                Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}"/>
                        <Button x:Name="BtnAddQl" Content="＋ 程序" Click="BtnAddQl_Click" Padding="6,2" FontSize="11" Margin="6,0,0,0"
                                Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}"/>
                        <Button x:Name="BtnQlManage" Content="管理" Click="BtnQlManage_Click" Padding="6,2" FontSize="11" Margin="6,0,0,0"
                                Background="White" BorderBrush="#D1D5DB"
                                ToolTip="管理快捷方式：增删、仅显示图标、调整图标大小"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 最下方：置顶（最左，与便签同风格同功能，切换始终置顶）/ 锁定 + 位置 / 桌面背景（右侧）。
                 注意：标题栏「自动隐藏 / 常驻显示」管的是「是否始终显示（不靠边隐藏）」，本处「置顶」管的是「是否始终在最上层」，
                 两者语义不同，故各保留一个按钮，不冲突。 -->
            <Border Grid.Row="4" Background="{DynamicResource PrimaryLightBrush}" BorderBrush="#E3E8EF" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12" Padding="10,7">
                <DockPanel LastChildFill="False">
                    <Button x:Name="BtnTop" DockPanel.Dock="Left" Content="置顶" Click="BtnTop_Click"
                            Padding="8,3" FontSize="11" Margin="6,0,0,0"
                            Background="White" BorderBrush="#D1D5DB" Foreground="Black"
                            ToolTip="切换置顶（始终显示在所有窗口最上层）/ 普通层级"/>
                    <Button x:Name="BtnLock" DockPanel.Dock="Left" Content="🔓" Click="BtnLock_Click"
                            Padding="10,4" FontSize="12" Margin="6,0,0,0" Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}"
                            ToolTip="锁定后不能移动 / 缩放 / 编辑，防止误操作"/>
                    <!-- 主操作「设为背景」放最右（与便签一致）；「位置」用于在排版窗口里微调 -->
                    <Button x:Name="BtnWp" DockPanel.Dock="Right" Content="设为背景" Click="BtnWp_Click"
                            Padding="10,4" FontSize="12" Margin="6,0,0,0" Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}"
                            ToolTip="按「现在的位置和大小」一键设为桌面背景，并把本悬浮课表改为靠边自动隐藏。要取消：布局设置 → 桌面背景 取消勾选"/>
                    <Button x:Name="BtnPos" DockPanel.Dock="Right" Content="位置" Click="BtnPos_Click"
                            Padding="10,4" FontSize="12" Margin="6,0,0,0" Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}"
                            ToolTip="在模拟屏幕上拖动便签，微调桌面背景里课表的位置与大小"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
