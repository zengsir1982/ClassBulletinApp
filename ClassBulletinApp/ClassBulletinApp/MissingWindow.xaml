<Window x:Class="ClassBulletinApp.MissingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="缺交作业名单" WindowStyle="None" ResizeMode="CanResize"
        ShowInTaskbar="False" AllowsTransparency="True" Background="Transparent"
        Width="380" Height="420" MinWidth="220" MinHeight="200"
        Loaded="Window_Loaded" SourceInitialized="Window_SourceInitialized"
        LocationChanged="Window_LocationChanged" SizeChanged="Window_SizeChanged">
    <Border x:Name="NoteBorder" CornerRadius="12" BorderThickness="1"
            Background="#FCE4EC" BorderBrush="#F8BBD0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" Opacity="0.35" ShadowDepth="4" Direction="300"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部条：标题 + 隐藏 -->
            <Border x:Name="Header" Grid.Row="0" CornerRadius="11,11,0,0" Padding="12,8" Background="#F8BBD0">
                <DockPanel LastChildFill="True">
                    <Button x:Name="BtnHide" DockPanel.Dock="Right" Content="✕" Click="BtnHide_Click"
                            Padding="6,2" FontSize="12" Margin="8,0,0,0"
                            Background="#33FFFFFF" Foreground="#AD1457" BorderBrush="#55FFFFFF"
                            ToolTip="隐藏便签（可在控制面板或托盘重新打开）"/>
                    <TextBlock x:Name="TxtTitle" Text="缺交作业名单" FontSize="17" FontWeight="Bold"
                               Foreground="#AD1457" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <!-- 内容：只读展示（双击任意处弹出编辑对话框） -->
            <ScrollViewer Grid.Row="1" Margin="12,10" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ContentPanel"/>
            </ScrollViewer>

            <!-- 底部：位置设置 + 置顶 + 锁定 + 桌面背景开关 -->
            <Border Grid.Row="2" Padding="10,6" BorderThickness="0,1,0,0"
                    BorderBrush="#22000000" Background="#12000000">
                <DockPanel LastChildFill="True">
                    <Button x:Name="BtnPos" DockPanel.Dock="Left" Content="位置" Click="BtnPos_Click"
                            Padding="8,3" FontSize="11" ToolTip="调整缺交名单在桌面背景上的位置与大小"/>
                    <Button x:Name="BtnTop" DockPanel.Dock="Left" Content="置顶" Click="BtnTop_Click"
                            Padding="8,3" FontSize="11" Margin="6,0,0,0"
                            ToolTip="切换置顶显示（置于所有窗口之上 / 普通层级）"/>
                    <Button x:Name="BtnLock" DockPanel.Dock="Left" Content="🔓" Click="BtnLock_Click"
                            Padding="8,3" FontSize="11" Margin="6,0,0,0"
                            ToolTip="锁定后不能移动 / 缩放 / 编辑，防止误操作"/>
                    <Button x:Name="BtnWp" DockPanel.Dock="Right" Content="桌面背景：关" Click="BtnWp_Click"
                            Padding="8,3" FontSize="11" Margin="6,0,0,0"
                            ToolTip="把缺交作业名单画到桌面壁纸上（位于所有窗口之下，不遮挡操作）"/>
                    <TextBlock x:Name="TxtHint" Text="拖动摆放 · 拉边沿改大小 · 双击编辑" FontSize="11"
                               Foreground="#8E5A66" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
