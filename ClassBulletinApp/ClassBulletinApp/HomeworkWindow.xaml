<Window x:Class="ClassBulletinApp.HomeworkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="作业公示" WindowStyle="None" ResizeMode="CanResize"
        ShowInTaskbar="False" AllowsTransparency="True" Background="Transparent"
        Width="380" Height="540" MinWidth="220" MinHeight="240"
        Loaded="Window_Loaded" SourceInitialized="Window_SourceInitialized"
        LocationChanged="Window_LocationChanged" SizeChanged="Window_SizeChanged">
    <Border x:Name="NoteBorder" CornerRadius="12" BorderThickness="1"
            Background="#FFF9C4" BorderBrush="#F0DFA0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" Opacity="0.35" ShadowDepth="4" Direction="300"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部条：标题 + 隐藏 -->
            <Border x:Name="Header" Grid.Row="0" Style="{StaticResource FloatHeader}" Background="#FFE082">
                <DockPanel LastChildFill="True">
                    <Button x:Name="BtnHide" DockPanel.Dock="Right" Content="✕" Click="BtnHide_Click"
                            Style="{StaticResource FloatCloseButton}" Foreground="#5D4037"
                            ToolTip="隐藏便签（可在控制面板或托盘重新打开）"/>
                    <TextBlock x:Name="TxtTitle" Text="各科作业公示" Style="{StaticResource FloatTitle}"
                               Foreground="#5D4037"/>
                </DockPanel>
            </Border>

            <!-- 内容：只读展示（双击任意处弹出编辑对话框） -->
            <ScrollViewer Grid.Row="1" Margin="12,10" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ContentPanel"/>
            </ScrollViewer>

            <!-- 底部：位置设置 + 置顶 + 锁定 + 桌面背景开关 -->
            <Border x:Name="Footer" Grid.Row="2" Style="{StaticResource FloatFooter}">
                <DockPanel LastChildFill="True">
                    <Button x:Name="BtnTop" DockPanel.Dock="Left" Content="置顶" Click="BtnTop_Click"
                            Style="{StaticResource FloatFooterButton}"
                            ToolTip="切换置顶显示（置于所有窗口之上 / 普通层级）"/>
                    <Button x:Name="BtnLock" DockPanel.Dock="Left" Content="🔓" Click="BtnLock_Click"
                            Style="{StaticResource FloatFooterButton}" Margin="6,0,0,0"
                            ToolTip="锁定后不能移动 / 缩放 / 编辑，防止误操作"/>
                    <!-- 主操作「设为背景」放最右；「位置」用于在排版窗口里微调 -->
                    <Button x:Name="BtnWp" DockPanel.Dock="Right" Content="设为背景" Click="BtnWp_Click"
                            Style="{StaticResource FloatFooterButton}" Margin="6,0,0,0"
                            ToolTip="按「现在的位置和大小」一键设为桌面背景，并隐藏本便签。要取消：布局设置 → 桌面背景 取消勾选"/>
                    <Button x:Name="BtnPos" DockPanel.Dock="Right" Content="位置" Click="BtnPos_Click"
                            Style="{StaticResource FloatFooterButton}" Margin="6,0,0,0"
                            ToolTip="在模拟屏幕上拖动便签，微调桌面背景里作业公示的位置与大小"/>
                    <TextBlock x:Name="TxtHint" Text="拖动·拉边改大小·双击编辑" FontSize="11"
                               Foreground="#6B5B33" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
