<Window x:Class="ClassBulletinApp.FullScreenReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="课表有变化" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" WindowStartupLocation="Manual"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize">
    <!-- 半透明遮罩：整块屏幕压暗，中间浮一张大字卡片；点任意处立即关闭 -->
    <Grid x:Name="Root" Background="#B3000000" MouseLeftButtonDown="Root_Click">
        <Border x:Name="Card" Background="White" CornerRadius="24" Padding="56,40" MaxWidth="1200"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="#8FB4EE" BorderThickness="2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="46" ShadowDepth="8" Opacity="0.45"/>
            </Border.Effect>
            <StackPanel>
                <Border x:Name="TagBorder" Background="#FFF3CD" CornerRadius="10" Padding="14,6" HorizontalAlignment="Center"
                        BorderBrush="#E6C25A" BorderThickness="1">
                    <TextBlock x:Name="TxtTag" Text="课表有变化" FontSize="22" FontWeight="Bold" Foreground="#8A6100"/>
                </Border>
                <TextBlock x:Name="TxtTitle" FontSize="54" FontWeight="Bold" Foreground="#1F2A37"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,26,0,0"/>
                <TextBlock x:Name="TxtDetail" FontSize="24" Foreground="#4B5563"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,0"/>
                <TextBlock x:Name="TxtHint" Text="点击任意位置关闭" FontSize="15" Foreground="#9CA3AF"
                           TextAlignment="Center" Margin="0,26,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
