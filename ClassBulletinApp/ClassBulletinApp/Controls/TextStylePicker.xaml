<UserControl x:Class="ClassBulletinApp.Controls.TextStylePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             VerticalAlignment="Center">
    <!--
        统一的「字号 + 颜色 + 加粗 + 调色 + 预览」一行控件。
        作业 / 缺交 / 自定义便签 / 倒计时 / 值日生的样式设置全部用它，
        免得每个窗口各写一套下拉，设置区越堆越长、排版还不一致。
    -->
    <StackPanel x:Name="Root" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="Lbl" Text="" FontSize="13" Foreground="#4B5563"
                   VerticalAlignment="Center" Margin="0,0,8,0"/>

        <CheckBox x:Name="ChkBold" Content="加粗" FontSize="13" Foreground="#374151"
                  VerticalAlignment="Center" Margin="0,0,10,0"
                  ToolTip="勾选后这段文字加粗显示"
                  Checked="Bold_Changed" Unchecked="Bold_Changed"/>

        <ComboBox x:Name="CbSize" Width="84" FontSize="13" VerticalAlignment="Center"
                  DisplayMemberPath="Name"
                  SelectedValuePath="Level"
                  ToolTip="字号档位（标准 / 小 / 大 / 特大 / 更小 / 超大 / 巨大）"
                  SelectionChanged="Size_Changed"/>

        <ComboBox x:Name="CbColor" Width="112" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0"
                  SelectedValuePath="Value"
                  ToolTip="文字颜色；「跟随主题」表示用便签主题自带的配色"
                  SelectionChanged="Color_Changed">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="12" Height="12" CornerRadius="2" Margin="0,0,6,0"
                                BorderBrush="#33000000" BorderThickness="1"
                                Background="{Binding Swatch}"/>
                        <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Button x:Name="BtnPick" Content="调色…" Padding="8,2" FontSize="12" Margin="6,0,0,0"
                Background="White" BorderBrush="#D1D5DB" Foreground="#374151"
                ToolTip="从系统调色板里选任意颜色（选过的颜色会留在下拉里）"
                Click="BtnPick_Click"/>

        <!-- 实时预览：字号 / 颜色 / 粗细都跟着变，所见即所得 -->
        <Border x:Name="PreviewBox" Margin="12,0,0,0" Padding="8,3" CornerRadius="6"
                Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1"
                VerticalAlignment="Center">
            <TextBlock x:Name="TxtPreview" Text="预览" FontSize="17" Foreground="#333B47"
                       TextTrimming="CharacterEllipsis" MaxWidth="150"/>
        </Border>
    </StackPanel>
</UserControl>
