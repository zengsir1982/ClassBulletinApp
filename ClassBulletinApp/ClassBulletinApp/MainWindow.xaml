<Window x:Class="ClassBulletinApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClassBulletinApp"
        Title="班级公布栏 · 控制面板" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" KeyDown="Window_KeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinWidth" Value="132"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 顶层容器：DockPanel 主体 + 锁定覆盖层 -->
        <DockPanel>
            <!-- 顶部工具栏（精简：班级 / 独立周窗口） -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource PrimaryBrush}" Padding="14,10">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="📋 班级公布栏" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="LblTeacher" Text="教师：" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="14"/>
                        <ComboBox x:Name="CbTeacher" Width="172" FontSize="14" Margin="0,0,14,0"
                                  IsEditable="True" IsTextSearchEnabled="False"
                                  TextBoxBase.TextChanged="CbTeacher_TextChanged"
                                  SelectionChanged="CbTeacher_SelectionChanged"
                                  LostFocus="CbTeacher_LostFocus"
                                  ToolTip="可直接输入教师姓名查询筛选；选择后悬浮课表切换为该教师的个人课表"/>
                        <TextBlock Text="班级：" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="14"/>
                        <ComboBox x:Name="CbClass" Width="150" FontSize="14" SelectionChanged="CbClass_SelectionChanged" Margin="0,0,8,0"
                                  ToolTip="选择班级后悬浮课表切换为该班的课表"/>
                        <TextBlock x:Name="TxtCurrentMode" Foreground="#FFE9A8" VerticalAlignment="Center" FontSize="13" Margin="6,0,0,0"/>
                        <TextBlock Text="开学周" Foreground="White" VerticalAlignment="Center" Margin="20,0,6,0" FontSize="14"/>
                        <DatePicker x:Name="DpSemester" Width="132" FontSize="13" VerticalAlignment="Center" SelectedDateFormat="Short"
                                    SelectedDateChanged="DpSemester_SelectedDateChanged"
                                    ToolTip="开学第一周星期一：用于计算「第几周」教学周，与学校开学时间对齐。"/>
                        <CheckBox x:Name="ChkAutoStartTitle" Content="开机自启" Foreground="White" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="14"
                                  Checked="ChkAutoStartTitle_Changed" Unchecked="ChkAutoStartTitle_Changed"
                                  ToolTip="把本程序写入当前用户开机启动项"/>
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!-- 底部状态栏（常驻） -->
            <Border DockPanel.Dock="Bottom" Background="#F5F7FA" BorderBrush="#E3E8EF" BorderThickness="0,1,0,0" Padding="14,8">
                <TextBlock x:Name="TxtStatus" FontSize="14" Foreground="#C0392B" TextWrapping="Wrap"/>
            </Border>

            <!-- 主体：标签页归类 -->
            <TabControl x:Name="MainTabs" Margin="10" SelectionChanged="MainTabs_SelectionChanged">
                <!-- 课表：直接周视图（右键安排调代课；单击已安排格二次确认清除） -->
                <TabItem Header="周课程表">
                    <local:WeekView x:Name="WeekViewManage" Mode="Manage"/>
                </TabItem>

                <!-- 数据管理 -->
                <TabItem Header="数据管理">
                    <ScrollViewer Margin="14">
                        <StackPanel>
                            <!-- 两列：左边「课表数据」，右边「数据包分发 / 自动更新」——
                                 单列排下来在 1366×768 的教室屏上要滚两屏，自动更新状态会被藏在最底下 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" MaxWidth="400" Margin="0,0,32,0">
                                    <TextBlock Text="课表数据" FontSize="20" FontWeight="Bold" Foreground="#1F2A37" Margin="0,0,0,12"/>
                                    <Button x:Name="BtnImport" Content="导入课表（全校总课程表）" Margin="0,0,0,10" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Click="BtnImport_Click"/>
                                    <Button x:Name="BtnImportTemp" Content="导入临时课表（含 调 / 代 标记）" Margin="0,0,0,10" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Background="#E8F6EE" BorderBrush="#7FC99A" Click="BtnImportTemp_Click"/>
                                    <Button x:Name="BtnImportSingle" Content="导入单个班级课表（单班适用）" Margin="0,0,0,10" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}" Click="BtnImportSingle_Click"/>
                                    <Button x:Name="BtnImportTeacher" Content="导入单个教师课表（教师个人适用）" Margin="0,0,0,10" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}" Click="BtnImportTeacher_Click"/>
                                    <Button x:Name="BtnClearOverrides" Content="清除临时调课 / 代课…（本周 / 指定范围 / 全部）" Margin="0,0,0,10" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Background="#FDE8E8" BorderBrush="#E0A0A0" Click="BtnClearOverrides_Click"/>
                                    <Button x:Name="BtnRestoreSuspended" Content="恢复被主机停用的本机调课…" Margin="0,0,0,10" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Background="#FFF7E6" BorderBrush="#E0C080" Click="BtnRestoreSuspended_Click"/>
                                    <Button x:Name="BtnClearImported" Content="一键清除全部导入数据（课表 / 教师 / 调代）" Margin="0,0,0,0" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Background="#FDE8E8" BorderBrush="#E0A0A0" Click="BtnClearImported_Click"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" MaxWidth="600">
                                    <TextBlock Text="数据包分发（离线版 / 多教室机同步）" FontSize="17" FontWeight="Bold" Foreground="#1F2A37" Margin="0,0,0,10"/>
                                    <Button x:Name="BtnExportPackage" Content="导出数据包（发到其他教室机）" Margin="0,0,0,10" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Background="#EAF2FD" BorderBrush="#9EC1F0" Click="BtnExportPackage_Click"/>
                                    <Button x:Name="BtnImportPackage" Content="导入数据包（接收校务课表更新）" Margin="0,0,0,10" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Background="#E8F6EE" BorderBrush="#7FC99A" Click="BtnImportPackage_Click"/>
                                    <Button x:Name="BtnBackup" Content="备份与恢复" Margin="0,0,0,20" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Click="BtnBackup_Click"/>

                                    <TextBlock Text="自动更新（共享文件夹 / FTP）" FontSize="17" FontWeight="Bold" Foreground="#1F2A37" Margin="0,0,0,10"/>
                                    <Button x:Name="BtnUpdateSettings" Content="自动更新设置…" Margin="0,0,0,10" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}" Click="BtnUpdateSettings_Click"/>
                                    <Button x:Name="BtnUpdateCheck" Content="立即检查更新" Margin="0,0,0,10" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Click="BtnUpdateCheck_Click"/>
                                    <Button x:Name="BtnPublishNow" Content="发布到数据源（供其他教室机更新）" Margin="0,0,0,10" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Click="BtnPublishNow_Click"/>
                                    <TextBlock x:Name="TxtUpdateStatus" Text="自动更新：未配置" FontSize="13" Foreground="#4B5563" TextWrapping="Wrap" Margin="0,2,0,12" LineHeight="19"/>
                                    <TextBlock Text="勾选「本机兼任发布机」并指定 source 目录后，程序会把该目录里的 Excel（临时课表文件名需以日期开头，如 2026-10-26_临时课表_八年级.xlsx）打包上传；其余教室机定时读取 publish 目录自动更新。连不上数据源时继续用本地数据，不影响使用。" FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,8" LineHeight="19"/>
                                    <TextBlock Text="数据包只包含全校一致的内容：基础课表、调代课、标记为「全校」的通知、开学周等。本机的显示班级、窗口布局、密码、作业公示、缺交名单、自定义便签不会被打包，也不会被覆盖。" FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,8" LineHeight="19"/>
                                    <TextBlock Text="每次导入数据包前会自动备份当前数据到 backup 目录（保留最近 20 份），可在「备份与恢复」里回滚。" FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,0" LineHeight="19"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="说明：先「导入课表」得到基础课表；再用「导入临时课表」自动识别带（调）/（代）标记的课并生成调代覆盖（仅替换导入来源，保留手动修改）。" FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,18,0,10" LineHeight="20"/>
                            <TextBlock Text="若只有一个班级使用本软件，可直接「导入单个班级课表」（如 八年级X班-班级课程表.xlsx），将仅包含该班课表。" FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="20"/>
                            <TextBlock Text="导入全校总课表 / 单班课表时，会自动按任课教师反向整理出「教师个人课表」（教师人数多时可在顶栏输入姓名查询），选中教师即显示其个人课表，每节课显示所教班级。教师个人也可单独导入自己的课表文件。" FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,10" LineHeight="20"/>
                            <TextBlock Text="调课 / 代课记录可在「周课程表」标签的周视图中右键安排；需要整体清除时使用「清除全部临时调课 / 代课」按钮。" FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" LineHeight="20"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 显示设置 -->
                <TabItem Header="显示设置">
                    <ScrollViewer Margin="14" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="900">
                            <TextBlock Text="悬浮窗与展示" FontSize="20" FontWeight="Bold" Foreground="#1F2A37" Margin="0,0,0,4"/>
                            <TextBlock Text="作业便签、缺交名单便签的显示 / 隐藏，统一在「作业公示」标签页里开关，这里不再重复放。"
                                       FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,14"/>

                            <!-- ① 悬浮窗 -->
                            <Border Background="#F7F9FC" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="10" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="① 悬浮窗" FontSize="15" FontWeight="Bold" Foreground="#1F2A37"/>
                                    <WrapPanel Orientation="Horizontal" Margin="0,12,0,2">
                                        <Button x:Name="BtnToggleSch" Content="课表悬浮：关" Style="{StaticResource TabBtn}" Click="BtnToggleSch_Click"
                                                Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}"/>
                                        <Button x:Name="BtnToggleNot" Content="通知悬浮：关" Style="{StaticResource TabBtn}" Click="BtnToggleNot_Click"
                                                Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}"/>
                                        <Button x:Name="BtnLayout" Content="布局设置…" Style="{StaticResource TabBtn}" Click="BtnLayout_Click"
                                                ToolTip="透明度、置顶、鼠标穿透、自动靠边隐藏，以及恢复默认位置"/>
                                        <Button x:Name="BtnSettings" Content="启动选项…" Style="{StaticResource TabBtn}" Click="BtnSettings_Click"
                                                ToolTip="开机自启、启动即全屏 / 锁定、启动时自动弹出哪些悬浮窗"/>
                                        <Button x:Name="BtnTrayMenu" Content="任务栏菜单…" Style="{StaticResource TabBtn}" Click="BtnTrayMenu_Click"
                                                ToolTip="自定义托盘图标右键菜单：默认只保留「打开控制面板 / 用户中心 / 退出」，可自行增删与改名"/>
                                    </WrapPanel>
                                    <CheckBox x:Name="ChkMaxHide" Content="桌面有窗口最大化时，自动隐藏课表与通知（避免遮挡正在使用的程序）"
                                              FontSize="14" Foreground="#1F2A37" Margin="2,6,0,0" Click="ChkMaxHide_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- ② 展示控制 -->
                            <Border Background="#F7F9FC" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="② 展示控制" FontSize="15" FontWeight="Bold" Foreground="#1F2A37"/>
                                    <WrapPanel Orientation="Horizontal" Margin="0,12,0,2">
                                        <Button x:Name="BtnFull" Content="全屏展示" Style="{StaticResource TabBtn}" Click="BtnFull_Click"
                                                ToolTip="隐藏控制面板，只留课表 / 通知 / 便签在屏幕上"/>
                                        <Button x:Name="BtnLock" Content="锁定（防误触）" Style="{StaticResource TabBtn}" Click="BtnLock_Click"
                                                ToolTip="锁定后屏幕上的一切点击都不生效，按 Ctrl+L 解锁"/>
                                        <Button x:Name="BtnHideTray" Content="隐藏到托盘" Style="{StaticResource TabBtn}" Click="BtnHideTray_Click"
                                                ToolTip="把控制面板收到右下角托盘，双击图标可再打开"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- ③ 界面主题 -->
                            <Border Background="#F7F9FC" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="③ 界面主题" FontSize="15" FontWeight="Bold" Foreground="#1F2A37"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <TextBlock Text="配色方案" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox x:Name="CbTheme" Width="200" FontSize="14" SelectionChanged="CbTheme_SelectionChanged"/>
                                        <Button x:Name="BtnThemeReset" Content="恢复默认" Padding="12,7" FontSize="13" Margin="12,0,0,0"
                                                Click="BtnThemeReset_Click" Background="White" BorderBrush="#D1D5DB" Cursor="Hand"/>
                                    </StackPanel>
                                    <TextBlock Text="桌面背景（当天课表 / 作业公示 / 缺交名单 / 自定义便签）的位置、主题与固定大小，统一在「布局设置 → 桌面背景」标签页调整。"
                                               FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    <Button x:Name="BtnCancelBackdrop" Content="取消桌面背景（恢复悬浮窗）…" Padding="14,7" FontSize="13"
                                            HorizontalAlignment="Left" Margin="0,10,0,0" Background="#FDE8E8" BorderBrush="#E0A0A0" Cursor="Hand"
                                            ToolTip="撤掉画在壁纸上的课表 / 便签，恢复系统原壁纸，并把当初隐藏的课表 / 便签放回悬浮窗"
                                            Click="BtnCancelBackdrop_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- ④ 课表周视图：周起始日已移到「周课程表」标签的工具栏（清除本周调课右边），此处不再重复 -->

                            <!-- 操作提示（保留原有说明，压缩成一段） -->
                            <Border Background="#F4F8FF" BorderBrush="{DynamicResource PrimaryBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="操作提示" FontSize="14" FontWeight="Bold" Foreground="#1F2A37"/>
                                    <TextBlock Text="位置和大小不用进设置页调：按住悬浮课表的标题区拖动即可移动，鼠标移到窗口边沿出现双向箭头时拖动即可改变大小，松手自动记住。"
                                               FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <TextBlock Text="自动隐藏默认把窗口完全移出屏幕，只把鼠标移到 / 手指触到屏幕对应边沿时才平滑滑出；需要保留一条可点细边时，可在布局设置里把「露出像素」调成 1~48。"
                                               FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="顶栏「教师 / 班级」下拉、或双击悬浮课表标题的姓名位置，都可在班级课表与教师个人课表之间自由切换。「常驻显示」为半透明常驻，如需纯展示可在布局设置勾选「鼠标穿透」。"
                                               FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 提醒设置（独立标签页） -->
                <TabItem Header="提醒设置">
                    <ScrollViewer Margin="14">
                        <StackPanel MaxWidth="780">
                            <TextBlock Text="⏰ 上下课提醒" FontSize="20" FontWeight="Bold" Foreground="#1F2A37" Margin="0,0,0,4"/>
                            <TextBlock Text="依据当前显示的班级 / 教师课表（含临时课表调 / 代安排）到点提醒；调休日按「显示日」的课表提醒。同一提醒每天只弹一次。上课 / 下课 / 放学各自独立设置，文案与语音均可自定义。"
                                       FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <CheckBox x:Name="ChkRemindEnabled" Content="启用上下课提醒（总开关）"
                                      FontSize="15" FontWeight="Bold" Foreground="#1F2A37" Margin="0,0,0,12" Click="RemindSetting_Changed"/>

                            <TextBlock Text="文案占位符：{p}=节次　{s}=科目　{t}=时间(HH:mm)。可在下列框中自由改写。" FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <!-- 上课提醒 -->
                            <Border Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <CheckBox x:Name="ChkCsOn" Content="上课提醒（课前 / 上课）" FontSize="15" FontWeight="Bold" Foreground="#1F2A37" Click="RemindSetting_Changed"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="提前" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtCsLead" Width="56" FontSize="14" Margin="6,0" TextAlignment="Center" TextChanged="RemindSetting_TextChanged" ToolTip="提前多少秒提醒；0 = 仅在上课时刻提醒"/>
                                        <TextBlock Text="秒提醒（精确到秒）" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="提示语·标题" FontSize="13" VerticalAlignment="Center" Width="92"/>
                                        <TextBox x:Name="TxtCsTitle" FontSize="14" Padding="6" Width="500" Background="White" BorderBrush="#D1D5DB" TextChanged="RemindSetting_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="提示语·详情" FontSize="13" VerticalAlignment="Center" Width="92"/>
                                        <TextBox x:Name="TxtCsDetail" FontSize="14" Padding="6" Width="500" Background="White" BorderBrush="#D1D5DB" TextChanged="RemindSetting_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="语音内容" FontSize="13" VerticalAlignment="Center" Width="92"/>
                                        <TextBox x:Name="TxtCsVoice" FontSize="14" Padding="6" Width="500" Background="White" BorderBrush="#D1D5DB" TextChanged="RemindSetting_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="弹幕内容" FontSize="13" VerticalAlignment="Center" Width="92"/>
                                        <TextBox x:Name="TxtCsDanmaku" FontSize="14" Padding="6" Width="500" Background="White" BorderBrush="#D1D5DB" TextChanged="RemindSetting_TextChanged" ToolTip="留空则不向通知条推送弹幕"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 下课提醒 -->
                            <Border Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <CheckBox x:Name="ChkCeOn" Content="下课提醒（下课前 / 下课）" FontSize="15" FontWeight="Bold" Foreground="#1F2A37" Click="RemindSetting_Changed"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="提前" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtCeLead" Width="56" FontSize="14" Margin="6,0" TextAlignment="Center" TextChanged="RemindSetting_TextChanged" ToolTip="提前多少秒提醒；0 = 仅在下课时刻提醒"/>
                                        <TextBlock Text="秒提醒（精确到秒）" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="提示语·标题" FontSize="13" VerticalAlignment="Center" Width="92"/>
                                        <TextBox x:Name="TxtCeTitle" FontSize="14" Padding="6" Width="500" Background="White" BorderBrush="#D1D5DB" TextChanged="RemindSetting_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="提示语·详情" FontSize="13" VerticalAlignment="Center" Width="92"/>
                                        <TextBox x:Name="TxtCeDetail" FontSize="14" Padding="6" Width="500" Background="White" BorderBrush="#D1D5DB" TextChanged="RemindSetting_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="语音内容" FontSize="13" VerticalAlignment="Center" Width="92"/>
                                        <TextBox x:Name="TxtCeVoice" FontSize="14" Padding="6" Width="500" Background="White" BorderBrush="#D1D5DB" TextChanged="RemindSetting_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="弹幕内容" FontSize="13" VerticalAlignment="Center" Width="92"/>
                                        <TextBox x:Name="TxtCeDanmaku" FontSize="14" Padding="6" Width="500" Background="White" BorderBrush="#D1D5DB" TextChanged="RemindSetting_TextChanged" ToolTip="留空则不向通知条推送弹幕"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 放学提醒 -->
                            <Border Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <CheckBox x:Name="ChkAsOn" Content="放学提醒（当天最后一节结束后）" FontSize="15" FontWeight="Bold" Foreground="#1F2A37" Click="RemindSetting_Changed"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="提前" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtAsLead" Width="56" FontSize="14" Margin="6,0" TextAlignment="Center" TextChanged="RemindSetting_TextChanged" ToolTip="提前多少秒提醒；0 = 仅在下课时刻提醒"/>
                                        <TextBlock Text="秒提醒（精确到秒）" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="提示语·标题" FontSize="13" VerticalAlignment="Center" Width="92"/>
                                        <TextBox x:Name="TxtAsTitle" FontSize="14" Padding="6" Width="500" Background="White" BorderBrush="#D1D5DB" TextChanged="RemindSetting_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="提示语·详情" FontSize="13" VerticalAlignment="Center" Width="92"/>
                                        <TextBox x:Name="TxtAsDetail" FontSize="14" Padding="6" Width="500" Background="White" BorderBrush="#D1D5DB" TextChanged="RemindSetting_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="语音内容" FontSize="13" VerticalAlignment="Center" Width="92"/>
                                        <TextBox x:Name="TxtAsVoice" FontSize="14" Padding="6" Width="500" Background="White" BorderBrush="#D1D5DB" TextChanged="RemindSetting_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="弹幕内容" FontSize="13" VerticalAlignment="Center" Width="92"/>
                                        <TextBox x:Name="TxtAsDanmaku" FontSize="14" Padding="6" Width="500" Background="White" BorderBrush="#D1D5DB" TextChanged="RemindSetting_TextChanged" ToolTip="留空则不向通知条推送弹幕"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="弹窗显示" FontSize="14" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtRemindSeconds" Width="48" FontSize="14" Margin="6,0" TextAlignment="Center" TextChanged="RemindSetting_TextChanged" ToolTip="提醒窗口停留几秒后自动消失"/>
                                <TextBlock Text="秒" FontSize="14" VerticalAlignment="Center" Margin="0,0,26,0"/>
                                <CheckBox x:Name="ChkRemindSound" Content="提醒时播放提示音" FontSize="14" Click="RemindSetting_Changed"/>
                            </StackPanel>

                            <Border Background="#F4F8FF" BorderBrush="{DynamicResource PrimaryBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,14,0,0">
                                <StackPanel>
                                    <CheckBox x:Name="ChkRemindVoice" Content="🔊 语音播报（用系统语音朗读提醒内容）"
                                              FontSize="15" FontWeight="Bold" Foreground="#1F2A37" Click="RemindSetting_Changed"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <TextBlock Text="音色" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="CbRemindVoice" Width="340" FontSize="14" SelectionChanged="RemindVoice_Selected" ToolTip="系统已安装的语音；可到 Windows「设置 → 时间和语言 → 语音」安装更多音色"/>
                                        <Button x:Name="BtnVoiceTest" Content="试听" FontSize="13" Padding="12,4" Margin="10,0,0,0" Click="BtnVoiceTest_Click"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <TextBlock Text="语速" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Slider x:Name="SlVoiceRate" Minimum="-10" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Width="240" ValueChanged="RemindVoice_ValueChanged" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtVoiceRate" FontSize="13" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="音量" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Slider x:Name="SlVoiceVolume" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                                Width="240" ValueChanged="RemindVoice_ValueChanged" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtVoiceVolume" FontSize="13" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="音色来自 Windows 自带语音合成（SAPI）。列表中列出系统已安装的全部语音（如 Microsoft Huihui 中文女声等），可从中选择多种音色；选「系统默认」时自动优先使用中文语音。若列表为空或没有中文语音，请到「设置 → 时间和语言 → 语音」安装中文语音包。"
                                               FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 通知公告 -->
                <TabItem Header="通知公告">
                    <ScrollViewer Margin="14">
                        <StackPanel MaxWidth="640">
                            <TextBlock Text="📢 通知 / 公告管理" FontSize="20" FontWeight="Bold" Foreground="#1F2A37" Margin="0,0,0,12"/>

                            <!-- 通知条字体与背景：简单预设，选中即应用到顶部字幕条 -->
                            <Border Background="#F7F9FC" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="通知条字体与背景" FontSize="16" FontWeight="Bold" Foreground="#1F2A37"/>
                                    <TextBlock Text="在下面选好字体 / 字号 / 字色 / 背景，顶部通知字幕条立即生效（对所有通知统一生效）。字色与背景还能用「调色…」取任意颜色，取过的颜色会留在下拉里。"
                                               FontSize="12" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,2,0,10"/>
                                    <!-- 字体 / 字号 / 字色 / 背景：用 WrapPanel 排，窗口窄了自动换行，不会把右边挤出界面。
                                         字色与背景后面各跟一个「调色…」，可以取任意颜色（预设 20 多种仍保留）。 -->
                                    <WrapPanel Margin="0,6,0,2">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,6">
                                            <TextBlock Text="字体" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox x:Name="CbNotifFont" Width="178" FontSize="14" SelectionChanged="NotifStyle_Changed"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,6">
                                            <TextBlock Text="字号" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox x:Name="CbNotifSize" Width="84" FontSize="14" SelectionChanged="NotifStyle_Changed"
                                                      ToolTip="共 22 档（12～96）。字号选得很大时，如果通知条上下边缘把字切掉了，把通知条拖高一点即可"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,6">
                                            <TextBlock Text="字色" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox x:Name="CbNotifText" Width="132" FontSize="14" SelectionChanged="NotifStyle_Changed">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="2">
                                                            <Rectangle Width="16" Height="16" RadiusX="3" RadiusY="3" Fill="{Binding Swatch}" Stroke="#9AA3AF" StrokeThickness="1" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button x:Name="BtnNotifTextPick" Content="调色…" Padding="9,3" FontSize="12" Margin="6,0,0,0"
                                                    Background="White" BorderBrush="#D1D5DB" Click="BtnNotifTextPick_Click"
                                                    ToolTip="用系统取色器选任意字色（预设里没有的颜色也能用）"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                            <TextBlock Text="背景" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox x:Name="CbNotifBg" Width="132" FontSize="14" SelectionChanged="NotifStyle_Changed">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="2">
                                                            <Rectangle Width="16" Height="16" RadiusX="3" RadiusY="3" Fill="{Binding Swatch}" Stroke="#9AA3AF" StrokeThickness="1" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button x:Name="BtnNotifBgPick" Content="调色…" Padding="9,3" FontSize="12" Margin="6,0,0,0"
                                                    Background="White" BorderBrush="#D1D5DB" Click="BtnNotifBgPick_Click"
                                                    ToolTip="用系统取色器选任意背景色（预设里没有的颜色也能用）"/>
                                        </StackPanel>
                                    </WrapPanel>
                                    <!-- 实时预览：与顶部字幕条完全同一套字体 / 颜色 -->
                                    <Border x:Name="NotifPreview" CornerRadius="10" Padding="12,8" Margin="0,4,0,0">
                                        <TextBlock x:Name="NotifPreviewText" Text="预览：今天下午第 8 节后全校大扫除"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="新公告" FontSize="15" FontWeight="Bold" Foreground="#1F2A37" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="标题（选填）" FontSize="14" Foreground="#4B5563"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Grid.Column="1" x:Name="TxtNewTitle" FontSize="15" Padding="10" Background="White" BorderBrush="#D1D5DB"
                                             ToolTip="标题会显示在内容前面，例如「通知」「紧急」"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="公告内容" FontSize="14" Foreground="#4B5563"
                                               VerticalAlignment="Top" Margin="0,10,10,0"/>
                                    <TextBox Grid.Column="1" x:Name="TxtNewContent" FontSize="14" Padding="10" Height="72" TextWrapping="Wrap" AcceptsReturn="True" Background="White" BorderBrush="#D1D5DB"
                                             ToolTip="通知 / 公告内容：输入后点「添加通知」，顶部字幕条会滚动显示"/>
                                </Grid>
                                <!-- 通知范围：全校 / 本班。全校的会随数据包同步到所有教室机 -->
                                <Border Background="#EEF5FF" BorderBrush="{DynamicResource PrimaryBorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <CheckBox x:Name="ChkNewNoticeSchool" FontSize="14" FontWeight="Bold" Foreground="#1F2A37"
                                                  Content="设为全校通知（随数据包同步到所有教室机）"
                                                  ToolTip="勾选后这条通知会写进数据包，各教室机导入 / 自动更新后都会滚动显示；不勾选只在本机显示。"/>
                                        <TextBlock Text="默认「本班通知」：只在本机显示，不打进数据包。「发布到数据源」或勾选「本机兼任发布机」时，全校通知才会同步出去。"
                                                   FontSize="12" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <DockPanel>
                                    <Button x:Name="BtnAddNotice" Content="添加通知" Padding="12,7" FontSize="15" DockPanel.Dock="Left" Click="BtnAddNotice_Click"/>
                                    <TextBlock Text="标题选填；内容支持多行。添加后立即在顶部字幕条滚动显示。" FontSize="12" Foreground="#9CA3AF"
                                               VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                                </DockPanel>
                            </StackPanel>
                            <ItemsControl x:Name="NotificationsPanel">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#9CA3AF"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Scope}" Value="school">
                                                                        <Setter Property="Background" Value="#2D6CDF"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding ScopeText}" FontSize="11" Foreground="White"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="#1F2A37" VerticalAlignment="Center"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                                        <Button Content="{Binding ScopeButtonText}" FontSize="12" Padding="10,3" Margin="0,0,6,0"
                                                                Click="BtnNoticeScope_Click" Tag="{Binding Id}"
                                                                ToolTip="切换这条通知的范围：全校 = 随数据包同步到所有教室机；本班 = 只在本机显示"/>
                                                        <Button Content="{Binding PinButtonText}" FontSize="12" Padding="10,3" Margin="0,0,6,0"
                                                                Click="BtnPin_Click" Tag="{Binding Id}"/>
                                                        <Button Content="删除" FontSize="12" Padding="10,3"
                                                                Click="BtnDeleteNotice_Click" Tag="{Binding Id}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Content}" FontSize="14" Foreground="#4B5563" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                                <TextBlock Text="{Binding CreatedText}" FontSize="11" Foreground="#B0B6BF" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <!-- 作业公示：只放预览 + 编辑按钮，内容 / 格式 / 主题都在弹窗里改 -->
                <TabItem Header="作业公示">
                    <ScrollViewer Margin="14">
                        <StackPanel MaxWidth="820">
                            <TextBlock Text="📚 各科作业公示栏" FontSize="20" FontWeight="Bold" Foreground="#1F2A37" Margin="0,0,0,4"/>
                            <TextBlock Text="内容、文字格式与主题风格都在弹窗里编辑：点下面的按钮打开编辑窗口，改完确定即保存，并自动同步到桌面便签与悬浮便签。"
                                       FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,14"/>

                            <!-- 预览：与桌面便签 / 悬浮便签同一套渲染，所见即所得 -->
                            <WrapPanel>
                                <Border Background="White" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,14,14" Width="368">
                                    <StackPanel>
                                        <TextBlock Text="作业公示便签预览" FontSize="15" FontWeight="Bold" Foreground="#1F2A37"/>
                                        <Border Background="#F5F7FA" CornerRadius="8" Margin="0,8,0,0" Padding="6" Height="300">
                                            <Image x:Name="ImgHwPreview" Stretch="Uniform" StretchDirection="DownOnly"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   ToolTip="当前作业公示便签的样子（含主题风格与文字格式）"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Background="White" BorderBrush="#F3C9C4" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14" Width="368">
                                    <StackPanel>
                                        <TextBlock Text="缺交作业名单便签预览" FontSize="15" FontWeight="Bold" Foreground="#C0392B"/>
                                        <Border Background="#FFF6F5" CornerRadius="8" Margin="0,8,0,0" Padding="6" Height="300">
                                            <Image x:Name="ImgMsPreview" Stretch="Uniform" StretchDirection="DownOnly"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   ToolTip="当前缺交名单便签的样子（含主题风格与文字格式）"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <WrapPanel Margin="0,2,0,0">
                                <Button x:Name="BtnEditHw" Content="＋ 添加 / 编辑作业公示" Padding="16,9" FontSize="15"
                                        Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderBrush="{DynamicResource PrimaryBrush}"
                                        Click="BtnEditHw_Click" Margin="0,0,12,10"
                                        ToolTip="打开编辑窗口：科目、作业内容、文字格式（加粗 / 颜色 / 字号）与主题风格"/>
                                <Button x:Name="BtnEditMs" Content="＋ 增加 / 编辑缺交名单" Padding="16,9" FontSize="15"
                                        Background="#FDE8E8" BorderBrush="#E0A0A0" Foreground="#C0392B"
                                        Click="BtnEditMs_Click" Margin="0,0,12,10"
                                        ToolTip="打开缺交名单编辑窗口：科目、学生姓名、文字格式与主题风格"/>
                                <Button x:Name="BtnCustomNote" Content="＋ 新增 / 编辑自定义便签" Padding="16,9" FontSize="15"
                                        Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}"
                                        Click="BtnCustomNote_Click" Margin="0,0,12,10"
                                        ToolTip="打开编辑窗口：可新建便签或选择已有便签，设置标题、内容、文字格式（加粗 / 字色 / 字号）与主题风格"/>
                                <Button x:Name="BtnWpSettings" Content="🖱 桌面背景排版" Padding="16,9" FontSize="15" Margin="0,0,12,10"
                                        Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}"
                                        Click="BtnWpSettings_Click"
                                        ToolTip="打开所见即所得排版：直接拖动便签调整位置、拉边框改大小"/>
                            </WrapPanel>

                            <Border Background="#F7F9FC" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="显示与桌面背景" FontSize="15" FontWeight="Bold" Foreground="#1F2A37"/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button x:Name="BtnToggleHw2" Content="显示作业便签" Padding="12,7" FontSize="14" Margin="0,0,10,8"
                                                Background="White" BorderBrush="#D1D5DB" Click="BtnToggleHw_Click"
                                                ToolTip="在屏幕上显示 / 隐藏作业公示悬浮便签"/>
                                        <Button x:Name="BtnToggleMs2" Content="显示缺交便签" Padding="12,7" FontSize="14" Margin="0,0,10,8"
                                                Background="White" BorderBrush="#D1D5DB" Click="BtnToggleMs_Click"
                                                ToolTip="在屏幕上显示 / 隐藏缺交名单悬浮便签"/>
                                        <Button x:Name="BtnHwWp" Content="作业→桌面背景：关" Padding="12,7" FontSize="14" Margin="0,0,10,8"
                                                Background="White" BorderBrush="#D1D5DB" Click="BtnHwWp_Click"
                                                ToolTip="把作业公示画到桌面壁纸上（位于所有窗口之下，不遮挡操作）"/>
                                        <Button x:Name="BtnMsWp" Content="缺交→桌面背景：关" Padding="12,7" FontSize="14" Margin="0,0,0,8"
                                                Background="White" BorderBrush="#D1D5DB" Click="BtnMsWp_Click"
                                                ToolTip="把缺交作业名单画到桌面壁纸上（位于所有窗口之下）"/>
                                    </WrapPanel>
                                    <TextBlock Text="提示：把鼠标移到便签上即可拖动摆放，拉便签边沿可改变大小；双击便签同样能打开编辑窗口。"
                                               FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 用户中心：修改用户名与密码 -->
                <TabItem Header="用户中心">
                    <ScrollViewer Margin="14">
                        <StackPanel MaxWidth="900">
                            <TextBlock Text="👤 用户中心" FontSize="20" FontWeight="Bold" Foreground="#1F2A37" Margin="0,0,0,4"/>
                            <TextBlock Text="这里显示当前登录的账号，可修改自己的用户名和密码。升级后原账号即「管理员」（密码沿用你以前登录用的那套）；教室机开机自动登录的是受限账号 local / 000，只能控制显示，改设置请点下方「切换账号…」用管理员登录，不用重启程序。右侧找回密码信息全机共用一份，只有管理员能改。"
                                       FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,14"/>
                            <Border Background="#F7F9FC" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="10" Padding="18,16">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 左列：账号与密码 -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="账号与密码" FontSize="15" FontWeight="Bold" Foreground="#1F2A37" Margin="0,0,0,10"/>
                                            <TextBlock Text="当前用户名" FontSize="13" Foreground="#4B5563" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtCurUser" FontSize="14" Padding="8" Background="White" BorderBrush="#D1D5DB" IsReadOnly="True" Margin="0,0,0,12"/>
                                            <TextBlock Text="当前密码（修改用户名或密码时必填，只改其他信息可留空）" FontSize="13" Foreground="#4B5563" Margin="0,0,0,4"/>
                                            <PasswordBox x:Name="TxtCurPwd" FontSize="14" Padding="8" Background="White" BorderBrush="#D1D5DB" PasswordChar="*" Margin="0,0,0,12"
                                                         ToolTip="为防止他人误改 / 冒改，改用户名或改密码都要先输入当前密码"/>
                                            <TextBlock Text="新用户名（留空 = 不修改用户名）" FontSize="13" Foreground="#4B5563" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtNewUser" FontSize="14" Padding="8" Background="White" BorderBrush="#D1D5DB" Margin="0,0,0,12"
                                                     ToolTip="只想改密码时，这里留空即可"/>
                                            <TextBlock Text="新密码（留空 = 不修改密码）" FontSize="13" Foreground="#4B5563" Margin="0,0,0,4"/>
                                            <PasswordBox x:Name="TxtNewPwd" FontSize="14" Padding="8" Background="White" BorderBrush="#D1D5DB" PasswordChar="*" Margin="0,0,0,12"/>
                                            <TextBlock Text="确认新密码" FontSize="13" Foreground="#4B5563" Margin="0,0,0,4"/>
                                            <PasswordBox x:Name="TxtNewPwd2" FontSize="14" Padding="8" Background="White" BorderBrush="#D1D5DB" PasswordChar="*" Margin="0,0,0,0"/>
                                        </StackPanel>

                                        <!-- 右列：找回密码信息 -->
                                        <StackPanel x:Name="PanelRecovery" Grid.Column="2">
                                            <TextBlock Text="找回密码信息（都可留空）" FontSize="15" FontWeight="Bold" Foreground="#1F2A37" Margin="0,0,0,10"/>
                                            <TextBlock Text="电子邮箱" FontSize="13" Foreground="#4B5563" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtEmail" FontSize="14" Padding="8" Background="White" BorderBrush="#D1D5DB" Margin="0,0,0,12"/>
                                            <TextBlock Text="手机号码" FontSize="13" Foreground="#4B5563" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtPhone" FontSize="14" Padding="8" Background="White" BorderBrush="#D1D5DB" Margin="0,0,0,12"/>
                                            <TextBlock Text="密保问题" FontSize="13" Foreground="#4B5563" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="CbSecQuestion" FontSize="14" Padding="6" Background="White" BorderBrush="#D1D5DB" Margin="0,0,0,12">
                                                <ComboBoxItem Content="（不设密保问题）"/>
                                                <ComboBoxItem Content="您母亲的姓名是？"/>
                                                <ComboBoxItem Content="您父亲的姓名是？"/>
                                                <ComboBoxItem Content="您就读的第一所学校的名称？"/>
                                                <ComboBoxItem Content="您最喜欢的老师是谁？"/>
                                                <ComboBoxItem Content="您的出生城市是？"/>
                                                <ComboBoxItem Content="您宠物的名字是？"/>
                                            </ComboBox>
                                            <TextBlock Text="密保答案（设置了密保问题时填写）" FontSize="13" Foreground="#4B5563" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtSecAnswer" FontSize="14" Padding="8" Background="White" BorderBrush="#D1D5DB" Margin="0,0,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 自动登录 -->
                                    <Border Background="#EEF5FF" BorderBrush="{DynamicResource PrimaryBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,16,0,0">
                                        <StackPanel>
                                            <CheckBox x:Name="ChkAutoLogin" Content="记住账号密码，下次开机自动登录" FontSize="15" FontWeight="Bold" Foreground="#1F2A37"/>
                                            <TextBlock Text="默认开启：教室机每天开机直接进入，不再询问账号密码（登录界面上密码以 * 显示）。取消勾选后，下次启动会回到登录界面，可以换账号或改用「游客体验」。"
                                                       FontSize="12" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Margin="0,16,0,0">
                                        <Button x:Name="BtnSaveUser" Content="保存修改" Padding="18,9" FontSize="15" HorizontalAlignment="Left"
                                                Background="{DynamicResource PrimaryBrush}" Foreground="White"
                                                BorderBrush="{DynamicResource PrimaryBrush}" Click="BtnSaveUser_Click"/>
                                        <TextBlock x:Name="TxtUserMsg" FontSize="13" Margin="0,10,0,0"
                                                   TextWrapping="Wrap" Visibility="Collapsed"/>
                                        <Border Background="#F7F9FC" BorderBrush="#E3E8EF" BorderThickness="1"
                                                CornerRadius="8" Padding="12,10" Margin="0,14,0,0">
                                            <StackPanel>
                                                <TextBlock x:Name="TxtRoleLine" Text="当前身份：—" FontSize="13"
                                                           FontWeight="Bold" Foreground="#1F2A37"/>
                                                <TextBlock Text="管理员可以在这里管理全校账号（新增 / 改角色 / 重置密码 / 从 Excel 导入名单）；切换账号不需要重启程序。"
                                                           FontSize="12" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,6,0,8"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="BtnManageUsers" Content="用户管理…" Padding="14,7" FontSize="13"
                                                            Margin="0,0,8,0" Background="#EAF2FD" BorderBrush="#9EC1F0"
                                                            Click="BtnManageUsers_Click"/>
                                                    <Button x:Name="BtnSwitchUser" Content="切换账号…" Padding="14,7" FontSize="13"
                                                            Click="BtnSwitchUser_Click"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="提示：改用户名或改密码都要先输入「当前密码」；只想换密码时，把「新用户名」留空即可。修改后立即生效并保存；以「游客」身份进入时不保存任何改动。"
                                       FontSize="13" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <!-- 关于：软件简介 + 版本 + 软件更新（Gitee）+ 运行信息（独立标签，不占用户中心） -->
                <TabItem x:Name="TabAbout" Header="关于">
                    <ScrollViewer Margin="14" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="900">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="ℹ 关于　班级公布栏" FontSize="20" FontWeight="Bold" Foreground="#1F2A37" VerticalAlignment="Center"/>
                                <Border Background="#EAF1FD" BorderBrush="#9DBDF0" BorderThickness="1" CornerRadius="12"
                                        Padding="12,3" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtAboutVer" Text="v—" FontSize="13" FontWeight="Bold" Foreground="#1E4FA8"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="面向教室多媒体屏的课表与班级信息公布工具　·　© 2026 逆流的鱼"
                                       FontSize="13" Foreground="#6B7280" Margin="0,0,0,10"/>
                            <TextBlock Text="导入全校总课程表后选定班级，教室屏上就会显示当天的课程、通知公告、作业公示与缺交名单；支持调代课（含按周生效区间）、多账号与角色权限、把课表 / 便签画到桌面背景，以及多台教室机之间的数据包自动同步。"
                                       FontSize="13.5" Foreground="#374151" TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,4"/>

                            <!-- 软件更新（程序自身的版本，与「数据包自动更新」无关） -->
                            <Border Background="#F4F8FF" BorderBrush="{DynamicResource PrimaryBorderBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="16,14" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="🔄 软件更新" FontSize="15" FontWeight="Bold" Foreground="#1F2A37"/>
                                    <TextBlock Text="从 Gitee 仓库读取最新的发布版本，发现新版可直接打开发布页下载安装包。这里只管「程序本身」的版本；教室机的课表数据更新仍走「数据管理 → 自动更新」，两者互不影响。"
                                               FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <WrapPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button x:Name="BtnAboutCheck" Content="检查更新" Padding="16,8" FontSize="13.5" Cursor="Hand"
                                                Margin="0,0,8,0" Background="#2D6CDF" Foreground="White" BorderBrush="#2D6CDF"
                                                ToolTip="联网读取 Gitee 上的最新发布版本"
                                                Click="BtnAboutCheck_Click"/>
                                        <Button x:Name="BtnAboutReleasePage" Content="打开发布页（Gitee）" Padding="16,8" FontSize="13.5" Cursor="Hand"
                                                Margin="0,0,8,0" Background="#EAF2FD" BorderBrush="#9EC1F0"
                                                ToolTip="在浏览器里打开 Gitee 发布页，可查看全部版本与安装包"
                                                Click="BtnAboutReleasePage_Click"/>
                                        <Button x:Name="BtnAboutDownload" Content="下载最新版" Padding="16,8" FontSize="13.5" Cursor="Hand"
                                                Background="#E8F7EE" BorderBrush="#9BD3AE" Visibility="Collapsed"
                                                ToolTip="直接下载最新版安装包"
                                                Click="BtnAboutDownload_Click"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="TxtAboutUpdStatus" FontSize="13" Foreground="#374151" TextWrapping="Wrap"
                                               Margin="0,10,0,0" Text="尚未检查。点「检查更新」获取 Gitee 上的最新版本。"/>
                                    <Border x:Name="PanelAboutNotes" Visibility="Collapsed" Background="White"
                                            BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,10,0,0">
                                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                            <TextBlock x:Name="TxtAboutReleaseNotes" FontSize="12.5" Foreground="#4B5563" TextWrapping="Wrap" LineHeight="19"/>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 运行信息（排查问题时截图 / 复制给维护人员） -->
                            <TextBlock Text="运行信息" FontSize="15" FontWeight="Bold" Foreground="#1F2A37" Margin="0,18,0,8"/>
                            <Border Background="#F7F9FC" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="8" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="版本" FontSize="12.5" Foreground="#6B7280" Margin="0,3,0,9"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtAboutInfoVer" FontSize="12.5" Foreground="#1F2A37" TextWrapping="Wrap" Margin="0,3,0,9"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="当前身份" FontSize="12.5" Foreground="#6B7280" Margin="0,3,0,9"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtAboutInfoRole" FontSize="12.5" Foreground="#1F2A37" TextWrapping="Wrap" Margin="0,3,0,9"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="课表规模" FontSize="12.5" Foreground="#6B7280" Margin="0,3,0,9"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtAboutInfoClasses" FontSize="12.5" Foreground="#1F2A37" TextWrapping="Wrap" Margin="0,3,0,9"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="数据源" FontSize="12.5" Foreground="#6B7280" Margin="0,3,0,9"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtAboutInfoSource" FontSize="12.5" Foreground="#1F2A37" TextWrapping="Wrap" Margin="0,3,0,9"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="数据格式" FontSize="12.5" Foreground="#6B7280" Margin="0,3,0,9"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtAboutInfoSchema" FontSize="12.5" Foreground="#1F2A37" TextWrapping="Wrap" Margin="0,3,0,9"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="数据目录" FontSize="12.5" Foreground="#6B7280" Margin="0,3,0,9"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TxtAboutInfoDir" FontSize="12.5" Foreground="#1F2A37" TextWrapping="Wrap" Margin="0,3,0,9"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="上次检查更新" FontSize="12.5" Foreground="#6B7280" Margin="0,3,0,3"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" x:Name="TxtAboutInfoLastCheck" FontSize="12.5" Foreground="#1F2A37" TextWrapping="Wrap" Margin="0,3,0,3"/>
                                </Grid>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="BtnAboutCopy" Content="复制版本信息" Padding="16,8" FontSize="13.5" Cursor="Hand"
                                        Margin="0,0,8,0" Background="#EAF2FD" BorderBrush="#9EC1F0"
                                        ToolTip="把版本、身份、数据目录等一起复制到剪贴板，反馈问题时直接粘贴"
                                        Click="BtnAboutCopy_Click"/>
                                <Button x:Name="BtnAboutOpenDir" Content="打开数据目录" Padding="16,8" FontSize="13.5" Cursor="Hand"
                                        Background="#EAF2FD" BorderBrush="#9EC1F0"
                                        ToolTip="备份 / 排查时在这个文件夹里找 settings、schedule、users.json"
                                        Click="BtnAboutOpenDir_Click"/>
                            </StackPanel>

                            <TextBlock Text="提示：软件更新只在本机联网检查，不会自动替换程序；确认要升级时，从发布页下载安装包，直接双击覆盖安装即可（课表与账号数据都保留）。"
                                       FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>

        <!-- 防误触锁定覆盖层 -->
        <Grid x:Name="LockOverlay" Visibility="Collapsed" Background="Transparent">
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24"
                    Background="#33000000" CornerRadius="8" Padding="14,9">
                <TextBlock Text="展示模式已锁定　·　按 Ctrl+L 解锁" Foreground="White" FontSize="16"/>
            </Border>
        </Grid>
    </Grid>
</Window>
