<Window x:Class="ClassBulletinApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClassBulletinApp"
        Title="班级公布栏 · 控制面板" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" KeyDown="Window_KeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="PeriodCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E3E8EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 顶层容器：DockPanel 主体 + 锁定覆盖层 -->
        <DockPanel>
            <!-- 顶部工具栏（精简：仅最常用） -->
        <Border DockPanel.Dock="Top" Background="#2D6CDF" Padding="14,10">
            <DockPanel LastChildFill="True">
                <TextBlock Text="📋 班级公布栏" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="班级：" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="14"/>
                    <ComboBox x:Name="CbClass" Width="150" FontSize="14" SelectionChanged="CbClass_SelectionChanged" Margin="0,0,8,0"/>
                    <TextBlock Text="显示日：" Foreground="White" VerticalAlignment="Center" Margin="8,0,4,0" FontSize="14"/>
                    <DatePicker x:Name="DpDisplayDate" Width="130" FontSize="13" Margin="0,0,4,0" SelectedDateChanged="DpDisplayDate_SelectedDateChanged"/>
                    <Button x:Name="BtnToday" Content="今天" Margin="4" Padding="10,6" FontSize="13" Click="BtnToday_Click" Background="#EAF1FD" BorderBrush="#9DBDF0"/>
                    <Button x:Name="BtnWeek" Content="周视图调课" Margin="4" Padding="12,6" FontSize="13" Click="BtnWeek_Click" Background="#FFF3CD" BorderBrush="#E0B850"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- 底部状态栏（常驻） -->
        <Border DockPanel.Dock="Bottom" Background="#F5F7FA" BorderBrush="#E3E8EF" BorderThickness="0,1,0,0" Padding="14,8">
            <TextBlock x:Name="TxtStatus" FontSize="14" Foreground="#C0392B" TextWrapping="Wrap"/>
        </Border>

        <!-- 主体：标签页归类 -->
        <TabControl x:Name="MainTabs" Margin="10">
            <!-- 课表 -->
            <TabItem Header="课表">
                <ScrollViewer Margin="8">
                    <StackPanel MaxWidth="900">
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock x:Name="TxtClassName" FontSize="30" FontWeight="Bold" Foreground="#1F2A37"/>
                            <TextBlock x:Name="TxtDate" FontSize="17" Foreground="#6B7280" Margin="0,4,0,0"/>
                            <TextBlock x:Name="TxtWeek" FontSize="17" Foreground="#6B7280" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock Text="提示：拖动课卡可把本节课调到其它节次（目标有课则两节互换，目标为空则移动并清空原格）；双击或右键课卡可临时调课 / 代课（含确认 / 取消）。"
                                   FontSize="13" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="TodayPanel" MouseDoubleClick="TodayPanel_MouseDoubleClick">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PeriodCard}" Background="{Binding CardBg}"
                                            AllowDrop="True"
                                            PreviewMouseLeftButtonDown="TodayCard_PreviewMouseLeftButtonDown"
                                            PreviewMouseMove="TodayCard_PreviewMouseMove"
                                            PreviewMouseLeftButtonUp="TodayCard_PreviewMouseLeftButtonUp"
                                            DragOver="TodayCard_DragOver"
                                            Drop="TodayCard_Drop"
                                            MouseRightButtonUp="TodayCard_MouseRightButtonUp">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="96"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding PeriodText}" FontSize="22" FontWeight="Bold" Foreground="#2D6CDF"/>
                                                <TextBlock Text="{Binding TimeRange}" FontSize="13" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <ItemsControl ItemsSource="{Binding Lessons}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,3">
                                                                <Border Background="{Binding OverrideBadgeColor}" CornerRadius="4" Padding="6,2" Margin="0,0,0,6"
                                                                        HorizontalAlignment="Left"
                                                                        Visibility="{Binding IsOverridden, Converter={StaticResource BoolToVis}}"
                                                                        ToolTip="{Binding OverrideNote}">
                                                                    <TextBlock Text="{Binding OverrideBadgeText}" Foreground="White" FontSize="12"/>
                                                                </Border>
                                                                <TextBlock FontSize="23" FontWeight="Bold" Foreground="{Binding SubjectColor}">
                                                                    <Run Text="{Binding Subject}"/>
                                                                    <Run Text="{Binding WeekTag}" FontSize="14" Foreground="#9CA3AF" FontWeight="Normal"/>
                                                                </TextBlock>
                                                                <TextBlock FontSize="15" Foreground="#4B5563">
                                                                    <Run Text="{Binding Teacher}"/>
                                                                    <Run Text="{Binding LocationText}" Foreground="#2E8B57"/>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 数据管理 -->
            <TabItem Header="数据管理">
                <ScrollViewer Margin="14">
                    <StackPanel MaxWidth="640">
                        <TextBlock Text="课表数据" FontSize="20" FontWeight="Bold" Foreground="#1F2A37" Margin="0,0,0,12"/>
                        <Button x:Name="BtnImport" Content="导入课表（全校总课程表）" Margin="0,0,0,10" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Click="BtnImport_Click"/>
                        <Button x:Name="BtnImportTemp" Content="导入临时课表（含 调 / 代 标记）" Margin="0,0,0,10" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Background="#E8F6EE" BorderBrush="#7FC99A" Click="BtnImportTemp_Click"/>
                        <Button x:Name="BtnClearOverrides" Content="清除全部临时调课 / 代课" Margin="0,0,0,18" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Background="#FDE8E8" BorderBrush="#E0A0A0" Click="BtnClearOverrides_Click"/>
                        <TextBlock Text="说明：先「导入课表」得到基础课表；再用「导入临时课表」自动识别带（调）/（代）标记的课并生成调代覆盖（仅替换导入来源，保留手动修改）。" FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock Text="调课 / 代课记录也可在「周视图调课」中拖动安排，或在课卡上双击 / 右键编辑。" FontSize="13" Foreground="#6B7280" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 显示设置 -->
            <TabItem Header="显示设置">
                <ScrollViewer Margin="14">
                    <StackPanel MaxWidth="640">
                        <TextBlock Text="悬浮窗与展示" FontSize="20" FontWeight="Bold" Foreground="#1F2A37" Margin="0,0,0,12"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="BtnToggleSch" Content="课表悬浮：关" Style="{StaticResource TabBtn}" Click="BtnToggleSch_Click" Background="#EAF1FD" BorderBrush="#9DBDF0"/>
                            <Button x:Name="BtnToggleNot" Content="通知悬浮：关" Style="{StaticResource TabBtn}" Click="BtnToggleNot_Click" Background="#EAF1FD" BorderBrush="#9DBDF0"/>
                            <Button x:Name="BtnLayout" Content="布局设置" Style="{StaticResource TabBtn}" Click="BtnLayout_Click"/>
                            <Button x:Name="BtnFull" Content="全屏" Style="{StaticResource TabBtn}" Click="BtnFull_Click"/>
                            <Button x:Name="BtnLock" Content="锁定" Style="{StaticResource TabBtn}" Click="BtnLock_Click"/>
                            <Button x:Name="BtnHideTray" Content="隐藏到托盘" Style="{StaticResource TabBtn}" Click="BtnHideTray_Click"/>
                            <Button x:Name="BtnSettings" Content="设置（开学周 / 开机自启）" Style="{StaticResource TabBtn}" Click="BtnSettings_Click"/>
                        </WrapPanel>
                        <TextBlock Text="布局设置可调整悬浮窗位置、大小、透明度、置顶、鼠标穿透或自动靠边隐藏。" FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="8,8,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 通知公告 -->
            <TabItem Header="通知公告">
                <ScrollViewer Margin="14">
                    <StackPanel MaxWidth="640">
                        <TextBlock Text="📢 通知 / 公告管理" FontSize="20" FontWeight="Bold" Foreground="#1F2A37" Margin="0,0,0,12"/>
                        <StackPanel Margin="0,0,0,12">
                            <TextBox x:Name="TxtNewTitle" FontSize="15" Padding="10" Margin="0,0,0,8" Background="White" BorderBrush="#D1D5DB" ToolTip="标题（选填）"/>
                            <TextBox x:Name="TxtNewContent" FontSize="14" Padding="10" Height="64" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,8" Background="White" BorderBrush="#D1D5DB" ToolTip="内容"/>
                            <Button x:Name="BtnAddNotice" Content="添加通知" Padding="12,7" FontSize="15" HorizontalAlignment="Left" Click="BtnAddNotice_Click"/>
                        </StackPanel>
                        <ItemsControl x:Name="NotificationsPanel">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="#1F2A37"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                                    <Button Content="{Binding PinButtonText}" FontSize="12" Padding="10,3" Margin="0,0,6,0"
                                                            Click="BtnPin_Click" Tag="{Binding Id}"/>
                                                    <Button Content="删除" FontSize="12" Padding="10,3"
                                                            Click="BtnDeleteNotice_Click" Tag="{Binding Id}"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Content}" FontSize="14" Foreground="#4B5563" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding CreatedText}" FontSize="11" Foreground="#B0B6BF" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        </DockPanel>

        <!-- 防误触锁定覆盖层 -->
        <Grid x:Name="LockOverlay" Visibility="Collapsed" Background="Transparent">
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24"
                Background="#33000000" CornerRadius="8" Padding="14,9">
            <TextBlock Text="展示模式已锁定　·　按 Ctrl+L 解锁" Foreground="White" FontSize="16"/>
            </Border>
        </Grid>
    </Grid>
</Window>
