<Window x:Class="ClassBulletinApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:ClassBulletinApp.Controls"
        xmlns:local="clr-namespace:ClassBulletinApp"
        Title="班级公布栏 · 控制面板" Height="900" Width="1400"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" KeyDown="Window_KeyDown"
        PreviewTouchDown="OnPreviewTouchDownKeepInnerTouch">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- 颜色下拉的统一外观：左边色块、右边名字（通知条与提醒提示外观共用） -->
        <DataTemplate x:Key="ColorSwatchTpl">
            <StackPanel Orientation="Horizontal" Margin="2">
                <Rectangle Width="16" Height="16" RadiusX="3" RadiusY="3" Fill="{Binding Swatch}"
                           Stroke="{DynamicResource HintBrush}" StrokeThickness="1" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"/>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinWidth" Value="132"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 顶层容器：DockPanel 主体 + 锁定覆盖层 -->
        <DockPanel>
            <!-- 顶部上下文栏：浅色底 + 线性色块，只放班级 / 学期 / 身份上下文 -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Width="14" Height="14" RadiusX="4" RadiusY="4"
                                   Fill="{DynamicResource PrimaryBrush}" Margin="0,0,10,0"/>
                        <TextBlock Text="班级公布栏" Foreground="{DynamicResource InkBrush}" FontSize="20"
                                   FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="LblTeacher" Text="教师：" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
                        <ComboBox x:Name="CbTeacher" Width="172" FontSize="14" Margin="0,0,14,0"
                                  Foreground="{DynamicResource InkBrush}"
                                  IsEditable="True" IsTextSearchEnabled="False"
                                  TextBoxBase.TextChanged="CbTeacher_TextChanged"
                                  SelectionChanged="CbTeacher_SelectionChanged"
                                  LostFocus="CbTeacher_LostFocus"
                                  ToolTip="可直接输入教师姓名查询筛选；选择后悬浮课表切换为该教师的个人课表"/>
                        <TextBlock Text="班级：" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="13"/>
                        <ComboBox x:Name="CbClass" Width="150" FontSize="14" SelectionChanged="CbClass_SelectionChanged" Margin="0,0,8,0"
                                  Foreground="{DynamicResource InkBrush}"
                                  ToolTip="选择班级后悬浮课表切换为该班的课表"/>
                        <TextBlock x:Name="TxtCurrentMode" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" FontSize="13" Margin="6,0,0,0"/>
                        <TextBlock Text="开学周" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="20,0,6,0" FontSize="13"/>
                        <DatePicker x:Name="DpSemester" Width="132" FontSize="13" VerticalAlignment="Center" SelectedDateFormat="Short"
                                    Foreground="{DynamicResource InkBrush}"
                                    SelectedDateChanged="DpSemester_SelectedDateChanged"
                                    ToolTip="开学第一周星期一：用于计算「第几周」教学周，与学校开学时间对齐。"/>
                        <CheckBox x:Name="ChkAutoStartTitle" Content="开机自启" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="13"
                                  Checked="ChkAutoStartTitle_Changed" Unchecked="ChkAutoStartTitle_Changed"
                                  ToolTip="把本程序写入当前用户开机启动项"/>
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!-- 底部状态栏（常驻） -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource BarSurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,8">
                <TextBlock x:Name="TxtStatus" FontSize="14" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"/>
            </Border>

            <!-- 主体：左侧五个一级导航 + 二级分段条 + 原 TabControl（隐藏页头，索引与 x:Name 全保留） -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="192"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧一级导航 -->
                <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="12,8">
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="TxtNavUser" Text="账号 · 锁定 · 关于" Style="{StaticResource TextHint}"/>
                                    <TextBlock Text="Ctrl+L 锁定展示模式" Style="{StaticResource TextHint}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                            <StackPanel Margin="12,16,12,8">
                                <TextBlock Text="班级公布栏" Style="{StaticResource TextSection}" Margin="4,0,0,16"/>
                                <Button x:Name="NavBtnToday" Content="今日" Tag="today"
                                        Style="{StaticResource AppNavButton}" Click="NavGroup_Click"/>
                                <Button x:Name="NavBtnWeek" Content="课程表" Tag="week"
                                        Style="{StaticResource AppNavButton}" Click="NavGroup_Click"/>
                                <Button x:Name="NavBtnContent" Content="内容" Tag="content"
                                        Style="{StaticResource AppNavButton}" Click="NavGroup_Click"/>
                                <Button x:Name="NavBtnMessage" Content="消息" Tag="message"
                                        Style="{StaticResource AppNavButton}" Click="NavGroup_Click"/>
                                <Button x:Name="NavBtnSetting" Content="设置" Tag="setting"
                                        Style="{StaticResource AppNavButton}" Click="NavGroup_Click"/>
                                <TextBlock Text="原标签页已按任务分组收纳，内容一字未改"
                                           Style="{StaticResource TextHint}" Margin="4,20,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- 右侧：二级分段条 + 内容区 -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                        <StackPanel x:Name="SubNavHost" Orientation="Horizontal">
                            <StackPanel x:Name="SubNavToday" Orientation="Horizontal" Visibility="Collapsed">
                                <TextBlock Text="今天有什么事" Style="{StaticResource TextHint}" VerticalAlignment="Center" Margin="4,0,8,0"/>
                            </StackPanel>
                            <StackPanel x:Name="SubNavWeek" Orientation="Horizontal" Visibility="Collapsed">
                                <Button Content="周课程表" Tag="0" Style="{StaticResource AppSubNavButton}" Click="NavSub_Click"/>
                                <TextBlock Text="拖动课程卡可交换两节课，双击可编辑" Style="{StaticResource TextHint}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <StackPanel x:Name="SubNavContent" Orientation="Horizontal" Visibility="Collapsed">
                                <Button Content="通知公告" Tag="4" Style="{StaticResource AppSubNavButton}" Click="NavSub_Click"/>
                                <Button Content="便签管理" Tag="5" Style="{StaticResource AppSubNavButton}" Click="NavSub_Click"/>
                                <Button Content="发布信息" Tag="publish" Style="{StaticResource AppSubNavButton}" Click="NavSub_Click"/>
                            </StackPanel>
                            <StackPanel x:Name="SubNavMessage" Orientation="Horizontal" Visibility="Collapsed">
                                <Button Content="同步与设置" Tag="6" Style="{StaticResource AppSubNavButton}" Click="NavSub_Click"/>
                            </StackPanel>
                            <StackPanel x:Name="SubNavSetting" Orientation="Horizontal" Visibility="Visible">
                                <Button Content="显示设置" Tag="2" Style="{StaticResource AppSubNavButton}" Click="NavSub_Click"/>
                                <Button Content="提醒设置" Tag="3" Style="{StaticResource AppSubNavButton}" Click="NavSub_Click"/>
                                <Button Content="数据管理" Tag="1" Style="{StaticResource AppSubNavButton}" Click="NavSub_Click"/>
                                <Button Content="用户中心" Tag="7" Style="{StaticResource AppSubNavButton}" Click="NavSub_Click"/>
                                <Button Content="关于" Tag="8" Style="{StaticResource AppSubNavButton}" Click="NavSub_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TabControl x:Name="MainTabs" Grid.Row="1" Margin="10"
                                Style="{StaticResource HeadlessTabs}"
                                SelectionChanged="MainTabs_SelectionChanged">
                <!-- 课表：直接周视图（右键安排调代课；单击已安排格二次确认清除） -->
                <TabItem Header="周课程表">
                    <local:WeekView x:Name="WeekViewManage" Mode="Manage"/>
                </TabItem>

                <!-- 数据管理 -->
                <TabItem Header="数据管理">
                    <ScrollViewer Margin="14" PanningMode="VerticalOnly">
                        <StackPanel>
                            <!-- 两列：左边「课表数据」，右边「数据包分发 / 自动更新」——
                                 单列排下来在 1366×768 的教室屏上要滚两屏，自动更新状态会被藏在最底下 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" MaxWidth="400" Margin="0,0,32,0">
                                    <!-- r77：问号不再单独占一行，一律并到它所说明的标题 / 选项行末 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="课表数据" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                                        <ctl:HelpBubble PopupTitle="课表导入与调代课" Text="说明：先「导入课表」得到基础课表；再用「导入临时课表」自动识别带（调）/（代）标记的课并生成调代覆盖（仅替换导入来源，保留手动修改）。&#10;&#10;若只有一个班级使用本软件，可直接「导入单个班级课表」（如 八年级X班-班级课程表.xlsx），将仅包含该班课表。&#10;&#10;导入全校总课表 / 单班课表时，会自动按任课教师反向整理出「教师个人课表」（教师人数多时可在顶栏输入姓名查询），选中教师即显示其个人课表，每节课显示所教班级。教师个人也可单独导入自己的课表文件。&#10;&#10;调课 / 代课记录可在「周课程表」标签的周视图中右键安排；需要整体清除时使用「清除全部临时调课 / 代课」按钮。" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="BtnImport" Content="导入课表（全校总课程表）" Margin="0,0,0,10" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Click="BtnImport_Click"/>
                                    <Button x:Name="BtnImportTemp" Content="导入临时课表（含 调 / 代 标记）" Margin="0,0,0,10" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Background="#E8F6EE" BorderBrush="#7FC99A" Click="BtnImportTemp_Click"/>
                                    <Button x:Name="BtnImportSingle" Content="导入单个班级课表（单班适用）" Margin="0,0,0,10" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}" Click="BtnImportSingle_Click"/>
                                    <Button x:Name="BtnImportTeacher" Content="导入单个教师课表（教师个人适用）" Margin="0,0,0,10" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}" Click="BtnImportTeacher_Click"/>
                                    <Button x:Name="BtnClearOverrides" Content="清除临时调课 / 代课…（本周 / 指定范围 / 全部）" Margin="0,0,0,10" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" Click="BtnClearOverrides_Click"/>
                                    <Button x:Name="BtnRestoreSuspended" Content="恢复被主机停用的本机调课…" Margin="0,0,0,10" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource PrimarySoftBorderBrush}" Click="BtnRestoreSuspended_Click"/>
                                    <Button x:Name="BtnClearImported" Content="一键清除全部导入数据（课表 / 教师 / 调代）" Margin="0,0,0,0" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" Click="BtnClearImported_Click"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" MaxWidth="600">
                                    <TextBlock Text="数据包分发（离线版 / 多教室机同步）" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,10"/>
                                    <Button x:Name="BtnExportPackage" Content="导出数据包（发到其他教室机）" Margin="0,0,0,10" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource PrimarySoftBorderBrush}" Click="BtnExportPackage_Click"/>
                                    <Button x:Name="BtnImportPackage" Content="导入数据包（接收校务课表更新）" Margin="0,0,0,10" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Background="#E8F6EE" BorderBrush="#7FC99A" Click="BtnImportPackage_Click"/>
                                    <Button x:Name="BtnBackup" Content="备份与恢复" Margin="0,0,0,20" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Click="BtnBackup_Click"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="自动更新（共享文件夹 / FTP）" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                                        <ctl:HelpBubble PopupTitle="数据包与自动更新" Text="勾选「本机兼任发布机」并指定 source 目录后，程序会把该目录里的 Excel（临时课表文件名需以日期开头，如 2026-10-26_临时课表_八年级.xlsx）打包上传；其余教室机定时读取 publish 目录自动更新。连不上数据源时继续用本地数据，不影响使用。&#10;&#10;数据包只包含全校一致的内容：基础课表、调代课、标记为「全校」的通知、开学周等。本机的显示班级、窗口布局、密码、作业公示、缺交名单、自定义便签不会被打包，也不会被覆盖。&#10;&#10;每次导入数据包前会自动备份当前数据到 backup 目录（保留最近 20 份），可在「备份与恢复」里回滚。" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="BtnUpdateSettings" Content="自动更新设置…" Margin="0,0,0,10" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}" Click="BtnUpdateSettings_Click"/>
                                    <Button x:Name="BtnUpdateCheck" Content="立即检查更新" Margin="0,0,0,10" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Click="BtnUpdateCheck_Click"/>
                                    <Button x:Name="BtnPublishNow" Content="发布到数据源（供其他教室机更新）" Margin="0,0,0,10" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Click="BtnPublishNow_Click"/>
                                    <TextBlock x:Name="TxtUpdateStatus" Text="自动更新：未配置" FontSize="13" Foreground="{DynamicResource BodyBrush}" TextWrapping="Wrap" Margin="0,2,0,12" LineHeight="19"/>
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 显示设置 -->
                <TabItem Header="显示设置">
                    <ScrollViewer Margin="14" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                        <StackPanel MaxWidth="900">
                            <!-- 展示与控制：原「① 悬浮窗」与「② 展示控制」合并为一张卡片；
                                 全屏 / 锁定 / 隐藏到托盘三个按钮已移除（全屏再点退出易错，右上角 × 即可隐藏到托盘）。 -->
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="展示与控制" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                                    <WrapPanel Orientation="Horizontal" Margin="0,12,0,2">
                                        <Button x:Name="BtnToggleSch" Content="课表悬浮：关" Style="{StaticResource TabBtn}" Click="BtnToggleSch_Click"
                                                Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}"/>
                                        <Button x:Name="BtnToggleNot" Content="通知悬浮：关" Style="{StaticResource TabBtn}" Click="BtnToggleNot_Click"
                                                Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}"/>
                                        <Button x:Name="BtnLayout" Content="布局设置…" Style="{StaticResource TabBtn}" Click="BtnLayout_Click"
                                                ToolTip="透明度、置顶、鼠标穿透、自动靠边隐藏，以及恢复默认位置"/>
                                        <Button x:Name="BtnSettings" Content="启动选项…" Style="{StaticResource TabBtn}" Click="BtnSettings_Click"
                                                ToolTip="开机自启、启动即全屏 / 锁定、启动时自动弹出哪些悬浮窗"/>
                                        <Button x:Name="BtnTrayMenu" Content="任务栏菜单…" Style="{StaticResource TabBtn}" Click="BtnTrayMenu_Click"
                                                ToolTip="自定义托盘图标右键菜单：默认只保留「打开控制面板 / 用户中心 / 退出」，可自行增删与改名"/>
                                    </WrapPanel>
                                    <CheckBox x:Name="ChkMaxHide" Content="桌面有窗口最大化时，自动隐藏课表与通知（避免遮挡正在使用的程序）"
                                              FontSize="14" Foreground="{DynamicResource InkBrush}" Margin="2,6,0,0" Click="ChkMaxHide_Click"/>
                                    <CheckBox x:Name="ChkTouchKb" Content="触摸屏：手指点输入框时自动弹出系统触摸键盘（教室一体机建议开启；鼠标点击不弹）"
                                              FontSize="14" Foreground="{DynamicResource InkBrush}" Margin="2,6,0,0" Click="ChkTouchKb_Click"/>
                                    <CheckBox x:Name="ChkHandBall" Content="显示「手写」悬浮球（点一下就能手写输入，可拖到任意位置；比逐个窗口找「手写输入」按钮方便）"
                                              FontSize="14" Foreground="{DynamicResource InkBrush}" Margin="2,6,0,0" Click="ChkHandBall_Click"/>
                                    <!-- 单双周：同一格单双周两门课时，只列本周那节（默认），避免一屏灰字 -->
                                    <CheckBox x:Name="ChkBothWeeks" Content="课表同时显示单双周的课程（另一周用灰色标出；不勾选则只显示本周要上的课，更简洁）"
                                              FontSize="14" Foreground="{DynamicResource InkBrush}" Margin="2,10,0,0" Click="ChkBothWeeks_Click"
                                              ToolTip="只影响显示：调代课记录、上课提醒、课表变化检测仍按完整数据计算"/>
                                    <!-- 触屏手势：快速划动=滚动；静止按住 0.5 秒=浮起，原地松手=右键、拖走=换课；
                                         左列「第N节」那块是专用抓手，按下即可拖，不用等长按 -->
                                    <CheckBox x:Name="ChkTwoFinger" Content="触屏手势：按住课程卡左列「第N节」那块可直接拖动换课；按住卡片 0.5 秒浮起后拖动同样能换；快速划动或双指划动＝滚动课表"
                                              FontSize="14" Foreground="{DynamicResource InkBrush}" Margin="2,8,0,0" Click="ChkTwoFinger_Click"
                                              ToolTip="抓手（最省力，推荐）：按住课程卡左边「第N节 / 时间」那块，卡片立刻跟手，拖到别的节松手就交换；按住不动直接松手＝打开调课（同右键）。卡片正文：按住 0.5 秒等地浮起再拖，效果相同。滚动：快速划动或双指划动。单击、双击、长按松手（＝右键）在所有机器上行为一致。"/>
                                </StackPanel>
                            </Border>

                            <!-- 界面主题 -->
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="界面主题" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <TextBlock Text="配色方案" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox x:Name="CbTheme" Width="200" FontSize="14" SelectionChanged="CbTheme_SelectionChanged"/>
                                        <Button x:Name="BtnThemeReset" Content="恢复默认" Padding="12,7" FontSize="13" Margin="12,0,0,0"
                                                Click="BtnThemeReset_Click" Background="White" BorderBrush="{DynamicResource InputBorderBrush}" Cursor="Hand"/>
                                    </StackPanel>
                                    <!-- 日期旁的实时时钟：只影响悬浮课表顶部那一行，不额外占高度 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="日期旁时钟" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox x:Name="CbClockMode" Width="170" FontSize="14"
                                                  SelectionChanged="CbClockMode_SelectionChanged"
                                                  ToolTip="在悬浮课表的日期右侧显示当前时间（每秒跳动）；「不显示」则不占位置"/>
                                    </StackPanel>
                                    <!-- 全局玻璃底色：r77 从「布局设置」迁到界面主题；改动即时生效（与配色一样逐项落盘） -->
                                    <StackPanel Margin="0,14,0,0">
                                        <TextBlock Text="全局玻璃底色" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,4"/>
                                        <CheckBox x:Name="ChkGlassOn" Content="开启玻璃效果（默认关闭；老机器 / 远程桌面可随时关掉）"
                                                  FontSize="13" Foreground="{DynamicResource InkBrush}" Margin="0,4,0,2"/>
                                        <CheckBox x:Name="ChkGlassFloat" Content="悬浮窗（课表 / 便签 / 通知条）"
                                                  FontSize="13" Foreground="{DynamicResource InkBrush}" Margin="20,2,0,0"/>
                                        <Grid Margin="40,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="SlGlass" Grid.Column="0" Minimum="0" Maximum="65" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtGlass" Grid.Column="1" Width="70" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>
                                        <CheckBox x:Name="ChkGlassAll" Content="主窗 / 设置 / 编辑窗口"
                                                  FontSize="13" Foreground="{DynamicResource InkBrush}" Margin="20,6,0,0"/>
                                        <Grid Margin="40,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="SlGlassChrome" Grid.Column="0" Minimum="0" Maximum="65" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtGlassChrome" Grid.Column="1" Width="70" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="40,8,0,0">
                                            <TextBlock Text="系统档位" FontSize="13" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ComboBox x:Name="CbGlassMode" Width="112" FontSize="13" VerticalAlignment="Center">
                                                <ComboBoxItem Tag="auto" Content="自动"/>
                                                <ComboBoxItem Tag="acrylic" Content="亚克力"/>
                                                <ComboBoxItem Tag="mica" Content="云母"/>
                                                <ComboBoxItem Tag="frosted" Content="磨砂"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button x:Name="BtnCancelBackdrop" Content="取消桌面背景（恢复悬浮窗）…" Padding="14,7" FontSize="13"
                                            HorizontalAlignment="Left" Margin="0,10,0,0" Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" Cursor="Hand"
                                            ToolTip="撤掉画在壁纸上的课表 / 便签，恢复系统原壁纸，并把当初隐藏的课表 / 便签放回悬浮窗"
                                            Click="BtnCancelBackdrop_Click"/>
                                </StackPanel>
                            </Border>

                            <!-- ④ 课表周视图：周起始日已移到「周课程表」标签的工具栏（清除本周调课右边），此处不再重复 -->

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 提醒设置（独立标签页） -->
                <TabItem Header="提醒设置">
                    <ScrollViewer x:Name="ReminderScroll" Margin="14" PanningMode="VerticalOnly">
                        <StackPanel MaxWidth="780">
                            <TextBlock Text="⏰ 上下课提醒" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,4"/>

                            <CheckBox x:Name="ChkRemindEnabled" Content="启用上下课提醒（总开关）"
                                      FontSize="15" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,12" Click="RemindSetting_Changed"/>

                            <!-- 文案占位符说明已并入「提示语·标题」那一行的行末 -->
                            <!-- 上课提醒：三组卡片共用 ReminderCard / ReminderInput / ReminderLabel 样式，
                                 x:Name、事件、文案、Margin 全部保持原样，只编辑差异 -->
                            <Border Style="{StaticResource ReminderCard}">
                                <StackPanel>
                                    <CheckBox x:Name="ChkCsOn" Content="上课提醒（课前 / 上课）" Style="{StaticResource ReminderSwitch}" Click="RemindSetting_Changed"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="提前" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtCsLead" Style="{StaticResource ReminderLeadInput}" TextChanged="RemindSetting_TextChanged" ToolTip="提前多少秒提醒；0 = 仅在上课时刻提醒"/>
                                        <TextBlock Text="秒提醒（精确到秒）" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="提示语·标题" Style="{StaticResource ReminderLabel}"/>
                                        <TextBox x:Name="TxtCsTitle" Style="{StaticResource ReminderInput}" TextChanged="RemindSetting_TextChanged"/>
                                        <ctl:HelpBubble PopupTitle="文案占位符" Text="文案占位符：{p}=节次　{s}=科目　{t}=时间(HH:mm)。可在下列框中自由改写。" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="提示语·详情" Style="{StaticResource ReminderLabel}"/>
                                        <TextBox x:Name="TxtCsDetail" Style="{StaticResource ReminderInput}" TextChanged="RemindSetting_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="语音内容" Style="{StaticResource ReminderLabel}"/>
                                        <TextBox x:Name="TxtCsVoice" Style="{StaticResource ReminderInput}" TextChanged="RemindSetting_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="弹幕内容" Style="{StaticResource ReminderLabel}"/>
                                        <TextBox x:Name="TxtCsDanmaku" Style="{StaticResource ReminderInput}" TextChanged="RemindSetting_TextChanged" ToolTip="留空则不向通知条推送弹幕"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 下课提醒 -->
                            <Border Style="{StaticResource ReminderCard}">
                                <StackPanel>
                                    <CheckBox x:Name="ChkCeOn" Content="下课提醒（下课前 / 下课）" Style="{StaticResource ReminderSwitch}" Click="RemindSetting_Changed"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="提前" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtCeLead" Style="{StaticResource ReminderLeadInput}" TextChanged="RemindSetting_TextChanged" ToolTip="提前多少秒提醒；0 = 仅在下课时刻提醒"/>
                                        <TextBlock Text="秒提醒（精确到秒）" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="提示语·标题" Style="{StaticResource ReminderLabel}"/>
                                        <TextBox x:Name="TxtCeTitle" Style="{StaticResource ReminderInput}" TextChanged="RemindSetting_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="提示语·详情" Style="{StaticResource ReminderLabel}"/>
                                        <TextBox x:Name="TxtCeDetail" Style="{StaticResource ReminderInput}" TextChanged="RemindSetting_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="语音内容" Style="{StaticResource ReminderLabel}"/>
                                        <TextBox x:Name="TxtCeVoice" Style="{StaticResource ReminderInput}" TextChanged="RemindSetting_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="弹幕内容" Style="{StaticResource ReminderLabel}"/>
                                        <TextBox x:Name="TxtCeDanmaku" Style="{StaticResource ReminderInput}" TextChanged="RemindSetting_TextChanged" ToolTip="留空则不向通知条推送弹幕"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 放学提醒 -->
                            <Border Style="{StaticResource ReminderCard}">
                                <StackPanel>
                                    <CheckBox x:Name="ChkAsOn" Content="放学提醒（当天最后一节结束后）" Style="{StaticResource ReminderSwitch}" Click="RemindSetting_Changed"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="提前" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtAsLead" Style="{StaticResource ReminderLeadInput}" TextChanged="RemindSetting_TextChanged" ToolTip="提前多少秒提醒；0 = 仅在下课时刻提醒"/>
                                        <TextBlock Text="秒提醒（精确到秒）" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="提示语·标题" Style="{StaticResource ReminderLabel}"/>
                                        <TextBox x:Name="TxtAsTitle" Style="{StaticResource ReminderInput}" TextChanged="RemindSetting_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="提示语·详情" Style="{StaticResource ReminderLabel}"/>
                                        <TextBox x:Name="TxtAsDetail" Style="{StaticResource ReminderInput}" TextChanged="RemindSetting_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="语音内容" Style="{StaticResource ReminderLabel}"/>
                                        <TextBox x:Name="TxtAsVoice" Style="{StaticResource ReminderInput}" TextChanged="RemindSetting_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="弹幕内容" Style="{StaticResource ReminderLabel}"/>
                                        <TextBox x:Name="TxtAsDanmaku" Style="{StaticResource ReminderInput}" TextChanged="RemindSetting_TextChanged" ToolTip="留空则不向通知条推送弹幕"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="弹窗显示" FontSize="14" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtRemindSeconds" Width="48" FontSize="14" Margin="6,0" TextAlignment="Center" TextChanged="RemindSetting_TextChanged" ToolTip="提醒窗口停留几秒后自动消失"/>
                                <TextBlock Text="秒" FontSize="14" VerticalAlignment="Center" Margin="0,0,26,0"/>
                                <CheckBox x:Name="ChkRemindSound" Content="提醒时播放提示音" FontSize="14" Click="RemindSetting_Changed"/>
                            </StackPanel>

                            <!-- 课表变化提醒（与上下课提醒独立：按时段 vs 按内容变化） -->
                            <Border Background="#FFF8E6" BorderBrush="#E6C25A" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,14,0,0">
                                <StackPanel>
                                    <CheckBox x:Name="ChkChangeOn" Content="课表有变化时提醒（手动调课 / 导入临时表 / 更新课表）"
                                              FontSize="15" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Click="RemindSetting_Changed"
                                              ToolTip="只在课表内容真的发生变化时提示：同一天、同一个班的课表没变就不打扰"/>

                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox x:Name="ChkChangeFull" Content="用全屏大字提示（不勾 = 屏幕顶部小窗）"
                                                  FontSize="14" VerticalAlignment="Center" Click="RemindSetting_Changed"/>
                                        <TextBlock Text="停留" FontSize="14" VerticalAlignment="Center" Margin="22,0,6,0"/>
                                        <TextBox x:Name="TxtChangeSeconds" Width="48" FontSize="14" TextAlignment="Center"
                                                 TextChanged="RemindSetting_TextChanged" ToolTip="变化提示显示几秒后自动消失（默认 15 秒）"/>
                                        <TextBlock Text="秒" FontSize="14" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                    </WrapPanel>

                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0">
                                        <TextBlock Text="同时在课表状态栏用红字保留" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtChangeStatusMin" Width="48" FontSize="14" Margin="6,0" TextAlignment="Center"
                                                 TextChanged="RemindSetting_TextChanged" ToolTip="红字挂在悬浮课表最下方状态栏多久（默认 10 分钟）"/>
                                        <TextBlock Text="分钟" FontSize="14" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="ChkChangeVoice" Content="🔊 变化时语音播报" FontSize="14" Margin="26,0,0,0"
                                                  VerticalAlignment="Center" Click="RemindSetting_Changed"
                                                  ToolTip="音色 / 语速 / 音量沿用下方「语音播报」里的设置"/>
                                    </WrapPanel>

                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0">
                                        <TextBlock Text="若变化发生在「上课时间」内，则延后到该节下课后" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtChangeDelay" Width="48" FontSize="14" Margin="6,0" TextAlignment="Center"
                                                 TextChanged="RemindSetting_TextChanged" ToolTip="课堂上不打断教学；填 0 = 仍然立即弹窗"/>
                                        <TextBlock Text="分钟再弹窗（0 = 立即弹）" FontSize="14" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="TxtChangeDelayHint" FontSize="12" Margin="0,4,0,0"
                                               TextWrapping="Wrap" Text=""/>

                                    <!--
                                        提示外观：小窗（上下课提醒 + 变化提示）与全屏大字提示共用同一套，
                                        改这里三处一起变。配色只有一处真值来源 —— ReminderVisualStyle。
                                    -->
                                    <Border Background="White" BorderBrush="#E6C25A" BorderThickness="1" CornerRadius="9"
                                            Padding="12,10" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="提示外观（全屏大字与顶部小窗共用同一套）"
                                                       FontSize="14" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                                                <TextBlock Text="风格" FontSize="14" VerticalAlignment="Center" Width="64"/>
                                                <ComboBox x:Name="CbPopupStyle" Width="230" FontSize="14"
                                                          SelectionChanged="PopupStyle_Changed"/>
                                                <Button x:Name="BtnPopupPreview" Content="预览效果" Padding="12,4" FontSize="13" Margin="10,0,0,0"
                                                        Background="White" BorderBrush="{DynamicResource InputBorderBrush}" Click="BtnPopupPreview_Click"
                                                        ToolTip="按当前设置立刻弹一次示例提示：勾了「全屏大字」就弹全屏，否则弹小窗"/>
                                            </WrapPanel>

                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0">
                                                <TextBlock Text="不透明度" FontSize="14" VerticalAlignment="Center" Width="64"/>
                                                <Slider x:Name="SlPopupOpacity" Minimum="55" Maximum="100" TickFrequency="5"
                                                        IsSnapToTickEnabled="True" Width="200" VerticalAlignment="Center"
                                                        ValueChanged="PopupStyle_ValueChanged"
                                                        ToolTip="只把卡片底色调淡，文字保持清晰；调太低后排会看不清，所以最低 55%"/>
                                                <TextBlock x:Name="TxtPopupOpacity" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </WrapPanel>

                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,8,0,0">
                                                <TextBlock Text="字号" FontSize="14" VerticalAlignment="Center" Width="64"/>
                                                <Slider x:Name="SlPopupFont" Minimum="80" Maximum="180" TickFrequency="5"
                                                        IsSnapToTickEnabled="True" Width="200" VerticalAlignment="Center"
                                                        ValueChanged="PopupStyle_ValueChanged"
                                                        ToolTip="在「调整小窗位置与大小」的缩放之外再乘一道，全屏与大字的字号同步变化"/>
                                                <TextBlock x:Name="TxtPopupFont" FontSize="13" Foreground="{DynamicResource MutedBrush}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </WrapPanel>

                                            <WrapPanel x:Name="WrapPopupCustom" Orientation="Horizontal" VerticalAlignment="Center"
                                                       Margin="0,8,0,0">
                                                <TextBlock Text="自定义" FontSize="14" VerticalAlignment="Center" Width="64"/>
                                                <TextBlock Text="字色" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <ComboBox x:Name="CbPopupText" Width="120" FontSize="14"
                                                          ItemTemplate="{StaticResource ColorSwatchTpl}"
                                                          SelectionChanged="PopupStyle_Changed"/>
                                                <Button Content="调色…" Padding="9,3" FontSize="12" Margin="6,0,0,0"
                                                        Background="White" BorderBrush="{DynamicResource InputBorderBrush}" Click="BtnPopupTextPick_Click"/>
                                                <TextBlock Text="底色" FontSize="13" VerticalAlignment="Center" Margin="14,0,6,0"/>
                                                <ComboBox x:Name="CbPopupCard" Width="120" FontSize="14"
                                                          ItemTemplate="{StaticResource ColorSwatchTpl}"
                                                          SelectionChanged="PopupStyle_Changed"/>
                                                <Button Content="调色…" Padding="9,3" FontSize="12" Margin="6,0,0,0"
                                                        Background="White" BorderBrush="{DynamicResource InputBorderBrush}" Click="BtnPopupCardPick_Click"/>
                                            </WrapPanel>

                                        </StackPanel>
                                    </Border>

                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,12,0,0">
                                        <Button x:Name="BtnPopupLayout" Content="调整小窗位置与大小…" Padding="12,5" FontSize="13"
                                                Background="White" BorderBrush="{DynamicResource InputBorderBrush}" Click="BtnPopupLayout_Click"
                                                ToolTip="打开一个与实际提醒一模一样的小窗：拖动它移动位置、拖右边框改大小，回车或点「保存」生效"/>
                                        <TextBlock x:Name="TxtPopupLayout" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0" Text=""/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="#F4F8FF" BorderBrush="{DynamicResource PrimaryBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,14,0,0">
                                <StackPanel>
                                    <CheckBox x:Name="ChkRemindVoice" Content="🔊 语音播报（用系统语音朗读提醒内容）"
                                              FontSize="15" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Click="RemindSetting_Changed"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <TextBlock Text="音色" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="CbRemindVoice" Width="340" FontSize="14" SelectionChanged="RemindVoice_Selected" ToolTip="系统已安装的语音；可到 Windows「设置 → 时间和语言 → 语音」安装更多音色"/>
                                        <Button x:Name="BtnVoiceTest" Content="试听" FontSize="13" Padding="12,4" Margin="10,0,0,0" Click="BtnVoiceTest_Click"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <TextBlock Text="语速" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Slider x:Name="SlVoiceRate" Minimum="-10" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Width="240" ValueChanged="RemindVoice_ValueChanged" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtVoiceRate" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="音量" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Slider x:Name="SlVoiceVolume" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                                Width="240" ValueChanged="RemindVoice_ValueChanged" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtVoiceVolume" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 通知公告 -->
                <TabItem Header="通知公告">
                    <ScrollViewer Margin="14" PanningMode="VerticalOnly">
                        <StackPanel MaxWidth="640">
                            <TextBlock Text="📢 通知 / 公告管理" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,12"/>

                            <!-- 通知条字体与背景：简单预设，选中即应用到顶部字幕条 -->
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="通知条字体与背景" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                                    <!-- r75：与各编辑窗同一条「格式设置条」。
                                         字号用 A⁻ / A⁺ 按档位步进（12～96 共 22 档），文字颜色用 A▾ 色板弹层；
                                         字体与背景不是「格式」，仍用下拉。外观全部走 DesignTokens 的 Bar* 令牌。 -->
                                    <WrapPanel Margin="0,6,0,2">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,6">
                                            <TextBlock Text="字体" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox x:Name="CbNotifFont" Width="178" FontSize="14" SelectionChanged="NotifStyle_Changed"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                            <TextBlock Text="背景" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <ComboBox x:Name="CbNotifBg" Width="132" FontSize="14" SelectionChanged="NotifStyle_Changed">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="2">
                                                            <Rectangle Width="16" Height="16" RadiusX="3" RadiusY="3" Fill="{Binding Swatch}" Stroke="{DynamicResource HintBrush}" StrokeThickness="1" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button x:Name="BtnNotifBgPick" Content="调色…" Padding="9,3" FontSize="12" Margin="6,0,0,0"
                                                    Background="White" BorderBrush="{DynamicResource InputBorderBrush}" Click="BtnNotifBgPick_Click"
                                                    ToolTip="用系统取色器选任意背景色（预设里没有的颜色也能用）"/>
                                        </StackPanel>
                                    </WrapPanel>

                                    <!-- 格式条本体：与 5 个编辑窗、倒计时卡片同一条样式 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <Border Style="{DynamicResource BarSurfaceStyle}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button x:Name="BtnNotifSizeDown" Content="A⁻" Width="28"
                                                        Style="{DynamicResource BarButtonStyle}"
                                                        ToolTip="字号调小一档" Click="BtnNotifSizeDown_Click"/>
                                                <TextBlock x:Name="TxtNotifSize" Width="56" Text="28 号" TextAlignment="Center"
                                                           FontSize="13" Foreground="#374151" VerticalAlignment="Center"
                                                           ToolTip="字号档位：12～96（22 档）。特大字号若被通知条上下边切掉，把通知条拖高一点即可"/>
                                                <Button x:Name="BtnNotifSizeUp" Content="A⁺" Width="28"
                                                        Style="{DynamicResource BarButtonStyle}"
                                                        ToolTip="字号调大一档" Click="BtnNotifSizeUp_Click"/>
                                                <Rectangle Width="1" Height="16" Fill="{DynamicResource BarDividerBrush}"
                                                           Margin="3,0" VerticalAlignment="Center"/>
                                                <Button x:Name="BtnNotifColor" Style="{DynamicResource BarButtonStyle}"
                                                        ToolTip="通知条文字颜色" Click="BtnNotifColor_Click">
                                                    <Grid Width="32" Height="24">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="A" Grid.Row="0" Grid.Column="0" FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="#374151" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Margin="0,0,0,1"/>
                                                        <TextBlock Text="▾" Grid.Row="0" Grid.Column="1" FontSize="7" Foreground="{DynamicResource MutedBrush}"
                                                                   VerticalAlignment="Bottom" Margin="1,0,0,3"/>
                                                        <Rectangle x:Name="NotifColorBar" Grid.Row="1" Grid.ColumnSpan="2" Height="3"
                                                                   RadiusX="1.5" RadiusY="1.5" Fill="#FFFFFF"
                                                                   Stroke="{DynamicResource HintBrush}" StrokeThickness="0.6" Margin="2,0,2,1"/>
                                                    </Grid>
                                                </Button>
                                                <Rectangle Width="1" Height="16" Fill="{DynamicResource BarDividerBrush}"
                                                           Margin="3,0" VerticalAlignment="Center"/>
                                                <Button x:Name="BtnNotifReset" Width="30" Style="{DynamicResource BarButtonStyle}"
                                                        Foreground="{DynamicResource MutedBrush}" ToolTip="恢复默认：微软雅黑 / 28 号 / 白字 / 深蓝底"
                                                        Click="BtnNotifReset_Click">
                                                    <Grid Width="18" Height="18">
                                                        <Path Data="M2,12 L8,6 A2,2 0 0 1 10.8,6 L13,8.2 A2,2 0 0 1 13,11 L8,16 H4 Z"
                                                              Fill="{DynamicResource HintBrush}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="0.9" Stretch="None"/>
                                                        <Path Data="M5,15.4 L11.4,9" Stroke="#E8EDF3" StrokeThickness="1.5" Stretch="None"/>
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="TxtNotifStyleMeta" FontSize="11" Foreground="{DynamicResource HintBrush}"
                                                   VerticalAlignment="Center" Margin="10,0,0,1"/>
                                    </StackPanel>

                                    <!-- 文字颜色色板：与格式条同一个弹层形态（点外面就关，一体机没有右键语境） -->
                                    <Popup x:Name="NotifColorPopup" Placement="Bottom" StaysOpen="False"
                                           AllowsTransparency="True" PopupAnimation="Fade"
                                           PlacementTarget="{Binding ElementName=BtnNotifColor}" HorizontalOffset="-96">
                                        <Border Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="8" Margin="4">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.18" Color="#000000"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <TextBlock Text="通知条文字颜色" FontSize="11" Foreground="{DynamicResource HintBrush}" Margin="2,0,0,6"/>
                                                <UniformGrid x:Name="NotifSwatchGrid" Columns="6"/>
                                                <Button x:Name="BtnNotifMoreColor" Content="更多颜色…" Height="26" Margin="0,6,0,0"
                                                        Style="{DynamicResource BarButtonStyle}" Padding="10,0"
                                                        HorizontalAlignment="Left" Foreground="{DynamicResource PrimaryBrush}"
                                                        ToolTip="从系统调色板里选任意颜色（选过的颜色会留在色板里）"
                                                        Click="BtnNotifMoreColor_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>

                                    <Border x:Name="NotifPreview" CornerRadius="10" Padding="12,8" Margin="0,4,0,0">
                                        <TextBlock x:Name="NotifPreviewText" Text="预览：今天下午第 8 节后全校大扫除"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="新公告" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="标题（选填）" FontSize="14" Foreground="{DynamicResource BodyBrush}"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBox Grid.Column="1" x:Name="TxtNewTitle" FontSize="15" Padding="10" Background="White" BorderBrush="{DynamicResource InputBorderBrush}"
                                             ToolTip="标题会显示在内容前面，例如「通知」「紧急」"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="公告内容" FontSize="14" Foreground="{DynamicResource BodyBrush}"
                                               VerticalAlignment="Top" Margin="0,10,10,0"/>
                                    <TextBox Grid.Column="1" x:Name="TxtNewContent" FontSize="14" Padding="10" Height="72" TextWrapping="Wrap" AcceptsReturn="True" Background="White" BorderBrush="{DynamicResource InputBorderBrush}"
                                             ToolTip="通知 / 公告内容：输入后点「添加通知」，顶部字幕条会滚动显示"/>
                                </Grid>
                                <!-- 通知范围：全校 / 本班。全校的会随数据包同步到所有教室机 -->
                                <Border Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox x:Name="ChkNewNoticeSchool" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"
                                                      Content="设为全校通知（随数据包同步到所有教室机）"
                                                      ToolTip="勾选后这条通知会写进数据包，各教室机导入 / 自动更新后都会滚动显示；不勾选只在本机显示。"/>
                                            <ctl:HelpBubble PopupTitle="通知范围" Text="默认「本班通知」：只在本机显示，不打进数据包。「发布到数据源」或勾选「本机兼任发布机」时，全校通知才会同步出去。" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <DockPanel>
                                    <Button x:Name="BtnAddNotice" Content="添加通知" Padding="14,7" FontSize="14" DockPanel.Dock="Left"
                                            Style="{DynamicResource AppPrimaryButton}" Click="BtnAddNotice_Click"/>
                                    <TextBlock Text="标题选填；内容支持多行。添加后立即在顶部字幕条滚动显示。" FontSize="12" Foreground="{DynamicResource HintBrush}"
                                               VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                                </DockPanel>
                            </StackPanel>
                            <ItemsControl x:Name="NotificationsPanel">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource HintBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Scope}" Value="school">
                                                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding ScopeText}" FontSize="11" Foreground="White"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                                        <Button Content="{Binding ScopeButtonText}" FontSize="12" Padding="10,3" Margin="0,0,6,0"
                                                                Click="BtnNoticeScope_Click" Tag="{Binding Id}"
                                                                ToolTip="切换这条通知的范围：全校 = 随数据包同步到所有教室机；本班 = 只在本机显示"/>
                                                        <Button Content="{Binding PinButtonText}" FontSize="12" Padding="10,3" Margin="0,0,6,0"
                                                                Click="BtnPin_Click" Tag="{Binding Id}"/>
                                                        <Button Content="删除" FontSize="12" Padding="10,3"
                                                                Click="BtnDeleteNotice_Click" Tag="{Binding Id}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Content}" FontSize="14" Foreground="{DynamicResource BodyBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                                <TextBlock Text="{Binding CreatedText}" FontSize="11" Foreground="#B0B6BF" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <!-- 便签管理：只放预览 + 编辑按钮，内容 / 格式 / 主题都在弹窗里改 -->
                <TabItem Header="便签管理">
                    <ScrollViewer x:Name="NotesScroll" Margin="14" PanningMode="VerticalOnly">
                        <StackPanel MaxWidth="820">
                            <!-- 标题行右侧放整页唯一的主操作：无论窗口多高都看得见，不用往下滚 -->
                            <Grid Margin="0,0,0,14">
                                <Button x:Name="BtnWpSettings" Content="🖱 桌面背景排版…" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Padding="14,6" FontSize="13"
                                        Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}"
                                        Click="BtnWpSettings_Click"
                                        ToolTip="打开所见即所得排版：直接拖动便签调整位置、拉边框改大小"/>
                                <StackPanel Margin="0,0,170,0">
                                    <TextBlock Text="📋 便签管理" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,4"/>
                                </StackPanel>
                            </Grid>

                            <!-- ① 有预览的两张：看效果、开显隐、进编辑都在同一张卡里，不用在一排按钮里找 -->
                            <WrapPanel>
                                <Border Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,14,14" Width="380">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="📚 作业公示" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                                            <Button x:Name="BtnEditHw" Content="编辑内容与格式…" HorizontalAlignment="Right"
                                                    Padding="12,4" FontSize="13" Background="White" BorderBrush="{DynamicResource InputBorderBrush}"
                                                    Click="BtnEditHw_Click"
                                                    ToolTip="打开编辑窗口：科目、作业内容、文字格式（加粗 / 颜色 / 字号）与主题风格"/>
                                        </Grid>
                                        <Border Background="{DynamicResource BarSurfaceBrush}" CornerRadius="8" Padding="6" Height="300">
                                            <Image x:Name="ImgHwPreview" Stretch="Uniform" StretchDirection="DownOnly"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   ToolTip="当前作业公示便签的样子（含主题风格与文字格式）"/>
                                        </Border>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button x:Name="BtnToggleHw2" Content="显示作业便签" Padding="10,5" FontSize="13" Margin="0,0,8,0"
                                                    Background="White" BorderBrush="{DynamicResource InputBorderBrush}" Click="BtnToggleHw_Click"
                                                    ToolTip="在屏幕上显示 / 隐藏作业公示悬浮便签"/>
                                            <!-- P2 隐藏回退：桌面背景显隐已统一到右上角「桌面背景排版…」，控件与事件都保留，把 Visibility 改回 Visible 即可恢复 -->
                                            <Button x:Name="BtnHwWp" Content="作业→桌面背景：关" Padding="10,5" FontSize="13" Visibility="Collapsed"
                                                    Background="White" BorderBrush="{DynamicResource InputBorderBrush}" Click="BtnHwWp_Click"
                                                    ToolTip="把作业公示画到桌面壁纸上（位于所有窗口之下，不遮挡操作）"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Background="White" BorderBrush="#F3C9C4" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14" Width="380">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="📕 缺交作业名单" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
                                            <Button x:Name="BtnEditMs" Content="编辑内容与格式…" HorizontalAlignment="Right"
                                                    Padding="12,4" FontSize="13" Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" Foreground="{DynamicResource DangerBrush}"
                                                    Click="BtnEditMs_Click"
                                                    ToolTip="打开缺交名单编辑窗口：科目、学生姓名、文字格式与主题风格"/>
                                        </Grid>
                                        <Border Background="#FFF6F5" CornerRadius="8" Padding="6" Height="300">
                                            <Image x:Name="ImgMsPreview" Stretch="Uniform" StretchDirection="DownOnly"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   ToolTip="当前缺交名单便签的样子（含主题风格与文字格式）"/>
                                        </Border>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button x:Name="BtnToggleMs2" Content="显示缺交便签" Padding="10,5" FontSize="13" Margin="0,0,8,0"
                                                    Background="White" BorderBrush="{DynamicResource InputBorderBrush}" Click="BtnToggleMs_Click"
                                                    ToolTip="在屏幕上显示 / 隐藏缺交名单悬浮便签"/>
                                            <Button x:Name="BtnMsWp" Content="缺交→桌面背景：关" Padding="10,5" FontSize="13" Visibility="Collapsed"
                                                    Background="White" BorderBrush="{DynamicResource InputBorderBrush}" Click="BtnMsWp_Click"
                                                    ToolTip="把缺交作业名单画到桌面壁纸上（位于所有窗口之下）"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <!-- ② 没有预览的便签：一行一项，左侧名称 + 一句说明，右侧「显隐 / 编辑」——
                                 比原来一排长得一样的彩色按钮更好认，也不用猜哪个按钮管哪张便签 -->
                            <Border Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,2,0,0">
                                <StackPanel>
                                    <TextBlock Text="其他便签" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>

                                    <DockPanel Margin="0,12,0,0" LastChildFill="True">
                                        <Button x:Name="BtnCustomNote" DockPanel.Dock="Right" Content="新增 / 编辑…" VerticalAlignment="Center"
                                                Padding="12,5" FontSize="13" Background="White" BorderBrush="{DynamicResource InputBorderBrush}"
                                                Click="BtnCustomNote_Click"
                                                ToolTip="打开编辑窗口：可新建便签或选择已有便签，设置标题、内容、文字格式（加粗 / 字色 / 字号）与主题风格"/>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="🗒 自定义便签" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                                            <TextBlock Text="教师寄语、温馨提示等，可多张并存" FontSize="12" Foreground="{DynamicResource HintBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <Border Height="1" Background="#EEF2F7" Margin="0,12,0,0"/>

                                    <DockPanel Margin="0,12,0,0" LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="BtnToggleCd" Content="显示倒计时便签" Padding="10,5" FontSize="13" Margin="0,0,8,0"
                                                    Background="White" BorderBrush="{DynamicResource InputBorderBrush}" Click="BtnToggleCd_Click"
                                                    ToolTip="在屏幕上显示 / 隐藏倒计时悬浮便签（可拖动、可拉边改大小）"/>
                                            <Button x:Name="BtnEditCountdown" Content="编辑…" Padding="12,5" FontSize="13"
                                                    Background="#FFF8E1" BorderBrush="#E8CE8A" Foreground="#8D6E00"
                                                    Click="BtnEditCountdown_Click"
                                                    ToolTip="编辑倒计时便签：事件名称、目标日期、备注，以及标题 / 条目字体颜色与主题风格"/>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="⏳ 倒计时" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                                            <TextBlock Text="距离考试、活动还剩几天，每天自动重算" FontSize="12" Foreground="{DynamicResource HintBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <Border Height="1" Background="#EEF2F7" Margin="0,12,0,0"/>

                                    <DockPanel Margin="0,12,0,0" LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="BtnToggleDuty" Content="显示值日便签" Padding="10,5" FontSize="13" Margin="0,0,8,0"
                                                    Background="White" BorderBrush="{DynamicResource InputBorderBrush}" Click="BtnToggleDuty_Click"
                                                    ToolTip="在屏幕上显示 / 隐藏值日生名单悬浮便签（可拖动、可拉边改大小）"/>
                                            <Button x:Name="BtnEditDuty" Content="编辑…" Padding="12,5" FontSize="13"
                                                    Background="#E8F5E9" BorderBrush="#A5CFA8" Foreground="#1B5E20"
                                                    Click="BtnEditDuty_Click"
                                                    ToolTip="编辑值日生名单：按星期填姓名与值日内容，可设标题 / 内容字体颜色与主题风格"/>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="🧹 值日名单" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                                            <TextBlock Text="按星期轮值的值日安排" FontSize="12" Foreground="{DynamicResource HintBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <Border Height="1" Background="#EEF2F7" Margin="0,12,0,0"/>

                                    <!-- 通知公告：通知 / 公告的便签形态。与上面三张同构，
                                         跑马灯只保留「最新两条」的摘要，完整清单在这里 -->
                                    <DockPanel Margin="0,12,0,0" LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="BtnToggleNotice" Content="显示通知公告便签" Padding="10,5" FontSize="13" Margin="0,0,8,0"
                                                    Background="White" BorderBrush="{DynamicResource InputBorderBrush}" Click="BtnToggleNotice_Click"
                                                    ToolTip="在屏幕上显示 / 隐藏通知公告悬浮便签（可拖动、可拉边改大小）"/>
                                            <Button x:Name="BtnEditNotice" Content="编辑…" Padding="12,5" FontSize="13"
                                                    Background="#E3F2FD" BorderBrush="#BBDEFB" Foreground="#0D47A1"
                                                    Click="BtnEditNotice_Click"
                                                    ToolTip="打开通知编辑窗口：新增事项、改内容与范围、设截止日期（到期自动撤下，数据保留）"/>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="📌 通知公告" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                                            <TextBlock Text="通知 / 公告的便签形态：按截止日期排，到期的自动撤下" FontSize="12" Foreground="{DynamicResource HintBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 信息管理：作业 / 缺交 / 通知的跨机发布。
                     菜单栏（发布 / 检查 / 快照 / 台账）、任教班级、三类内容、同步设置全部集中在这一页，
                     不再把入口塞在「便签管理」的作业卡片里。 -->
                <TabItem Header="信息管理" x:Name="TabInfoManage">
                    <ScrollViewer Margin="14" PanningMode="VerticalOnly">
                        <StackPanel MaxWidth="980">
                            <!-- 标题 + 说明。P2：页内只保留下面四类内容的直达发布入口，通用发布统一走左侧「消息 → 发布信息」 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="📨 信息管理" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,4"/>
                                </StackPanel>
                                <!-- P2 隐藏回退：通用发布按钮与下面四类直达重复，控件与事件保留，改回 Visible 即可恢复 -->
                                <Button x:Name="BtnInfoPublish" Grid.Column="1" Content="＋ 发布信息" Padding="20,10" FontSize="15" Visibility="Collapsed"
                                        VerticalAlignment="Center" Background="{DynamicResource PrimaryLightBrush}"
                                        BorderBrush="{DynamicResource PrimaryBorderBrush}" Click="BtnInfoPublish_Click"
                                        ToolTip="把一条信息发给勾选的任教班级（可多选）"/>
                            </Grid>

                            <!-- 菜单栏：一行常用动作 + 状态 -->
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,14">
                                <DockPanel LastChildFill="True">
                                    <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                        <Button x:Name="BtnInfoPull" Content="↻ 立即检查" Padding="12,6" FontSize="13" Margin="0,0,8,4" Click="BtnInfoPull_Click"/>
                                        <Button x:Name="BtnInfoSnapshot" Content="👀 教室机当前内容" Padding="12,6" FontSize="13" Margin="0,0,8,4" Click="BtnInfoSnapshot_Click"/>
                                        <Button x:Name="BtnInfoLedger" Content="📋 消息台账 / 回执" Padding="12,6" FontSize="13" Margin="0,0,8,4" Click="BtnInfoLedger_Click"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="TxtInfoStatus" FontSize="12" Foreground="{DynamicResource BodyBrush}" TextWrapping="Wrap"
                                               VerticalAlignment="Center" Margin="10,0,0,4"/>
                                </DockPanel>
                            </Border>

                            <!-- ① 任教班级：下拉选取 → 形成自己的班级列表 → 勾选作为发布目标 -->
                            <Border Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="① 我的任教班级" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,4"/>
                                    <DockPanel Margin="0,0,0,10" LastChildFill="False">
                                        <TextBlock Text="增加任课班级" FontSize="14" Foreground="{DynamicResource BodyBrush}" VerticalAlignment="Center" Margin="0,0,10,0" DockPanel.Dock="Left"/>
                                        <ComboBox x:Name="CbTeachingClass" Width="230" FontSize="14" DockPanel.Dock="Left"
                                                  SelectionChanged="CbTeachingClass_SelectionChanged"
                                                  ToolTip="从已导入的班级里选；选中后立即加入下面的任教班级列表"/>
                                        <TextBlock x:Name="TxtTeachingClassHint" FontSize="12" Foreground="{DynamicResource HintBrush}" VerticalAlignment="Center"
                                                   Margin="12,0,0,0" DockPanel.Dock="Left" TextWrapping="Wrap"/>
                                    </DockPanel>
                                    <WrapPanel x:Name="TeachingClassChips" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtTeachingClassEmpty" FontSize="12" Foreground="{DynamicResource HintBrush}" TextWrapping="Wrap"
                                               Text="还没有任教班级：请先在「数据管理」导入全校课表，再从上面的下拉里增加。"/>
                                </StackPanel>
                            </Border>

                            <!-- ② 三类内容：各自一个直达发布入口 -->
                            <TextBlock Text="② 发布哪一类信息" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,8"/>
                            <UniformGrid Columns="2" Margin="0,0,0,14">
                                <Border Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="📚 作业公示" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="按科目发布当天作业，可新增或按教室机现有条目替换。"
                                                   FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Height="36"/>
                                        <Button x:Name="BtnInfoPublishHw" Content="发布作业公示" Padding="12,6" FontSize="13" Tag="hw"
                                                HorizontalAlignment="Left" Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource PrimarySoftBorderBrush}"
                                                Click="BtnInfoPublishType_Click"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="📕 缺交名单" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="发布各科未交作业的学生名单，教室机确认后上墙。"
                                                   FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Height="36"/>
                                        <Button x:Name="BtnInfoPublishMs" Content="发布缺交名单" Padding="12,6" FontSize="13" Tag="ms"
                                                HorizontalAlignment="Left" Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}"
                                                Click="BtnInfoPublishType_Click"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="🧹 值日安排" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="发布某一天的值日岗位与值日生，操作和作业公示一样。"
                                                   FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Height="36"/>
                                        <Button x:Name="BtnInfoPublishDuty" Content="发布值日安排" Padding="12,6" FontSize="13" Tag="duty"
                                                HorizontalAlignment="Left" Background="{DynamicResource SuccessSoftBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}"
                                                Click="BtnInfoPublishType_Click"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,10,10">
                                    <StackPanel>
                                        <TextBlock Text="📢 本班通知" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="发布只在本班显示的提醒 / 通知，不进全校数据包。"
                                                   FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Height="36"/>
                                        <Button x:Name="BtnInfoPublishNotice" Content="发布本班通知" Padding="12,6" FontSize="13" Tag="notice"
                                                HorizontalAlignment="Left" Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource PrimarySoftBorderBrush}"
                                                Click="BtnInfoPublishType_Click"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- ③ 设置：默认收起，页面保持简洁 -->
                            <Expander x:Name="ExpInfoSettings" Header="③ 同步设置（本机）" FontSize="15" Foreground="{DynamicResource InkBrush}"
                                      IsExpanded="False" Margin="0,0,0,10">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,8,0,0">
                                    <StackPanel>
                                        <WrapPanel Margin="0,0,0,12">
                                            <CheckBox x:Name="ChkInfoSyncEnabled" Content="启用同步" FontSize="14" Margin="0,0,24,6" VerticalAlignment="Center"/>
                                            <CheckBox x:Name="ChkInfoIsClassroom" Content="本机是教室机（发布内容快照，供教师机选目标条目）"
                                                      FontSize="14" Margin="0,0,24,6" VerticalAlignment="Center"/>
                                            <CheckBox x:Name="ChkInfoPopup" Content="课间弹提示卡" FontSize="14" Margin="0,0,24,6" VerticalAlignment="Center"
                                                      ToolTip="收到新变更单时在右下角弹一张小卡片；上课时间只静默入档，不打断课堂"/>
                                            <CheckBox x:Name="ChkInfoFullScreen" Content="允许课间全屏提醒" FontSize="14" Margin="0,0,24,6" VerticalAlignment="Center"
                                                      ToolTip="教师机发布时勾了「课间全屏提醒」，教室机才会在课间整屏提示；上课时间绝不打断课堂"/>
                                            <CheckBox x:Name="ChkInfoVoice" Content="语音播报收到的变更单" FontSize="14" Margin="0,0,24,6" VerticalAlignment="Center"
                                                      ToolTip="教师机发布时勾了「🔊 语音提醒」，教室机才用系统语音朗读（音色 / 语速 / 音量沿用「提醒设置」）；关掉则一律不念"/>
                                            <CheckBox x:Name="ChkInfoAutoApply" Content="允许通知直接增加（无需电教管理员确认）" FontSize="14" Margin="0,0,0,6" VerticalAlignment="Center"
                                                      ToolTip="教师机发布「本班通知」时可指定直接增加；教室机收到后自动新增一条并回执。关掉后这类单退回普通收件箱由电教管理员裁决，绝不丢消息。自动增加只新增，不覆盖教室机原有内容"/>
                                        </WrapPanel>
                                        <WrapPanel Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,20,6" VerticalAlignment="Center">
                                                <TextBlock Text="摆渡根目录" FontSize="13" Foreground="{DynamicResource BodyBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox x:Name="TxtInfoRoot" Width="290" FontSize="13" Padding="7" Background="White" BorderBrush="{DynamicResource InputBorderBrush}"
                                                         ToolTip="留空 = 跟随「自动更新 / 数据源」的共享目录或 FTP 根"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                                                <TextBlock Text="轮询秒数" FontSize="13" Foreground="{DynamicResource BodyBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox x:Name="TxtInfoPoll" Width="64" FontSize="13" Padding="7" Background="White" BorderBrush="{DynamicResource InputBorderBrush}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="20,0,0,6" VerticalAlignment="Center">
                                                <TextBlock Text="台账保留天数" FontSize="13" Foreground="{DynamicResource BodyBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox x:Name="TxtInfoKeepDays" Width="56" FontSize="13" Padding="7" Background="White" BorderBrush="{DynamicResource InputBorderBrush}"
                                                         ToolTip="消息台账默认显示最近几天的记录（默认 7，0 = 全部显示）。只影响显示范围，记录不会自动删除；真要删除请到台账窗口点「🧹 清除台账…」（教师 / 管理员可用）"/>
                                                <TextBlock Text="天（0=全部）" FontSize="12" Foreground="{DynamicResource HintBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            </StackPanel>
                                        </WrapPanel>
                                        <DockPanel>
                                            <Button x:Name="BtnInfoSaveSettings" Content="保存设置" DockPanel.Dock="Left" Padding="14,7" FontSize="13"
                                                    Background="#E8F6EE" BorderBrush="#7FC99A" Click="BtnInfoSaveSettings_Click"/>
                                            <TextBlock Text="留空根目录时跟随自动更新数据源；教室机保存后会立即发布一次内容快照。"
                                                       FontSize="12" Foreground="{DynamicResource HintBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </Expander>
                            <TextBlock x:Name="TxtInfoHint" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 用户中心：修改用户名与密码 -->
                <TabItem Header="用户中心">
                    <ScrollViewer Margin="14" PanningMode="VerticalOnly">
                        <StackPanel MaxWidth="900">
                            <TextBlock Text="👤 用户中心" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="18,16">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 左列：账号与密码 -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="账号与密码" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,10"/>
                                            <TextBlock Text="当前用户名" FontSize="13" Foreground="{DynamicResource BodyBrush}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtCurUser" FontSize="14" Padding="8" Background="White" BorderBrush="{DynamicResource InputBorderBrush}" IsReadOnly="True" Margin="0,0,0,12"/>
                                            <TextBlock Text="当前密码（修改用户名或密码时必填，只改其他信息可留空）" FontSize="13" Foreground="{DynamicResource BodyBrush}" Margin="0,0,0,4"/>
                                            <PasswordBox x:Name="TxtCurPwd" FontSize="14" Padding="8" Background="White" BorderBrush="{DynamicResource InputBorderBrush}" PasswordChar="*" Margin="0,0,0,12"
                                                         ToolTip="为防止他人误改 / 冒改，改用户名或改密码都要先输入当前密码"/>
                                            <TextBlock Text="新用户名（留空 = 不修改用户名）" FontSize="13" Foreground="{DynamicResource BodyBrush}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtNewUser" FontSize="14" Padding="8" Background="White" BorderBrush="{DynamicResource InputBorderBrush}" Margin="0,0,0,12"
                                                     ToolTip="只想改密码时，这里留空即可"/>
                                            <TextBlock Text="新密码（留空 = 不修改密码）" FontSize="13" Foreground="{DynamicResource BodyBrush}" Margin="0,0,0,4"/>
                                            <PasswordBox x:Name="TxtNewPwd" FontSize="14" Padding="8" Background="White" BorderBrush="{DynamicResource InputBorderBrush}" PasswordChar="*" Margin="0,0,0,12"/>
                                            <TextBlock Text="确认新密码" FontSize="13" Foreground="{DynamicResource BodyBrush}" Margin="0,0,0,4"/>
                                            <PasswordBox x:Name="TxtNewPwd2" FontSize="14" Padding="8" Background="White" BorderBrush="{DynamicResource InputBorderBrush}" PasswordChar="*" Margin="0,0,0,0"/>
                                        </StackPanel>

                                        <!-- 右列：找回密码信息 -->
                                        <StackPanel x:Name="PanelRecovery" Grid.Column="2">
                                            <TextBlock Text="找回密码信息（都可留空）" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,10"/>
                                            <TextBlock Text="电子邮箱" FontSize="13" Foreground="{DynamicResource BodyBrush}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtEmail" FontSize="14" Padding="8" Background="White" BorderBrush="{DynamicResource InputBorderBrush}" Margin="0,0,0,12"/>
                                            <TextBlock Text="手机号码" FontSize="13" Foreground="{DynamicResource BodyBrush}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtPhone" FontSize="14" Padding="8" Background="White" BorderBrush="{DynamicResource InputBorderBrush}" Margin="0,0,0,12"/>
                                            <TextBlock Text="密保问题" FontSize="13" Foreground="{DynamicResource BodyBrush}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="CbSecQuestion" FontSize="14" Padding="6" Background="White" BorderBrush="{DynamicResource InputBorderBrush}" Margin="0,0,0,12">
                                                <ComboBoxItem Content="（不设密保问题）"/>
                                                <ComboBoxItem Content="您母亲的姓名是？"/>
                                                <ComboBoxItem Content="您父亲的姓名是？"/>
                                                <ComboBoxItem Content="您就读的第一所学校的名称？"/>
                                                <ComboBoxItem Content="您最喜欢的老师是谁？"/>
                                                <ComboBoxItem Content="您的出生城市是？"/>
                                                <ComboBoxItem Content="您宠物的名字是？"/>
                                            </ComboBox>
                                            <TextBlock Text="密保答案（设置了密保问题时填写）" FontSize="13" Foreground="{DynamicResource BodyBrush}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TxtSecAnswer" FontSize="14" Padding="8" Background="White" BorderBrush="{DynamicResource InputBorderBrush}" Margin="0,0,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- P2：登录偏好与登录界面写的是同一组设置，这里属低频项，默认收起；
                                         展开后仍是完整三项（隐藏回退），文案与登录界面逐字统一。 -->
                                    <Expander x:Name="ExpLoginPref" Header="登录与自动登录（与登录界面同步，一般不用改）"
                                              IsExpanded="False" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"
                                              Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}"
                                              BorderThickness="1" Margin="0,16,0,0">
                                        <StackPanel Margin="14,8,14,12">
                                            <CheckBox x:Name="ChkRememberUser" Content="记住账号（下次自动填入用户名）" FontSize="14" FontWeight="Normal" Foreground="{DynamicResource InkBrush}" Click="UserLoginPref_Changed"/>
                                            <CheckBox x:Name="ChkRememberPwd" Content="记住密码（下次自动填入，明文保存在本机）" FontSize="14" FontWeight="Normal" Foreground="{DynamicResource InkBrush}" Margin="0,8,0,0" Click="UserLoginPref_Changed"/>
                                            <CheckBox x:Name="ChkAutoLogin" Content="开机自动登录（跳过登录界面）" FontSize="14" FontWeight="Normal" Foreground="{DynamicResource InkBrush}" Margin="0,8,0,0" Click="UserLoginPref_Changed"
                                                      ToolTip="需要同时「记住密码」；管理员账号永不自动登录（防止教室机开机即管理员）。"/>
                                            <TextBlock Text="⚠ 账号密码以明文保存在本机设置文件中，仅作教室机的简易保护。公用电脑建议关闭「记住密码」与「开机自动登录」。"
                                                       FontSize="12" FontWeight="Normal" Foreground="#B26A00" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Expander>

                                    <StackPanel Margin="0,16,0,0">
                                        <Button x:Name="BtnSaveUser" Content="保存修改" Padding="18,9" FontSize="15" HorizontalAlignment="Left"
                                                Background="{DynamicResource PrimaryBrush}" Foreground="White"
                                                BorderBrush="{DynamicResource PrimaryBrush}" Click="BtnSaveUser_Click"/>
                                        <TextBlock x:Name="TxtUserMsg" FontSize="13" Margin="0,10,0,0"
                                                   TextWrapping="Wrap" Visibility="Collapsed"/>
                                        <!-- 账号卡片：上半是身份信息，下半是账号操作，中间一条 1px 分隔线分开。
                                             r78：原来两个按钮直接贴在身份文字下面、高度只有 30 出头、一个浅蓝一个系统灰，
                                             又挤又不统一；现在统一成描边次级按钮、等宽等高（136×40，一体机手指点得中），
                                             间距 12，与上方表单字段左对齐。 -->
                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="14,13" Margin="0,14,0,0">
                                            <StackPanel>
                                                <TextBlock x:Name="TxtRoleLine" Text="当前身份：—" FontSize="13"
                                                           FontWeight="Bold" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" LineHeight="19"/>
                                                <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,12,0,12"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="BtnManageUsers" Content="用户管理…" Style="{DynamicResource AppGhostButton}"
                                                            MinWidth="136" MinHeight="40" Padding="14,10" FontSize="13" Margin="0,0,12,0"
                                                            Click="BtnManageUsers_Click"/>
                                                    <Button x:Name="BtnSwitchUser" Content="切换账号…" Style="{DynamicResource AppGhostButton}"
                                                            MinWidth="136" MinHeight="40" Padding="14,10" FontSize="13"
                                                            Click="BtnSwitchUser_Click"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <!-- 关于：软件简介 + 版本 + 软件更新（Gitee）+ 运行信息（独立标签，不占用户中心） -->
                <TabItem x:Name="TabAbout" Header="关于">
                    <ScrollViewer Margin="14" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                        <StackPanel MaxWidth="900">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="ℹ 关于　班级公布栏" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource PrimarySoftBorderBrush}" BorderThickness="1" CornerRadius="12"
                                        Padding="12,3" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtAboutVer" Text="v—" FontSize="13" FontWeight="Bold" Foreground="#143A7A"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="面向教室多媒体屏的课表与班级信息公布工具　·　© 2026 逆流的鱼"
                                       FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>

                            <!-- 软件更新（程序自身的版本，与「数据包自动更新」无关） -->
                            <Border Background="#F4F8FF" BorderBrush="{DynamicResource PrimaryBorderBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="16,14" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="🔄 软件更新" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                                    <WrapPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button x:Name="BtnAboutCheck" Content="检查更新" Padding="16,8" FontSize="13.5" Cursor="Hand"
                                                Margin="0,0,8,0" Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderBrush="{DynamicResource PrimaryBrush}"
                                                ToolTip="联网读取 Gitee 上的最新发布版本"
                                                Click="BtnAboutCheck_Click"/>
                                        <Button x:Name="BtnAboutReleasePage" Content="打开发布页（Gitee）" Padding="16,8" FontSize="13.5" Cursor="Hand"
                                                Margin="0,0,8,0" Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource PrimarySoftBorderBrush}"
                                                ToolTip="在浏览器里打开 Gitee 发布页，可查看全部版本与安装包"
                                                Click="BtnAboutReleasePage_Click"/>
                                        <Button x:Name="BtnAboutDownload" Content="下载最新版" Padding="16,8" FontSize="13.5" Cursor="Hand"
                                                Background="#E8F7EE" BorderBrush="#9BD3AE" Visibility="Collapsed"
                                                ToolTip="直接下载最新版安装包"
                                                Click="BtnAboutDownload_Click"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="TxtAboutUpdStatus" FontSize="13" Foreground="#374151" TextWrapping="Wrap"
                                               Margin="0,10,0,0" Text="尚未检查。点「检查更新」获取 Gitee 上的最新版本。"/>
                                    <Border x:Name="PanelAboutNotes" Visibility="Collapsed" Background="White"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,10,0,0">
                                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                                            <TextBlock x:Name="TxtAboutReleaseNotes" FontSize="12.5" Foreground="{DynamicResource BodyBrush}" TextWrapping="Wrap" LineHeight="19"/>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- 运行信息（排查问题时截图 / 复制给维护人员） -->
                            <TextBlock Text="运行信息" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" Margin="0,18,0,8"/>
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="版本" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,9"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtAboutInfoVer" FontSize="12.5" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" Margin="0,3,0,9"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="当前身份" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,9"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtAboutInfoRole" FontSize="12.5" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" Margin="0,3,0,9"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="课表规模" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,9"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtAboutInfoClasses" FontSize="12.5" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" Margin="0,3,0,9"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="数据源" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,9"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtAboutInfoSource" FontSize="12.5" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" Margin="0,3,0,9"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="数据格式" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,9"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtAboutInfoSchema" FontSize="12.5" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" Margin="0,3,0,9"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="数据目录" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,9"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TxtAboutInfoDir" FontSize="12.5" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" Margin="0,3,0,9"/>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="上次检查更新" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,3"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" x:Name="TxtAboutInfoLastCheck" FontSize="12.5" Foreground="{DynamicResource InkBrush}" TextWrapping="Wrap" Margin="0,3,0,3"/>
                                </Grid>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="BtnAboutCopy" Content="复制版本信息" Padding="16,8" FontSize="13.5" Cursor="Hand"
                                        Margin="0,0,8,0" Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource PrimarySoftBorderBrush}"
                                        ToolTip="把版本、身份、数据目录等一起复制到剪贴板，反馈问题时直接粘贴"
                                        Click="BtnAboutCopy_Click"/>
                                <Button x:Name="BtnAboutOpenDir" Content="打开数据目录" Padding="16,8" FontSize="13.5" Cursor="Hand"
                                        Background="{DynamicResource PrimarySoftBrush}" BorderBrush="{DynamicResource PrimarySoftBorderBrush}"
                                        ToolTip="备份 / 排查时在这个文件夹里找 settings、schedule、users.json"
                                        Click="BtnAboutOpenDir_Click"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 今日首页：追加在末尾 = index 9，原有 0~8 索引一个都不动 -->
                <TabItem Header="今日" x:Name="TabToday">
                    <ScrollViewer Margin="20" PanningMode="VerticalOnly">
                        <StackPanel>
                            <TextBlock Text="今日" Style="{StaticResource TextPageTitle}"/>
                            <TextBlock x:Name="TxtTodaySubtitle" Text="" Style="{StaticResource TextHint}" Margin="0,4,0,20"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource AppCard}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="课表与展示" Style="{StaticResource TextSection}" Margin="0,0,0,10"/>
                                        <TextBlock Text="课表、便签和通知条按当前显示日期刷新；展示模式锁定后仍照常显示。"
                                                   Style="{StaticResource TextBody}"/>
                                        <Button Content="打开周课程表" Tag="week" Style="{StaticResource AppGhostButton}"
                                                HorizontalAlignment="Left" Margin="0,14,0,0" Click="NavTodayAction_Click"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource AppCard}" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="消息与变更" Style="{StaticResource TextSection}" Margin="0,0,0,10"/>
                                        <TextBlock Text="教师机发来的变更单在收件箱里逐条确认；勾选「直接增加」的通知会由教室机自动收下。"
                                                   Style="{StaticResource TextBody}"/>
                                        <Button Content="打开消息台账" Tag="ledger" Style="{StaticResource AppGhostButton}"
                                                HorizontalAlignment="Left" Margin="0,14,0,0" Click="NavTodayAction_Click"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <TextBlock Text="快捷动作" Style="{StaticResource TextSection}" Margin="0,24,0,10"/>
                            <WrapPanel>
                                <Button Content="发布内容" Tag="publish" Style="{StaticResource AppGhostButton}" Margin="0,0,8,8" Click="NavTodayAction_Click"/>
                                <Button Content="布局与显示" Tag="layout" Style="{StaticResource AppGhostButton}" Margin="0,0,8,8" Click="NavTodayAction_Click"/>
                                <Button Content="桌面背景排版" Tag="backdrop" Style="{StaticResource AppGhostButton}" Margin="0,0,8,8" Click="NavTodayAction_Click"/>
                                <Button Content="立即检查消息" Tag="pull" Style="{StaticResource AppGhostButton}" Margin="0,0,8,8" Click="NavTodayAction_Click"/>
                            </WrapPanel>
                            <TextBlock Text="更多设置与原有页面都在左侧导航里，内容与操作没有改动。"
                                       Style="{StaticResource TextHint}" Margin="0,16,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
                </Grid>
            </Grid>
        </DockPanel>

        <!-- 防误触锁定覆盖层 -->
        <Grid x:Name="LockOverlay" Visibility="Collapsed" Background="Transparent">
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24"
                    Background="#33000000" CornerRadius="8" Padding="14,9">
                <TextBlock Text="展示模式已锁定　·　按 Ctrl+L 解锁" Foreground="White" FontSize="16"/>
            </Border>
        </Grid>
    </Grid>
</Window>
