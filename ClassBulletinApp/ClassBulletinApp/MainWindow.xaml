<Window x:Class="ClassBulletinApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClassBulletinApp"
        Title="班级公布栏 · 控制面板" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" KeyDown="Window_KeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- 顶层容器：DockPanel 主体 + 锁定覆盖层 -->
        <DockPanel>
            <!-- 顶部工具栏（精简：班级 / 独立周窗口） -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource PrimaryBrush}" Padding="14,10">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="📋 班级公布栏" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="LblTeacher" Text="教师：" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="14"/>
                        <ComboBox x:Name="CbTeacher" Width="172" FontSize="14" Margin="0,0,14,0"
                                  IsEditable="True" IsTextSearchEnabled="False"
                                  TextBoxBase.TextChanged="CbTeacher_TextChanged"
                                  SelectionChanged="CbTeacher_SelectionChanged"
                                  LostFocus="CbTeacher_LostFocus"
                                  ToolTip="可直接输入教师姓名查询筛选；选择后悬浮课表切换为该教师的个人课表"/>
                        <TextBlock Text="班级：" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="14"/>
                        <ComboBox x:Name="CbClass" Width="150" FontSize="14" SelectionChanged="CbClass_SelectionChanged" Margin="0,0,8,0"
                                  ToolTip="选择班级后悬浮课表切换为该班的课表"/>
                        <TextBlock x:Name="TxtCurrentMode" Foreground="#FFE9A8" VerticalAlignment="Center" FontSize="13" Margin="6,0,0,0"/>
                        <TextBlock Text="开学周" Foreground="White" VerticalAlignment="Center" Margin="20,0,6,0" FontSize="14"/>
                        <DatePicker x:Name="DpSemester" Width="132" FontSize="13" VerticalAlignment="Center" SelectedDateFormat="Short"
                                    SelectedDateChanged="DpSemester_SelectedDateChanged"
                                    ToolTip="开学第一周星期一：用于计算「第几周」教学周，与学校开学时间对齐。"/>
                        <CheckBox x:Name="ChkAutoStartTitle" Content="开机自启" Foreground="White" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="14"
                                  Checked="ChkAutoStartTitle_Changed" Unchecked="ChkAutoStartTitle_Changed"
                                  ToolTip="把本程序写入当前用户开机启动项"/>
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!-- 底部状态栏（常驻） -->
            <Border DockPanel.Dock="Bottom" Background="#F5F7FA" BorderBrush="#E3E8EF" BorderThickness="0,1,0,0" Padding="14,8">
                <TextBlock x:Name="TxtStatus" FontSize="14" Foreground="#C0392B" TextWrapping="Wrap"/>
            </Border>

            <!-- 主体：标签页归类 -->
            <TabControl x:Name="MainTabs" Margin="10">
                <!-- 课表：直接周视图（右键安排调代课；单击已安排格二次确认清除） -->
                <TabItem Header="周课程表">
                    <local:WeekView x:Name="WeekViewManage" Mode="Manage"/>
                </TabItem>

                <!-- 数据管理 -->
                <TabItem Header="数据管理">
                    <ScrollViewer Margin="14">
                        <StackPanel MaxWidth="640">
                            <TextBlock Text="课表数据" FontSize="20" FontWeight="Bold" Foreground="#1F2A37" Margin="0,0,0,12"/>
                            <Button x:Name="BtnImport" Content="导入课表（全校总课程表）" Margin="0,0,0,10" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Click="BtnImport_Click"/>
                            <Button x:Name="BtnImportTemp" Content="导入临时课表（含 调 / 代 标记）" Margin="0,0,0,10" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Background="#E8F6EE" BorderBrush="#7FC99A" Click="BtnImportTemp_Click"/>
                            <Button x:Name="BtnImportSingle" Content="导入单个班级课表（单班适用）" Margin="0,0,0,10" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}" Click="BtnImportSingle_Click"/>
                            <Button x:Name="BtnImportTeacher" Content="导入单个教师课表（教师个人适用）" Margin="0,0,0,10" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}" Click="BtnImportTeacher_Click"/>
                            <Button x:Name="BtnClearOverrides" Content="清除全部临时调课 / 代课" Margin="0,0,0,18" Padding="14,10" FontSize="15" HorizontalAlignment="Left" Background="#FDE8E8" BorderBrush="#E0A0A0" Click="BtnClearOverrides_Click"/>
                            <TextBlock Text="说明：先「导入课表」得到基础课表；再用「导入临时课表」自动识别带（调）/（代）标记的课并生成调代覆盖（仅替换导入来源，保留手动修改）。" FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBlock Text="若只有一个班级使用本软件，可直接「导入单个班级课表」（如 八年级X班-班级课程表.xlsx），将仅包含该班课表。" FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBlock Text="导入全校总课表 / 单班课表时，会自动按任课教师反向整理出「教师个人课表」（教师人数多时可在顶栏输入姓名查询），选中教师即显示其个人课表，每节课显示所教班级。教师个人也可单独导入自己的课表文件。" FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <TextBlock Text="调课 / 代课记录可在「周课程表」标签的周视图中右键安排；需要整体清除时使用「清除全部临时调课 / 代课」按钮。" FontSize="13" Foreground="#6B7280" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 显示设置 -->
                <TabItem Header="显示设置">
                    <ScrollViewer Margin="14">
                        <StackPanel MaxWidth="860">
                            <TextBlock Text="悬浮窗与展示" FontSize="20" FontWeight="Bold" Foreground="#1F2A37" Margin="0,0,0,12"/>
                            <WrapPanel Orientation="Horizontal">
                                <Button x:Name="BtnToggleSch" Content="课表悬浮：关" Style="{StaticResource TabBtn}" Click="BtnToggleSch_Click" Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}"/>
                                <Button x:Name="BtnToggleNot" Content="通知悬浮：关" Style="{StaticResource TabBtn}" Click="BtnToggleNot_Click" Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}"/>
                                <Button x:Name="BtnLayout" Content="布局设置" Style="{StaticResource TabBtn}" Click="BtnLayout_Click"/>
                                <Button x:Name="BtnFull" Content="全屏" Style="{StaticResource TabBtn}" Click="BtnFull_Click"/>
                                <Button x:Name="BtnLock" Content="锁定" Style="{StaticResource TabBtn}" Click="BtnLock_Click"/>
                                <Button x:Name="BtnHideTray" Content="隐藏到托盘" Style="{StaticResource TabBtn}" Click="BtnHideTray_Click"/>
                                <Button x:Name="BtnSettings" Content="启动选项（全屏 / 锁定）" Style="{StaticResource TabBtn}" Click="BtnSettings_Click"/>
                            </WrapPanel>
                            <CheckBox x:Name="ChkMaxHide" Content="桌面有窗口最大化时，自动隐藏课表与通知（避免遮挡正在使用的程序）"
                                      FontSize="14" Foreground="#1F2A37" Margin="8,16,0,0" Click="ChkMaxHide_Click"/>
                            <TextBlock Text="布局设置可调整悬浮窗位置、大小、透明度、置顶、鼠标穿透或自动靠边隐藏；悬浮窗右上角「自动隐藏 / 置顶显示」按钮可快速切换。「置顶显示」为半透明常驻，隐藏按钮、标题双击、拖动调课均可正常操作；如需纯展示可在布局设置勾选「鼠标穿透」。"
                                       FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="8,8,0,0"/>
                            <TextBlock Text="自动隐藏默认把窗口完全移出屏幕（不在屏幕上留任何边缘），只把鼠标移到 / 手指触到屏幕对应边沿时才平滑滑出；需要保留一条可点细边时，可在布局设置里把「露出像素」调成 1~48。"
                                       FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="8,4,0,0"/>
                            <TextBlock Text="顶栏「教师 / 班级」下拉、或双击悬浮课表标题的姓名位置，都可在班级课表与教师个人课表之间自由切换。"
                                       FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="8,6,0,0"/>

                            <!-- 主题配色 -->
                            <TextBlock Text="界面主题" FontSize="20" FontWeight="Bold" Foreground="#1F2A37" Margin="0,20,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="配色方案" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="CbTheme" Width="200" FontSize="14" SelectionChanged="CbTheme_SelectionChanged"/>
                                <Button x:Name="BtnThemeReset" Content="恢复默认" Padding="12,6" FontSize="13" Margin="12,0,0,0" Click="BtnThemeReset_Click" Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}"/>
                            </StackPanel>
                            <TextBlock Text="桌面背景（当天课表 + 作业公示）的位置与显示设置，已移到「布局设置」对话框的「桌面背景」标签页；点击上方「布局设置」即可调整。"
                                       FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,14,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 提醒设置（独立标签页） -->
                <TabItem Header="提醒设置">
                    <ScrollViewer Margin="14">
                        <StackPanel MaxWidth="720">
                            <TextBlock Text="⏰ 上下课提醒" FontSize="20" FontWeight="Bold" Foreground="#1F2A37" Margin="0,0,0,4"/>
                            <TextBlock Text="依据当前显示的班级 / 教师课表（含临时课表调 / 代安排）到点提醒；调休日按「显示日」的课表提醒。同一提醒每天只弹一次。"
                                       FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,14"/>

                            <CheckBox x:Name="ChkRemindEnabled" Content="启用上下课提醒（课前 / 上课 / 下课 / 放学自动弹窗提示）"
                                      FontSize="15" FontWeight="Bold" Foreground="#1F2A37" Margin="0,0,0,14" Click="RemindSetting_Changed"/>

                            <TextBlock Text="提醒时间" FontSize="16" FontWeight="Bold" Foreground="#1F2A37" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="12,0,0,6">
                                <TextBlock Text="上课前提前" FontSize="14" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtRemindBeforeClass" Width="48" FontSize="14" Margin="6,0" TextAlignment="Center"
                                         TextChanged="RemindSetting_TextChanged"
                                         ToolTip="提前几分钟提醒即将上课；0 = 不做课前提醒"/>
                                <TextBlock Text="分钟提醒" FontSize="14" VerticalAlignment="Center" Margin="0,0,26,0"/>
                                <TextBlock Text="下课前提前" FontSize="14" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtRemindBeforeEnd" Width="48" FontSize="14" Margin="6,0" TextAlignment="Center"
                                         TextChanged="RemindSetting_TextChanged"
                                         ToolTip="提前几分钟提醒即将下课；0 = 下课时提示课间休息"/>
                                <TextBlock Text="分钟提醒（0 = 下课时提示）" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="12,4,0,6">
                                <TextBlock Text="弹窗显示" FontSize="14" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtRemindSeconds" Width="48" FontSize="14" Margin="6,0" TextAlignment="Center"
                                         TextChanged="RemindSetting_TextChanged"
                                         ToolTip="提醒窗口停留几秒后自动消失"/>
                                <TextBlock Text="秒" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="12,0,0,6">
                                <CheckBox x:Name="ChkRemindAfterSchool" Content="放学提醒（当天最后一节结束后）" FontSize="14" Margin="0,0,26,0" Click="RemindSetting_Changed"/>
                                <CheckBox x:Name="ChkRemindSound" Content="提醒时播放提示音" FontSize="14" Click="RemindSetting_Changed"/>
                            </StackPanel>

                            <Border Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,18,0,0">
                                <StackPanel>
                                    <CheckBox x:Name="ChkRemindVoice" Content="🔊 语音播报（用系统语音朗读提醒内容，如「第 3 节 语文 即将上课」）"
                                              FontSize="15" FontWeight="Bold" Foreground="#1F2A37" Click="RemindSetting_Changed"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <TextBlock Text="语音" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="CbRemindVoice" Width="300" FontSize="14" SelectionChanged="RemindVoice_Selected"/>
                                        <Button x:Name="BtnVoiceTest" Content="试听" FontSize="13" Padding="12,4" Margin="10,0,0,0" Click="BtnVoiceTest_Click"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <TextBlock Text="语速" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Slider x:Name="SlVoiceRate" Minimum="-10" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Width="230" ValueChanged="RemindVoice_ValueChanged" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtVoiceRate" FontSize="13" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="音量" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Slider x:Name="SlVoiceVolume" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                                Width="230" ValueChanged="RemindVoice_ValueChanged" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TxtVoiceVolume" FontSize="13" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="语音来自 Windows 自带语音合成（SAPI），选「系统默认」时自动优先使用中文语音。若列表为空或没有中文语音，可到「设置 → 时间和语言 → 语音」安装中文语音包；同一提醒只会播报一次。"
                                               FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 通知公告 -->
                <TabItem Header="通知公告">
                    <ScrollViewer Margin="14">
                        <StackPanel MaxWidth="640">
                            <TextBlock Text="📢 通知 / 公告管理" FontSize="20" FontWeight="Bold" Foreground="#1F2A37" Margin="0,0,0,12"/>
                            <StackPanel Margin="0,0,0,12">
                                <TextBox x:Name="TxtNewTitle" FontSize="15" Padding="10" Margin="0,0,0,8" Background="White" BorderBrush="#D1D5DB" ToolTip="标题（选填）"/>
                                <TextBox x:Name="TxtNewContent" FontSize="14" Padding="10" Height="64" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,8" Background="White" BorderBrush="#D1D5DB" ToolTip="内容"/>
                                <Button x:Name="BtnAddNotice" Content="添加通知" Padding="12,7" FontSize="15" HorizontalAlignment="Left" Click="BtnAddNotice_Click"/>
                            </StackPanel>
                            <ItemsControl x:Name="NotificationsPanel">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="#E3E8EF" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="#1F2A37"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                                        <Button Content="{Binding PinButtonText}" FontSize="12" Padding="10,3" Margin="0,0,6,0"
                                                                Click="BtnPin_Click" Tag="{Binding Id}"/>
                                                        <Button Content="删除" FontSize="12" Padding="10,3"
                                                                Click="BtnDeleteNotice_Click" Tag="{Binding Id}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Content}" FontSize="14" Foreground="#4B5563" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                                <TextBlock Text="{Binding CreatedText}" FontSize="11" Foreground="#B0B6BF" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <!-- 作业公示 -->
                <TabItem Header="作业公示">
                    <ScrollViewer Margin="14">
                        <StackPanel MaxWidth="780">
                            <TextBlock Text="📚 各科作业公示栏" FontSize="20" FontWeight="Bold" Foreground="#1F2A37" Margin="0,0,0,4"/>
                            <TextBlock Text="编辑各科作业后点「保存并应用到桌面背景」：壁纸会显示作业公示（可与「当天课表」同屏），始终显示于桌面背景、不遮挡也不影响电脑操作；「清除」可恢复原壁纸。其显示位置 / 宽度在「布局设置 → 桌面背景」调整（点下方按钮可直接进入）。" FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="总标题" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="TxtHwTitle" FontSize="14" Padding="8" Width="320" Background="White" BorderBrush="#D1D5DB"/>
                                <Button x:Name="BtnAddHw" Content="添加科目" Padding="12,6" FontSize="14" Margin="12,0,0,0" Click="BtnAddHw_Click"/>
                            </StackPanel>
                            <ItemsControl x:Name="HwItems" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding Subject, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8" Margin="0,0,8,0" Background="White" BorderBrush="#D1D5DB" ToolTip="科目"/>
                                            <TextBox Grid.Column="1" Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Padding="8" Margin="0,0,8,0" Background="White" BorderBrush="#D1D5DB" AcceptsReturn="True" Height="42" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="作业内容"/>
                                            <Button Grid.Column="2" Content="删除" Padding="10,4" FontSize="12" Click="BtnDelHw_Click" Tag="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="BtnWpSettings" Content="调整桌面背景位置" Padding="14,8" FontSize="14" Margin="0,8,0,0" HorizontalAlignment="Left"
                                    Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}" Click="BtnWpSettings_Click"
                                    ToolTip="打开「布局设置 → 桌面背景」调整作业公示与当天课表的位置、宽度"/>
                            <TextBlock Text="作业公示与当天课表的位置 / 宽度、以及是否一起显示，统一在「布局设置 → 桌面背景」调整（两块内容各自独立定位）。这里只负责编辑作业内容。"
                                   FontSize="13" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,8,0,12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button x:Name="BtnHwPreview" Content="保存并预览" Padding="14,8" FontSize="14" Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}" Click="BtnHwPreview_Click"/>
                                <Button x:Name="BtnSaveHw" Content="保存并应用到桌面背景" Padding="14,8" FontSize="15" Margin="12,0,0,0" Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderBrush="{DynamicResource PrimaryBrush}" Click="BtnSaveHw_Click"/>
                                <Button x:Name="BtnClearHw" Content="清除（恢复原壁纸）" Padding="14,8" FontSize="15" Margin="12,0,0,0" Background="#FDE8E8" BorderBrush="#E0A0A0" Click="BtnClearHw_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </DockPanel>

        <!-- 防误触锁定覆盖层 -->
        <Grid x:Name="LockOverlay" Visibility="Collapsed" Background="Transparent">
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24"
                    Background="#33000000" CornerRadius="8" Padding="14,9">
                <TextBlock Text="展示模式已锁定　·　按 Ctrl+L 解锁" Foreground="White" FontSize="16"/>
            </Border>
        </Grid>
    </Grid>
</Window>
