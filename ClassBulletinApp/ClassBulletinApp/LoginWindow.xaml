<Window x:Class="ClassBulletinApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="班级公布栏 · 登录" Height="380" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F5F7FA">
    <Border Background="White" CornerRadius="14" BorderBrush="#D8DEE9" BorderThickness="1" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" Opacity="0.25" ShadowDepth="4" Direction="300"/>
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="📋 班级公布栏" FontSize="24" FontWeight="Bold" Foreground="#1F2A37"/>
                <TextBlock Text="请登录后使用；或以游客身份体验（不保存任何数据）" FontSize="13" Foreground="#6B7280" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="用户名" FontSize="14" Foreground="#4B5563" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtUser" FontSize="16" Padding="10" Background="White" BorderBrush="#D1D5DB" TextChanged="Txt_TextChanged"/>
                <TextBlock Text="密码" FontSize="14" Foreground="#4B5563" Margin="0,14,0,4"/>
                <PasswordBox x:Name="TxtPwd" FontSize="16" Padding="10" Background="White" BorderBrush="#D1D5DB"
                             PasswordChanged="Txt_TextChanged" KeyDown="TxtPwd_KeyDown"/>
                <TextBlock x:Name="TxtError" Text="" FontSize="13" Foreground="#C0392B" Margin="0,10,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
                <Button x:Name="BtnForgot" Content="忘记密码？" HorizontalAlignment="Right" Margin="0,6,0,0"
                        Background="Transparent" BorderThickness="0" Foreground="#2D6CDF" FontSize="13"
                        Cursor="Hand" Click="BtnForgot_Click"
                        ToolTip="通过电子邮箱 / 手机号码 / 密保问题找回或重置密码"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnGuest" Content="游客体验" Padding="14,8" FontSize="14" Margin="0,0,12,0"
                        Background="White" BorderBrush="#D1D5DB" Click="BtnGuest_Click"
                        ToolTip="不保存任何数据，退出后自动清空"/>
                <Button x:Name="BtnLogin" Content="登录" Padding="22,8" FontSize="15" IsDefault="True"
                        Background="#2D6CDF" Foreground="White" BorderBrush="#2D6CDF" Click="BtnLogin_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
