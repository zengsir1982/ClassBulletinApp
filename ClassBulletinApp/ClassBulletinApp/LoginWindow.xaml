<Window x:Class="ClassBulletinApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:ClassBulletinApp.Controls"
        Title="班级公布栏 · 登录" Width="430" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{DynamicResource BarSurfaceBrush}">
    <Border Background="White" CornerRadius="14" BorderBrush="#D8DEE9" BorderThickness="1" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" Opacity="0.25" ShadowDepth="4" Direction="300"/>
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="📋 班级公布栏" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource InkBrush}"/>
                <TextBlock x:Name="TxtSubtitle" Text="账号密码已为你记住，日常开机无需再登录；也可以改用游客身份体验（不保存任何数据）"
                           FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,18,0,0">
                <TextBlock Text="用户名" FontSize="14" Foreground="{DynamicResource BodyBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtUser" FontSize="16" Padding="10" Background="White" BorderBrush="{DynamicResource InputBorderBrush}" TextChanged="Txt_TextChanged"/>
                <TextBlock Text="密码" FontSize="14" Foreground="{DynamicResource BodyBrush}" Margin="0,14,0,4"/>
                <PasswordBox x:Name="TxtPwd" FontSize="16" Padding="10" Background="White" BorderBrush="{DynamicResource InputBorderBrush}"
                             PasswordChar="*" PasswordChanged="Txt_TextChanged" KeyDown="TxtPwd_KeyDown"/>
                <CheckBox x:Name="ChkRememberUser" Content="记住账号（下次自动填入用户名）" FontSize="14"
                          Foreground="{DynamicResource InkBrush}" Margin="0,12,0,0"
                          Checked="LoginPref_Changed" Unchecked="LoginPref_Changed"/>
                <CheckBox x:Name="ChkRememberPwd" Content="记住密码（下次自动填入，明文保存在本机）" FontSize="14"
                          Foreground="{DynamicResource InkBrush}" Margin="0,8,0,0"
                          Checked="LoginPref_Changed" Unchecked="LoginPref_Changed"/>
                <CheckBox x:Name="ChkAutoLogin" Content="开机自动登录（跳过登录界面）" FontSize="14"
                          Foreground="{DynamicResource InkBrush}" Margin="0,8,0,0"
                          Checked="LoginPref_Changed" Unchecked="LoginPref_Changed"
                          ToolTip="需要同时「记住密码」；管理员账号永不自动登录（防止教室机开机即管理员）。"/>
                <TextBlock Text="⚠ 账号密码以明文保存在本机设置文件中，仅作教室机的简易保护。公用电脑建议关闭「记住密码」与「开机自动登录」。"
                           FontSize="12" Foreground="#B26A00" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock x:Name="TxtError" Text="" FontSize="13" Foreground="{DynamicResource DangerBrush}" Margin="0,10,0,0"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
                <Button x:Name="BtnForgot" Content="忘记密码？" HorizontalAlignment="Right" Margin="0,6,0,0"
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryBrush}" FontSize="13"
                        Cursor="Hand" Click="BtnForgot_Click"
                        ToolTip="通过电子邮箱 / 手机号码 / 密保问题找回或重置密码"/>
            </StackPanel>

            <StackPanel Grid.Row="2">
                <ctl:HelpBubble PopupTitle="记住密码" Text="只在勾选「记住密码」时才保存密码；关闭后本机会清除已保存的密码。" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnGuest" Content="游客体验" Padding="14,8" FontSize="14" Margin="0,0,12,0"
                            Background="White" BorderBrush="{DynamicResource InputBorderBrush}" Click="BtnGuest_Click"
                            ToolTip="不保存任何数据，退出后自动清空"/>
                    <Button x:Name="BtnLogin" Content="登录" Padding="22,8" FontSize="15" IsDefault="True"
                            Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderBrush="{DynamicResource PrimaryBrush}" Click="BtnLogin_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
