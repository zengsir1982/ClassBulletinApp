<Window x:Class="ClassBulletinApp.CustomNoteEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义便签 · 编辑" Height="560" Width="640"
        MinWidth="520" MinHeight="460" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip" Background="#F2F5FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：标题 + 主题风格 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E3E8EF" BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="便签标题" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtTitle" Width="220" FontSize="14" Padding="6" Background="White" BorderBrush="#D1D5DB"/>
                <TextBlock Text="主题风格" FontSize="14" VerticalAlignment="Center" Margin="18,0,8,0"/>
                <ComboBox x:Name="CbTheme" Width="190" FontSize="14">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <Rectangle Width="18" Height="18" RadiusX="4" RadiusY="4"
                                           Fill="{Binding Background}" Stroke="#9AA3AF" StrokeThickness="1" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox x:Name="ChkLocked" Content="锁定便签" Margin="18,0,0,0" FontSize="14" VerticalAlignment="Center"
                          ToolTip="锁定后该便签不能移动 / 缩放 / 编辑，防止误操作"/>
            </StackPanel>
        </Border>

        <!-- 中部：正文 -->
        <Grid Grid.Row="1" Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="便签内容（支持多行，可写教师寄语、温馨提示等自由内容）"
                       FontSize="14" Foreground="#4B5563" Margin="0,0,0,6"/>
            <TextBox Grid.Row="1" x:Name="TxtContent" FontSize="15" Padding="10" TextWrapping="Wrap"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="White" BorderBrush="#D1D5DB"
                     TextAlignment="Left"/>
        </Grid>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E3E8EF" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel LastChildFill="False">
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#6B7280"
                           Text="提示：确定后立即保存。在屏幕上双击便签也可打开本窗口。"/>
                <Button x:Name="BtnOk" DockPanel.Dock="Right" Content="确定" Padding="20,7" FontSize="14" Margin="10,0,0,0"
                        Background="#2D6CDF" Foreground="White" BorderBrush="#2D6CDF" IsDefault="True" Click="BtnOk_Click"/>
                <Button x:Name="BtnCancel" DockPanel.Dock="Right" Content="取消" Padding="20,7" FontSize="14"
                        Background="White" BorderBrush="#D1D5DB" IsCancel="True" Click="BtnCancel_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
