<Window x:Class="ClassBulletinApp.CustomNoteEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:ClassBulletinApp.Controls"
        Title="自定义便签 · 新增 / 编辑" Height="680" Width="720"
        MinWidth="520" MinHeight="500" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip" Background="{DynamicResource BarSurfaceBrush}">
    <!-- r71 统一排版：预览 → 便签选择 / 主题 / 锁定（同一行）→ 格式条 → 标题 → 内容 → 底栏 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ① 预览：标题与正文都跟着输入框实时变，底色跟着主题下拉变 -->
        <Border Grid.Row="0" Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,12">
            <Border x:Name="PreviewCard" CornerRadius="10" Padding="12" BorderThickness="1"
                    Background="{Binding SelectedItem.Background, ElementName=CbTheme}"
                    BorderBrush="{DynamicResource LineBrush}">
                <StackPanel>
                    <TextBlock Text="便签预览" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,2"/>
                    <TextBlock x:Name="PreviewTitle" Text="{Binding Text, ElementName=TxtTitle}"
                               FontSize="16" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PreviewBody" Text="{Binding Text, ElementName=TxtContent}"
                               FontSize="13" Foreground="{DynamicResource BodyBrush}" Margin="0,6,0,0"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="66"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- ② 便签选择 / 新建 / 删除 + 主题风格 + 锁定（按用户要求放在同一行，窄窗口由 WrapPanel 自动换行） -->
        <Border Grid.Row="1" Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="便签" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="CbNote" Width="180" FontSize="14" VerticalAlignment="Center"
                          SelectionChanged="CbNote_SelectionChanged"
                          ToolTip="选择要编辑的便签；点「＋ 新建便签」可再加一张"/>
                <Button x:Name="BtnNewNote" Content="＋ 新建便签" Padding="12,6" FontSize="13" Margin="8,0,0,0"
                        Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderBrush="{DynamicResource PrimaryBrush}"
                        Click="BtnNewNote_Click" ToolTip="再新建一张自定义便签"/>
                <Button x:Name="BtnDeleteNote" Content="删除本便签" Padding="12,6" FontSize="13"
                        Margin="8,0,0,0" Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" Foreground="{DynamicResource DangerBrush}"
                        Click="BtnDeleteNote_Click" ToolTip="删除当前选中的便签（不可撤销）"/>
                <TextBlock Text="主题风格" FontSize="14" VerticalAlignment="Center" Margin="18,0,8,0"/>
                <ComboBox x:Name="CbTheme" Width="160" FontSize="14" SelectionChanged="CbTheme_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <Rectangle Width="18" Height="18" RadiusX="4" RadiusY="4"
                                           Fill="{Binding Background}" Stroke="{DynamicResource HintBrush}" StrokeThickness="1" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox x:Name="ChkLocked" Content="锁定便签" Margin="14,0,0,0" FontSize="14" VerticalAlignment="Center"
                          ToolTip="锁定后该便签不能移动 / 缩放 / 编辑，防止误操作"/>
            </WrapPanel>
        </Border>

        <!-- ③ 文字格式：全窗只一条工具条，点哪个输入框就改哪个的格式 -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel LastChildFill="False">
                <TextBlock Text="文字格式" FontSize="13" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ctl:TextStylePicker x:Name="PickStyle" StyleChanged="Style_Changed"/>
            </DockPanel>
        </Border>

        <!-- ④ 便签标题 -->
        <Border Grid.Row="3" Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="便签标题" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtTitle" Width="420" FontSize="14" Padding="6" Background="White" BorderBrush="{DynamicResource InputBorderBrush}"/>
            </StackPanel>
        </Border>

        <!-- ⑤ 便签内容 -->
        <Grid Grid.Row="4" Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="便签内容（支持多行，可写教师寄语、温馨提示等自由内容）"
                       FontSize="14" Foreground="{DynamicResource BodyBrush}" Margin="0,0,0,6"/>
            <TextBox Grid.Row="1" x:Name="TxtContent" FontSize="15" Padding="10" TextWrapping="Wrap"
                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="White" BorderBrush="{DynamicResource InputBorderBrush}"
                     TextAlignment="Left"/>
        </Grid>

        <!-- 底栏 -->
        <Border Grid.Row="5" Background="White" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel LastChildFill="False">
                <ctl:HelpBubble PopupTitle="保存说明"
                                Text="确定后立即保存。在屏幕上双击便签也可打开本窗口。"/>
                <Button x:Name="BtnOk" DockPanel.Dock="Right" Content="确定" Padding="20,7" FontSize="14" Margin="10,0,0,0"
                        Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderBrush="{DynamicResource PrimaryBrush}" IsDefault="True" Click="BtnOk_Click"/>
                <Button x:Name="BtnCancel" DockPanel.Dock="Right" Content="取消" Padding="20,7" FontSize="14"
                        Background="White" BorderBrush="{DynamicResource InputBorderBrush}" IsCancel="True" Click="BtnCancel_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
