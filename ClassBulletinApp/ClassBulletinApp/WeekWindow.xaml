<Window x:Class="ClassBulletinApp.WeekWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="周课程表 · 拖拽调课" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- 顶部工具栏 -->
        <Border DockPanel.Dock="Top" Background="#2D6CDF" Padding="12">
            <DockPanel LastChildFill="True">
                <TextBlock Text="📅 周课程表（拖拽调课）" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="调课类型：" Foreground="White" VerticalAlignment="Center" FontSize="13" Margin="6,0,2,0"/>
                    <ComboBox x:Name="CbEditType" Width="86" FontSize="13" Margin="2,0,6,0" SelectedIndex="0" SelectionChanged="CbEditType_SelectionChanged">
                        <ComboBoxItem Content="调课"/>
                        <ComboBoxItem Content="代课"/>
                    </ComboBox>
                    <Button x:Name="BtnPrevWeek" Content="上一周" Margin="4" Padding="10,5" FontSize="13" Click="BtnPrevWeek_Click"/>
                    <Button x:Name="BtnThisWeek" Content="本周" Margin="4" Padding="10,5" FontSize="13" Click="BtnThisWeek_Click"/>
                    <Button x:Name="BtnNextWeek" Content="下一周" Margin="4" Padding="10,5" FontSize="13" Click="BtnNextWeek_Click"/>
                    <Button x:Name="BtnClearAll" Content="清除全部调课" Margin="4" Padding="10,5" FontSize="13" Click="BtnClearAll_Click" Background="#FDE8E8" BorderBrush="#E0A0A0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 周范围 -->
        <Border DockPanel.Dock="Top" Background="#EEF3FB" Padding="8">
            <TextBlock x:Name="TxtWeekRange" FontSize="14" Foreground="#1F2A37"/>
        </Border>

        <!-- 提示 -->
        <TextBlock DockPanel.Dock="Top" Text="操作：先选择上方「调课 / 代课」类型，再拖动某节课到另一格（目标有课则两节互换，目标为空则移动并清空原格）；右键某格可清除该格调课。橙色=调课，蓝色=代课。"
                   FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="10,6"/>

        <!-- 周表格（动态生成） -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid x:Name="WeekGrid" Margin="10" MinWidth="900"/>
        </ScrollViewer>

        <!-- 状态栏 -->
        <Border DockPanel.Dock="Bottom" Background="#F5F7FA" Padding="8">
            <TextBlock x:Name="TxtStatus" FontSize="13" Foreground="#C0392B" TextWrapping="Wrap"/>
        </Border>
    </DockPanel>
</Window>
